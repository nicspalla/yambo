ambo","text":"subroutine d_matrix(nsym, sr, dy1, dy2, dy3) Uses matrix_inversion uspp kinds Arguments Type Intent Optional Attributes Name integer :: nsym real(kind=DP) :: sr (3,3,nsym) real(kind=DP) :: dy1 (3,3,48) real(kind=DP) :: dy2 (5,5,48) real(kind=DP) :: dy3 (7,7,48)","tags":"","url":"proc/d_matrix.html"},{"title":"excitons_kinematics – Yambo","text":"subroutine excitons_kinematics(Xk, eh, i_s) Uses BS_solvers R_lattice electrons YPPm Arguments Type Intent Optional Attributes Name type( bz_samp ) :: Xk type( EXCITON_kin ) :: eh integer :: i_s","tags":"","url":"proc/excitons_kinematics.html"},{"title":"RT_carriers_number – Yambo","text":"subroutine RT_carriers_number(en, k, Ncarr) Uses RT_control R_lattice pars RT_occupations electrons real_time Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: en type( bz_samp ), intent(in) :: k real(kind=SP), intent(out) :: Ncarr (3)","tags":"","url":"proc/rt_carriers_number.html"},{"title":"RT_damp_it – Yambo","text":"subroutine RT_damp_it(damp_type, damp_factor, ft, lda) Uses fields YPP_real_time pars Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: damp_type real(kind=SP), intent(in) :: damp_factor complex(kind=DP), intent(inout) :: ft (RT_conf%T_n_steps,lda) integer, intent(in) :: lda","tags":"","url":"proc/rt_damp_it.html"},{"title":"excitons_interpolate_setup – Yambo","text":"subroutine excitons_interpolate_setup(k, Xk, en, Xen, q, ID_INTERP_EXC, report) Uses R_lattice interpolate stderr pars com UNITS YPPm electrons Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k type( bz_samp ) :: Xk type( levels ) :: en type( levels ) :: Xen type( bz_samp ) :: q integer, intent(inout) :: ID_INTERP_EXC logical, intent(in) :: report","tags":"","url":"proc/excitons_interpolate_setup.html"},{"title":"RT_EULER_step – Yambo","text":"subroutine RT_EULER_step(dG_in, dG_out, ik, nbf, deltaT) Uses wrapper_omp pars real_time Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: dG_in (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) complex(kind=SP), intent(out) :: dG_out (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) integer, intent(in) :: ik integer, intent(in) :: nbf real(kind=SP), intent(in) :: deltaT","tags":"","url":"proc/rt_euler_step.html"},{"title":"K_driver_init – Yambo","text":"subroutine K_driver_init(what, iq, Ken, Xk) Uses parallel_m R_lattice stderr D_lattice pars parser_m BS_solvers drivers TDDFT BS electrons Arguments Type Intent Optional Attributes Name character(len=*) :: what integer :: iq type( levels ) :: Ken type( bz_samp ) :: Xk","tags":"","url":"proc/k_driver_init.html"},{"title":"section – Yambo","text":"subroutine section(mode, name) Uses parallel_m parallel_int stderr pars com it_tools timing_m LIVE_t Arguments Type Intent Optional Attributes Name character(len=*) :: mode character(len=*) :: name","tags":"","url":"proc/section.html"},{"title":"Pseudo_KB_gauge_factor – Yambo","text":"subroutine Pseudo_KB_gauge_factor(gauge_factor) Uses D_lattice pars UNITS FFT_m electrons Arguments Type Intent Optional Attributes Name complex(kind=SP) :: gauge_factor (fft_size,n_atoms)","tags":"","url":"proc/pseudo_kb_gauge_factor.html"},{"title":"PARSER_convert_INT – Yambo","text":"subroutine PARSER_convert_INT(ivar, v_descr, force_RL) Arguments Type Intent Optional Attributes Name integer :: ivar character(len=*) :: v_descr logical :: force_RL","tags":"","url":"proc/parser_convert_int.html"},{"title":"variables_RT_static – Yambo","text":"function variables_RT_static(ID) Uses RT_control R_lattice RT_output_m stderr pars X_m IO_m descriptors UNITS RT_lifetimes drivers hamiltonian fields real_time IO_int Arguments Type Intent Optional Attributes Name integer :: ID Return Value integer","tags":"","url":"proc/variables_rt_static.html"},{"title":"RT_RESTART_database_copy – Yambo","text":"subroutine RT_RESTART_database_copy(db) Uses RT_control parallel_m stderr pars com IO_m Arguments Type Inten