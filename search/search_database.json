 – Yambo","text":"subroutine TDDFT_BSK_2_FXC(iq, ik1, ik2, O1x, O2x, O_x_dim, W, X_static) Uses parallel_m R_lattice D_lattice pars X_m frequency IO_m BS_solvers TDDFT BS parallel_int electrons IO_int Arguments Type Intent Optional Attributes Name integer :: iq integer :: ik1 integer :: ik2 complex(kind=SP) :: O1x (FXC_n_g_corr,O_x_dim) complex(kind=SP) :: O2x (FXC_n_g_corr,O_x_dim) integer :: O_x_dim type( w_samp ) :: W type( X_t ) :: X_static","tags":"","url":"proc/tddft_bsk_2_fxc.html"},{"title":"k_map_fine_to_coarse – Yambo","text":"subroutine k_map_fine_to_coarse(zone, Xk, FG, FineGd_k, Xen) Uses R_lattice pars com LIVE_t electrons Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: zone type( bz_samp ), intent(inout) :: Xk type( bz_fine_grid ), intent(inout) :: FG type( bz_samp ), intent(inout) :: FineGd_k type( levels ), intent(inout) :: Xen","tags":"","url":"proc/k_map_fine_to_coarse.html"},{"title":"Bare_Hamiltonian – Yambo","text":"subroutine Bare_Hamiltonian(E, Xk, k) Uses parallel_m R_lattice wave_func pars QP_m timing_m hamiltonian parallel_int electrons xc_functionals interfaces H_interfaces Arguments Type Intent Optional Attributes Name type( levels ) :: E type( bz_samp ) :: Xk type( bz_samp ) :: k","tags":"","url":"proc/bare_hamiltonian.html"},{"title":"PP_addus_vloc_aug – Yambo","text":"subroutine PP_addus_vloc_aug(becprod, ngm, nspin_mag, ldrho, rhog) Uses pars ions_base uspp_param gvect uspp Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: becprod (nhm,nhm,nat,nspin_mag) integer, intent(in) :: ngm integer, intent(in) :: nspin_mag integer, intent(in) :: ldrho complex(kind=DP), intent(inout) :: rhog (ldrho,nspin_mag)","tags":"","url":"proc/pp_addus_vloc_aug.html"},{"title":"RT_k_grid – Yambo","text":"subroutine RT_k_grid(E, k, q) Uses parallel_m R_lattice pars drivers electrons real_time C_driver Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: E type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: q","tags":"","url":"proc/rt_k_grid.html"},{"title":"variables_BS – Yambo","text":"function variables_BS(ID, iq, desc, CLOSE_the_menu, X) Uses R_lattice pars X_m IO_m descriptors UNITS drivers BS IO_int Arguments Type Intent Optional Attributes Name integer :: ID integer :: iq type( IO_desc ) :: desc logical :: CLOSE_the_menu type( X_t ), optional :: X Return Value integer","tags":"","url":"proc/variables_bs.html"},{"title":"fft_3d – Yambo","text":"subroutine fft_3d(c, n, fft_sign, fftw_plan) Uses pars openmp Arguments Type Intent Optional Attributes Name complex(kind=DP) :: c (n(1),n(2),n(3)) integer :: n (3) integer :: fft_sign integer(kind=8) :: fftw_plan","tags":"","url":"proc/fft_3d.html"},{"title":"K_multiply_by_V_slepc_R – Yambo","text":"subroutine K_multiply_by_V_slepc_R(slepc_mat, vi, vo, ierr) Uses parallel_m slepcsysdef pars petscmat BS_solvers petscmatdef BS slepcsys Arguments Type Intent Optional Attributes Name real :: slepc_mat real :: vi real :: vo integer :: ierr","tags":"","url":"proc/k_multiply_by_v_slepc_r.html"},{"title":"K_multiply_by_V_slepc_C – Yambo","text":"subroutine K_multiply_by_V_slepc_C(slepc_mat, vi, vo, ierr) Uses parallel_m slepcsysdef pars petscmat BS_solvers petscmatdef BS slepcsys Arguments Type Intent Optional Attributes Name real :: slepc_mat real :: vi real :: vo integer :: ierr","tags":"","url":"proc/k_multiply_by_v_slepc_c.html"},{"title":"k_ibz2bz – Yambo","text":"subroutine k_ibz2bz(k, units, FORCE_BZ) Uses pars R_lattice vec_operate Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k character(len=1) :: units logical :: FORCE_BZ","tags":"","url":"proc/k_ibz2bz.html"},{"title":"QPSRT – Yambo","text":"subroutine QPSRT(LIMIT, LAST, MAXERR, ERMAX, ELIST, IORD, NRMAX) BEGIN PROLOGUE  QPSRT SUBSIDIARY PURPOSE  Subsidiary to QAGE, QAGIE, QAGPE, QAGSE, QAWCE, QAWOE and\n            QAWSE LIBRARY   SLATEC TYPE      SINGLE PRECISION (QPSRT-S, DQPSRT-D) KEYWORDS  SEQUENTIAL SORTING AUTHOR  (UNKNOWN) DESCRIPTION QPSRT\n           Ordering Routine\n              Standard FORTRAN Subroutine\n              REAL Version PURPOSE\n              This routine maintains the descending ordering\n              in the list of the local error estimates resulting from\n              the interval subdivision process. At each call two error\n              estimates are inserted using the sequential search\n              method, top-down for the largest error estimate\n              and bottom-up for the smallest error estimate. CALLING SEQUENCE\n              CALL QPSRT(LIMIT,LAST,MAXERR,ERMAX,ELIST,IORD,NRMAX) PARAMETERS ( MEANING AT OUTPUT ) LIMIT - INTEGER Maximum number of error estimates the list can contain LAST - INTEGER Number of error estimates currently in the list MAXERR - INTEGER MAXERR points to the NRMAX - th largest error estimate currently in the list ERMAX - REAL NRMAX - th largest error estimate ERMAX = ELIST ( MAXERR ) ELIST - REAL Vector of dimension LAST containing the error estimates IORD - INTEGER Vector of dimension LAST , the first K elements of which contain pointers to the error estimates , such that ELIST ( IORD ( 1 )) ,... , ELIST ( IORD ( K )) form a decreasing sequence , with K = LAST if LAST . LE . ( LIMIT / 2 + 2 ) , and K = LIMIT + 1 - LAST otherwise NRMAX - INTEGER MAXERR = IORD ( NRMAX ) SEE ALSO  QAGE, QAGIE, QAGPE, QAGSE, QAWCE, QAWOE, QAWSE ROUTINES CALLED  (NONE) REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890831  Modified array declarations.  (WRB)\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900328  Added TYPE section.  (WRB) END PROLOGUE  QPSRT **FIRST EXECUTABLE STATEMENT  QPSRT Arguments Type Intent Optional Attributes Name integer :: LIMIT integer :: LAST integer :: MAXERR real :: ERMAX real, dimension(*) :: ELIST integer, dimension(*) :: IORD integer :: NRMAX","tags":"","url":"proc/qpsrt.html"},{"title":"ELPH_databases_IO_modes – Yambo","text":"subroutine ELPH_databases_IO_modes(ph_file, n_q, q_pt, ph_freqs, ph_pol) Uses stderr D_lattice pars com UNITS Arguments Type Intent Optional Attributes Name character(len=schlen), intent(in) :: ph_file integer, intent(inout) :: n_q real(kind=SP), intent(out), optional :: q_pt (n_q,3) real(kind=SP), intent(out), optional :: ph_freqs (3*n_atoms,n_q) complex(kind=SP), intent(out), optional :: ph_pol (n_q,3*n_atoms,n_atoms,3)","tags":"","url":"proc/elph_databases_io_modes.html"},{"title":"io_COLLISIONS – Yambo","text":"function io_COLLISIONS(ID, COLL, COLL_element, i_coll_, COMM) Uses plasma R_lattice pars collision_ext X_m QP_m IO_m global_XC timing_m drivers xc_functionals IO_int Arguments Type Intent Optional Attributes Name integer, intent(inout) :: ID type( COLLISIONS_group ) :: COLL type( COLLISIONS_element ), optional :: COLL_element integer, intent(in), optional :: i_coll_ integer, intent(in), optional :: COMM Return Value integer","tags":"","url":"proc/io_collisions.html"},{"title":"TayExp – Yambo","text":"function TayExp(X) result(TAYEXP) Arguments Type Intent Optional Attributes Name real(kind=8) :: X Return Value real(kind=8)","tags":"","url":"proc/tayexp.html"},{"title":"XC_eval_pbegaux – Yambo","text":"subroutine XC_eval_pbegaux(spin_rho_DP, sigma, exsr, vx1, vx2) Uses D_lattice pars FFT_m electrons xc_functionals Arguments Type Intent Optional Attributes Name real(kind=DP), intent(in) :: spin_rho_DP (n_spin,fft_size) real(kind=DP), intent(in) :: sigma (xc_spin(1),fft_size) real(kind=DP), intent(out) :: exsr real(kind=DP), intent(out) :: vx1 (n_spin,fft_size) real(kind=DP), intent(out) :: vx2 (xc_spin(1),fft_size)","tags":"","url":"proc/xc_eval_pbegaux.html"},{"title":"pbexgau_lsd – Yambo","text":"subroutine pbexgau_lsd(RHOA, RHOB, GRHOAA, GRHOBB, sx, V1XA, V2XA, V1XB, V2XB, alpha_gau) Arguments Type Intent Optional Attributes Name real :: RHOA real :: RHOB real :: GRHOAA real :: GRHOBB real :: sx real :: V1XA real :: V2XA real :: V1XB real :: V2XB real :: alpha_gau","tags":"","url":"