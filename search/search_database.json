( ir1 - 1 ) / ( n_dl_pts - 1 ), dummy ( 3 ) * ( ir2 - 1 ) / ( n_dl_pts - 1 ) / )) pl_xz_pt ( ip ,:) =- (( / dummy ( 1 ) / 2. , 0._SP , dummy ( 3 ) / 2. / ) - & & ( / dummy ( 1 ) * ( ir1 - 1 ) / ( n_dl_pts - 1 ), 0._SP , dummy ( 3 ) * ( ir2 - 1 ) / ( n_dl_pts - 1 ) / )) if ( cut_is_sphere ) then v_xy ( ip , 1 ) = V_in_sphere ( pl_xy_pt ( ip ,:) ) v_yz ( ip , 1 ) = V_in_sphere ( pl_yz_pt ( ip ,:) ) v_xz ( ip , 1 ) = V_in_sphere ( pl_xz_pt ( ip ,:) ) endif ! if ( cut_is_box ) then v_xy ( ip , 1 ) = V_in_box ( pl_xy_pt ( ip ,:) ) v_yz ( ip , 1 ) = V_in_box ( pl_yz_pt ( ip ,:) ) v_xz ( ip , 1 ) = V_in_box ( pl_xz_pt ( ip ,:) ) endif if ( cut_is_cyl ) then v_xy ( ip , 1 ) = V_in_cyl ( pl_xy_pt ( ip ,:) ) v_yz ( ip , 1 ) = V_in_cyl ( pl_yz_pt ( ip ,:) ) v_xz ( ip , 1 ) = V_in_cyl ( pl_xz_pt ( ip ,:) ) endif if ( cut_is_ws . or . cut_is_slab ) then v_xy ( ip , 1 ) = V_in_ws ( pl_xy_pt ( ip ,:) ) v_yz ( ip , 1 ) = V_in_ws ( pl_yz_pt ( ip ,:) ) v_xz ( ip , 1 ) = V_in_ws ( pl_xz_pt ( ip ,:) ) endif enddo enddo ! ! ! CutOffed potential using qpg_bare ! call k_ibz2bz ( q , 'i' ,. true .) ! call PARALLEL_index ( px ,( / n_dl_pts ** 2 / )) call live_timing ( 'CutOff Test' , px % n_of_elements ( myid + 1 )) ! do ip = 1 , n_dl_pts ** 2 ! if (. not . px % element_1D ( ip )) cycle ! do iqbz = 1 , q % nbz do ig = 1 , wf_ng ! iqibz = q % sstar ( iqbz , 1 ) is = q % sstar ( iqbz , 2 ) ig_r = g_rot ( ig , sop_inv ( is ) ) ! dummy ( 1 ) = dot_product ( ( q % ptbz ( iqbz ,:) + g_vec ( ig ,:)) * 2._SP * pi / alat (:), pl_xy_pt ( ip ,:)) dummy ( 2 ) = dot_product ( ( q % ptbz ( iqbz ,:) + g_vec ( ig ,:)) * 2._SP * pi / alat (:), pl_yz_pt ( ip ,:)) dummy ( 3 ) = dot_product ( ( q % ptbz ( iqbz ,:) + g_vec ( ig ,:)) * 2._SP * pi / alat (:), pl_xz_pt ( ip ,:)) ! v_xy ( ip , 2 ) = v_xy ( ip , 2 ) + Exp ( cmplx ( 0. , dummy ( 1 ), SP ) ) * 4._SP * pi / bare_qpg ( iqibz , ig_r ) ** 2 v_yz ( ip , 2 ) = v_yz ( ip , 2 ) + Exp ( cmplx ( 0. , dummy ( 2 ), SP ) ) * 4._SP * pi / bare_qpg ( iqibz , ig_r ) ** 2 v_xz ( ip , 2 ) = v_xz ( ip , 2 ) + Exp ( cmplx ( 0. , dummy ( 3 ), SP ) ) * 4._SP * pi / bare_qpg ( iqibz , ig_r ) ** 2 ! enddo ! enddo ! v_xy ( ip , 2 ) = v_xy ( ip , 2 ) / DL_vol / real ( q % nbz ) v_yz ( ip , 2 ) = v_yz ( ip , 2 ) / DL_vol / real ( q % nbz ) v_xz ( ip , 2 ) = v_xz ( ip , 2 ) / DL_vol / real ( q % nbz ) ! call live_timing ( steps = 1 ) ! enddo ! call PP_redux_wait ( v_xy (:, 2 )) call PP_redux_wait ( v_yz (:, 2 )) call PP_redux_wait ( v_xz (:, 2 )) ! call live_timing () ! ! Output Files ! of_name ( 1 ) = 'xy_plane' of_name ( 2 ) = 'yz_plane' of_name ( 3 ) = 'xz_plane' of_name ( 4 ) = 'RL_components' call of_open_close ( of_name ( 1 ), 'ot' ) call msg ( 'o xy' , '#' ) call msg ( 'o xy' , '#' ,( / 'X [au]' , 'Y [au]' , 'V_Dlat' , 'V_Rlat' / ), INDENT = 0 , USE_TABS = . true .) call msg ( 'o xy' , '#' ) call of_open_close ( of_name ( 2 ), 'ot' ) call msg ( 'o yz' , '#' ) call msg ( 'o yz' , '#' ,( / 'Y [au]' , 'Z [au]' , 'V_Dlat' , 'V_Rlat' / ), INDENT = 0 , USE_TABS = . true .) call msg ( 'o yz' , '#' ) call of_open_close ( of_name ( 3 ), 'ot' ) call msg ( 'o xz' , '#' ) call msg ( 'o xz' , '#' ,( / 'X [au]' , 'Z [au]' , 'V_Dlat' , 'V_Rlat' / ), INDENT = 0 , USE_TABS = . true .) call msg ( 'o xz' , '#' ) call of_open_close ( of_name ( 4 ), 'ot' ) call msg ( 'o RL_' , '#' ) call msg ( 'o RL_' , '#' ,( / '|q+G| [au]' , ' V_o  [au]' , ' V_c  [au]' / ), INDENT = 0 , USE_TABS = . true .) call msg ( 'o RL_' , '#' ) ! do ip = 1 , n_dl_pts ** 2 call msg ( 'o xy' , '' ,( / pl_xy_pt ( ip , 1 ), pl_xy_pt ( ip , 2 ), v_xy ( ip , 1 ), v_xy ( ip , 2 ) / ), INDENT =- 2 , USE_TABS = . true .) call msg ( 'o xz' , '' ,( / pl_xz_pt ( ip , 1 ), pl_xz_pt ( ip , 3 ), v_xz ( ip , 1 ), v_xz ( ip , 2 ) / ), INDENT =- 2 , USE_TABS = . true .) call msg ( 'o yz' , '' ,( / pl_yz_pt ( ip , 2 ), pl_yz_pt ( ip , 3 ), v_yz ( ip , 1 ), v_yz ( ip , 2 ) / ), INDENT =- 2 , USE_TABS = . true .) enddo ! max_val = 0._SP ! do ig = 1 , wf_ng do iqbz = 1 , q % nbz ! iqibz = q % sstar (