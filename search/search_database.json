ent(in) :: iind integer, intent(in) :: iod integer, intent(in) :: icd integer, intent(in) :: ijs character(len=lnstr), intent(in) :: instr character(len=iinf), intent(in) :: inf character(len=iind), intent(in) :: ind character(len=iod), intent(in) :: od character(len=icd), intent(in) :: com_dir character(len=ijs), intent(in) :: js Return Value integer","tags":"","url":"proc/e2y.html"},{"title":"etsf_long_error – Yambo","text":"subroutine etsf_long_error(error_data) Uses etsf_io_low_level Arguments Type Intent Optional Attributes Name type(etsf_io_low_error), intent(in) :: error_data","tags":"","url":"proc/etsf_long_error.html"},{"title":"excitons_bands – Yambo","text":"subroutine excitons_bands(k, Xk, en, Xen, q) Uses parallel_m R_lattice parallel_int interpolate stderr pars functions com parser_m UNITS YPPm vec_operate LIVE_t electrons Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k type( bz_samp ) :: Xk type( levels ) :: en type( levels ) :: Xen type( bz_samp ) :: q","tags":"","url":"proc/excitons_bands.html"},{"title":"TDDFT_BSK_disk_2_FXC – Yambo","text":"subroutine TDDFT_BSK_disk_2_FXC(iq, Xk, W, X_static) Uses R_lattice parallel_int wave_func D_lattice matrix_operate pars com frequency X_m IO_m BS_solvers TDDFT BS LIVE_t interfaces IO_int Arguments Type Intent Optional Attributes Name integer :: iq type( bz_samp ) :: Xk type( w_samp ) :: W type( X_t ) :: X_static","tags":"","url":"proc/tddft_bsk_disk_2_fxc.html"},{"title":"G_rot_grid – Yambo","text":"subroutine G_rot_grid(is, call_kind) Uses R_lattice D_lattice pars zeros vec_operate Arguments Type Intent Optional Attributes Name integer :: is character(len=*) :: call_kind","tags":"","url":"proc/g_rot_grid.html"},{"title":"ERMOR – Yambo","text":"subroutine ERMOR(MSG, FLAG) Arguments Type Intent Optional Attributes Name character(len=*) :: MSG character(len=1) :: FLAG Common Blocks ERFIN (subroutine) SERV1 (subroutine) DERV1 (subroutine) ERMSG (subroutine) \">\n           common /M77ERR/ 198