 FUNCTIONS AUTHOR  Fullerton, W., (LANL) DESCRIPTION BESI1(X) calculates the modified (hyperbolic) Bessel function\n of the first kind of order one for real argument X. Series for BI1        on the interval  0.          to  9.00000D+00\n                                        with weighted error   2.40E-17\n                                         log weighted error  16.62\n                               significant figures required  16.23\n                                    decimal places required  17.14 REFERENCES  (NONE) ROUTINES CALLED  BESI1E, CSEVL, INITS, R1MACH, XERMSG REVISION HISTORY  (YYMMDD)\n   770401  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   900326  Removed duplicate information from DESCRIPTION section.\n           (WRB) END PROLOGUE  BESI1\n**FIRST EXECUTABLE STATEMENT  BESI1 Arguments Type Intent Optional Attributes Name real :: X Return Value real","tags":"","url":"proc/besi1.html"},{"title":"ELPH_databases_IO_transfer_and_write – Yambo","text":"subroutine ELPH_databases_IO_transfer_and_write(IDB, k, E, GKKP) Uses R_lattice ELPH D_lattice YPP_ELPH pars electrons Arguments Type Intent Optional Attributes Name integer :: IDB type( bz_samp ) :: k type( levels ) :: E type( GKKP_me ) :: GKKP","tags":"","url":"proc/elph_databases_io_transfer_and_write.html"},{"title":"DQPSRT – Yambo","text":"subroutine DQPSRT(LIMIT, LAST, MAXERR, ERMAX, ELIST, IORD, NRMAX) BEGIN PROLOGUE  DQPSRT SUBSIDIARY PURPOSE  This routine maintains the descending ordering in the\n            list of the local error estimated resulting from the\n            interval subdivision process. At each call two error\n            estimates are inserted using the sequential search\n            method, top-down for the largest error estimate and\n            bottom-up for the smallest error estimate. LIBRARY   SLATEC TYPE      DOUBLE PRECISION (QPSRT-S, DQPSRT-D) KEYWORDS  SEQUENTIAL SORTING AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Ordering routine Standard fortran subroutine Double precision version PARAMETERS ( MEANING AT OUTPUT ) LIMIT - Integer Maximum number of error estimates the list can contain LAST - Integer Number of error estimates currently in the list MAXERR - Integer MAXERR points to the NRMAX - th largest error estimate currently in the list ERMAX - Double precision NRMAX - th largest error estimate ERMAX = ELIST ( MAXERR ) ELIST - Double precision Vector of dimension LAST containing the error estimates IORD - Integer Vector of dimension LAST , the first K elements of which contain pointers to the error estimates , such that ELIST ( IORD ( 1 )) ,..., ELIST ( IORD ( K )) form a decreasing sequence , with K = LAST if LAST . LE . ( LIMIT / 2 + 2 ) , and K = LIMIT + 1 - LAST otherwise NRMAX - Integer MAXERR = IORD ( NRMAX ) SEE ALSO  DQAGE, DQAGIE, DQAGPE, DQAWSE ROUTINES CALLED  (NONE) REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890831  Modified array declarations.  (WRB)\n   890831  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900328  Added TYPE section.  (WRB) END PROLOGUE  DQPSRT **FIRST EXECUTABLE STATEMENT  DQPSRT Arguments Type Intent Optional Attributes Name integer :: LIMIT integer :: LAST integer :: MAXERR double precision :: ERMAX double precision, dimension(*) :: ELIST integer, dimension(*) :: IORD integer :: NRMAX","tags":"","url":"proc/dqpsrt.html"},{"title":"startup – Yambo","text":"subroutine startup() Uses gpu_loc_m Arguments None","tags":"","url":"proc/startup.html"},{"title":"ELPH_acoustic_phonon_properties – Yambo","text":"subroutine ELPH_acoustic_phonon_properties(q) Uses R_lattice ELPH stderr pars com UNITS vec_operate Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: q","tags":"","url":"proc/elph_acoustic_phonon_properties.html"},{"title":"io_GROT – Yambo","text":"function io_GROT(io_db) Uses R_lattice D_lattice IO_m timing_m IO_int Arguments Type Intent Optional Attributes Name integer :: io_db Return Value integer","tags":"","url":"proc/io_grot.html"},{"title":"ELECTR_initial_check – Yambo","text":"subroutine ELECTR_initial_check(k, Dip) Uses R_lattice pars com DIPOLES SC UNITS vec_operate fields Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k type( DIPOLE_t ) :: Dip","tags":"","url":"proc/electr_initial_check.html"},{"title":"INIT_q_points – Yambo","text":"subroutine INIT_q_points() Uses R_lattice pars parser_m it_tools vec_operate drivers Arguments None","tags":"","url":"proc/init_q_points.html"},{"title":"SLK_setup – Yambo","text":"subroutine SLK_setup(idriver, ncpu_in_use, ORTHO, POOL, COMM, INDEX_comm, slk_error) Uses parallel_m SLK_m com linear_algebra Arguments Type Intent Optional Attributes Name integer, intent(in) :: idriver integer, intent(in) :: ncpu_in_use type( ORTHO_group ), intent(inout) :: ORTHO type( POOL_group ), intent(inout) :: POOL type( yMPI_comm ), intent(in) :: COMM type( yMPI_comm ), intent(in) :: INDEX_comm integer, intent(inout) :: slk_error","tags":"","url":"proc/slk_setup.html"},{"title":"k_circuit_made_of_user_points – Yambo","text":"subroutine k_circuit_made_of_user_points() Uses pars com parser_m YPPm vec_operate Arguments None","tags":"","url":"proc/k_circuit_made_of_user_points.html"},{"title":"WF_map_perturbative_SOC – Yambo","text":"subroutine WF_map_perturbative_SOC(kpt, En) Uses R_lattice wave_func D_lattice stderr pars com IO_m LIVE_t YPPm vec_operate zeros FFT_m electrons interfaces IO_int Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: kpt type( levels ), intent(inout) :: En","tags":"","url":"proc/wf_map_perturbative_soc.html"},{"title":"RT_initialize – Yambo","text":"subroutine RT_initialize(E, k, q) Uses parallel_m R_lattice com X_m parser_m vec_operate RT_lifetimes parallel_int real_time plasma stderr D_lattice pars collision_ext QP_CTL_m fields RT_control IO_m UNITS drivers RT_occupations electrons Arguments Type Intent Optional Attributes Name type( levels ), intent(inout) :: E type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: q","tags":"","url":"proc/rt_initialize.html"},{"title":"ELPH_gsqF_to_Sigma – Yambo","text":"subroutine ELPH_gsqF_to_Sigma(en, q, l_GF_from_CA, Sc_W) Uses parallel_m R_lattice ELPH parallel_int functions pars frequency QP_m UNITS LIVE_t electrons Arguments Type Intent Optional Attributes Name type( levels ) :: en type( bz_samp ) :: q logical :: l_GF_from_CA type( w_samp ) :: Sc_W (QP_n_states)","tags":"","url":"proc/elph_gsqf_to_sigma.html"},{"title":"RT_INV_step_std – Yambo","text":"subroutine RT_INV_step_std(dG_old, dG_inp, dG_out, ik, deltaT) Uses wrapper_omp pars real_time Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: dG_old (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) complex(kind=SP), intent(in) :: dG_inp (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) complex(kind=SP), intent(out) :: dG_out (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) integer, intent(in) :: ik real(kind=SP), intent(in) :: deltaT","tags":"","url":"proc/rt_inv_step_std.html"},{"title":"ELPH_databases – Yambo","text":"subroutine ELPH_databases(k, E, q) Uses R_lattice ELPH ALLOC parallel_int stderr D_lattice YPP_ELPH pars com parser_m IO_m UNITS vec_operate zeros LIVE_t electrons IO_int Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k type( levels ) :: E type( bz_samp ) :: q","tags":"","url":"proc/elph_databases.html"},{"title":"DIPOLE_ALLOC_elemental – Yambo","text":"subroutine DIPOLE_ALLOC_elemental(what, d) Uses gpu_m pars electrons DIPOLES Arguments Type Intent Optional Attributes Name character(len=*) :: what integer, optional :: d (:)","tags":"","url":"proc/dipole_alloc_elemental.html"},{"title":"DIPOLE_kb_init – Yambo","text":"subroutine DIPOLE_kb_init(Xen, Dip, io_err, ID) Uses pseudo stderr D_lattice pars DIPOLES com IO_m electrons IO_int Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: Xen type( DIPOLE_t ), intent(inout) :: Dip integer :: io_err (3) integer :: ID","tags":"","url":"proc/dipole_kb_init.html"},{"title":"fft_1d – Yambo","text":"subroutine fft_1d(c, n, fft_sign) Uses pars Arguments Type Intent Optional Attributes Name complex(kind=DP), intent(inout) :: c (n) integer, intent(in) :: n integer, intent(in) :: fft_sign","tags":"","url":"proc/fft_1d.html"},{"title":"G_index – Yambo","text":"function G_index(v1, accept_fail) Uses pars R_lattice zeros vec_operate Arguments Type Intent Optional Attributes Name real(kind=SP), intent(in) :: v1 (3) logical, intent(in) :: accept_fail Return Value integer","tags":"","url":"proc/g_index.html"},{"title":"scatter_ModScr – Yambo","text":"subroutine scatter_ModScr(isc, mu) Uses R_lattice gpu_m collision_el devxlib pars global_XC drivers xc_functionals Arguments Type Intent Optional Attributes Name type( elemental_collision ) :: isc real(kind=SP) :: mu","tags":"","url":"proc/scatter_modscr.html"},{"title":"PROJECTION_setup – Yambo","text":"subroutine PROJECTION_setup(what, bands) Uses R_lattice interpolate YPP_interfaces stderr pars com vec_operate YPPm LIVE_t electrons Arguments Type Intent Optional Attributes Name character(len=*) :: what integer, optional :: bands (2)","tags":"","url":"proc/projection_setup.html"},{"title":"ELPH_atomic_amplitude – Yambo","text":"subroutine ELPH_atomic_amplitude(q) Uses R_lattice ELPH D_lattice stderr linear_algebra pars functions com IO_m UNITS ALLOC interfaces IO_int Arguments Type Intent Optional Attributes Name type( bz_samp ) :: q","tags":"","url":"proc/elph_atomic_amplitude.html"},{"title":"QK15W – Yambo","text":"subroutine QK15W(F, W, P1, P2, P3, P4, KP, A, B, RESULT, ABSERR, RESABS, RESASC) BEGIN PROLOGUE  QK15W PURPOSE  To compute I = Integral of F W over (A,B), with error\n                           estimate\n                       J = Integral of ABS(F W) over (A,B) LIBRARY   SLATEC (QUADPACK) CATEGORY  H2A2A2 TYPE      SINGLE PRECISION (QK15W-S, DQK15W-D) KEYWORDS  15-POINT GAUSS-KRONROD RULES, QUADPACK, QUADRATURE AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Integration rules Standard fortran subroutine Real version PARAMETERS ON ENTRY F - Real Function subprogram defining the integrand function F ( X ). The actual name for F needs to be declared E X T E R N A L in the driver program . W - Real Function subprogram defining the integrand WEIGHT function W ( X ). The actual name for W needs to be declared E X T E R N A L in the calling program . P1 , P2 , P3 , P4 - Real Parameters in the WEIGHT function KP - Integer Key for indicating the type of WEIGHT function A - Real Lower limit of integration B - Real Upper limit of integration ON RETURN RESULT - Real Approximation to the integral I RESULT is computed by applying the 15 - point Kronrod rule ( RESK ) obtained by optimal addition of abscissae to the 7 - point Gauss rule ( RESG ). ABSERR - Real Estimate of the modulus of the absolute error , which should equal or exceed ABS ( I - RESULT ) RESABS - Real Approximation to the integral of ABS ( F ) RESASC - Real Approximation to the integral of ABS ( F - I / ( B - A )) REFERENCES  (NONE) ROUTINES CALLED  R1MACH REVISION HISTORY  (YYMMDD)\n   810101  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB) END PROLOGUE  QK15W **FIRST EXECUTABLE STATEMENT  QK15W Arguments Type Intent Optional Attributes Name real :: F real :: W real :: P1 real :: P2 real :: P3 real :: P4 integer :: KP real :: A real :: B real :: RESULT real :: ABSERR real :: RESABS real :: RESASC","tags":"","url":"proc/qk15w.html"},{"title":"matches – Yambo","text":"function matches(string1, string2) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: string1 character(len=*), intent(in) :: string2 Return Value logical","tags":"","url":"proc/matches.html"},{"title":"PARALLEL_global_Response_T_transitions – Yambo","text":"subroutine PARALLEL_global_Response_T_transitions(Xk) Uses parallel_m R_lattice BS parallel_int IO_int Arguments Type Intent Optional Attributes Name type( bz_samp ) :: Xk","tags":"","url":"proc/parallel_global_response_t_transitions.html"},{"title":"RT_Lifetimes_merge_intra_k – Yambo","text":"subroutine RT_Lifetimes_merge_intra_k(LIFE) Uses parallel_m R_lattice RT_lifetimes parallel_int real_time Arguments Type Intent Optional Attributes Name type( RT_lifetime ), intent(inout) :: LIFE","tags":"","url":"proc/rt_lifetimes_merge_intra_k.html"},{"title":"QP_DBs_merge – Yambo","text":"subroutine QP_DBs_merge(n_dbs, qp2merge, plan_EWZG, n_GROUNDS, qp, OP, PRE_FAC, FILES) Uses stderr pars com QP_m descriptors vec_operate C_driver Arguments Type Intent Optional Attributes Name integer :: n_dbs type( QP_t ) :: qp2merge (n_dbs) logical :: plan_EWZG (n_dbs,4) integer :: n_GROUNDS type( QP_t ), optional :: qp (n_GROUNDS) character(len=*), optional :: OP (n_dbs) real(kind=SP), optional :: PRE_FAC (n_dbs) character(len=*), optional :: FILES (n_dbs)","tags":"","url":"proc/qp_dbs_merge.html"},{"title":"Dipole_spin_magnetization – Yambo","text":"subroutine Dipole_spin_magnetization(Xen, Xk, Dip) Uses parallel_m R_lattice wave_func FFT_m pars DIPOLES timing_m drivers LIVE_t electrons interfaces wrapper Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: Xen type( bz_samp ), intent(in) :: Xk type( DIPOLE_t ), intent(inout) :: Dip","tags":"","url":"proc/dipole_spin_magnetization.html"},{"title":"QP_fit_widths – Yambo","text":"subroutine QP_fit_widths(i_ACTION, bands, en, k, qp) Uses R_lattice pars QP_m QP_CTL_m POL_FIT_m UNITS electrons interfaces Arguments Type Intent Optional Attributes Name integer :: i_ACTION integer :: bands (2) type( levels ) :: en type( bz_samp ) :: k type( QP_t ) :: qp","tags":"","url":"proc/qp_fit_widths.html"},{"title":"DIPOLE_kb_pwscf_comp – Yambo","text":"subroutine DIPOLE_kb_pwscf_comp(npp, npp_tab, ia, is, ik, Xk, kbv) Uses R_lattice wave_func pseudo D_lattice pars vec_operate electrons Arguments Type Intent Optional Attributes Name integer, intent(out) :: npp integer, intent(inout) :: npp_tab integer, intent(in) :: ia integer, intent(in) :: is integer, intent(in) :: ik type( bz_samp ), intent(in) :: Xk complex(kind=SP), intent(out) :: kbv (wf_ncx,n_spinor,4,pp_kbv_dim_atom)","tags":"","url":"proc/dipole_kb_pwscf_comp.html"},{"title":"a2y_db1 – Yambo","text":"subroutine a2y_db1(en, k, ncid) Uses R_lattice wave_func pseudo D_lattice netcdf_data pars com netcdf mod_com2y electrons Arguments Type Intent Optional Attributes Name type( levels ), intent(inout) :: en type( bz_samp ), intent(inout) :: k integer, intent(in) :: ncid","tags":"","url":"proc/a2y_db1.html"},{"title":"RT_Scattering_step – Yambo","text":"subroutine RT_Scattering_step(dG_old, dG_inp, dG_out, ik, deltaT) Uses RT_operations pars RT_occupations electrons real_time Option B: Written in the same form of RTA Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: dG_old (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) complex(kind=SP), intent(in) :: dG_inp (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) complex(kind=SP), intent(inout) :: dG_out (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) integer, intent(in) :: ik real(kind=SP), intent(in) :: deltaT","tags":"","url":"proc/rt_scattering_step.html"},{"title":"rim – Yambo","text":"subroutine rim(mode, Xw) Uses parallel_m R_lattice D_lattice pars com frequency LIVE_t timing_m vec_operate parallel_int Arguments Type Intent Optional Attributes Name character(len=1) :: mode type( w_samp ) :: Xw","tags":"","url":"proc/rim.html"},{"title":"DIPOLE_ALLOC_global – Yambo","text":"subroutine DIPOLE_ALLOC_global(D, NK) Uses ALLOC DIPOLES stderr Arguments Type Intent Optional Attributes Name type( DIPOLE_t ), intent(inout), optional :: D integer, optional :: NK","tags":"","url":"proc/dipole_alloc_global.html"},{"title":"INTERPOLATION_BZ_coeff – Yambo","text":"subroutine INTERPOLATION_BZ_coeff(Xk, VALUEs, engre, nvalues, Nk, ID) Uses parallel_m R_lattice parallel_int interpolate D_lattice pars interpolate_tools vec_operate LIVE_t Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: Xk real(kind=SP), intent(in) :: VALUEs (nvalues,Nk) complex(kind=DP), intent(out) :: engre (nshells,nvalues) integer, intent(in) :: nvalues integer, intent(in) :: Nk integer, intent(in) :: ID","tags":"","url":"proc/interpolation_bz_coeff.html"},{"title":"INIT_QP_ctl_load – Yambo","text":"subroutine INIT_QP_ctl_load(defs, ID) Uses it_tools it_m QP_CTL_m Arguments Type Intent Optional Attributes Name type( initdefs ) :: defs integer, intent(in) :: ID","tags":"","url":"proc/init_qp_ctl_load.html"},{"title":"DQK41 – Yambo","text":"subroutine DQK41(F, A, B, RESULT, ABSERR, RESABS, RESASC) BEGIN PROLOGUE  DQK41 PURPOSE  To compute I = Integral of F over (A,B), with error\n                           estimate\n                       J = Integral of ABS(F) over (A,B) LIBRARY   SLATEC (QUADPACK) CATEGORY  H2A1A2 TYPE      DOUBLE PRECISION (QK41-S, DQK41-D) KEYWORDS  41-POINT GAUSS-KRONROD RULES, QUADPACK, QUADRATURE AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Integration rules Standard fortran subroutine Double precision version PARAMETERS ON ENTRY F - Double precision Function subprogram defining the integrand FUNCTION F ( X ) . The actual name for F needs to be declared E X T E R N A L in the calling program . A - Double precision Lower limit of integration B - Double precision Upper limit of integration ON RETURN RESULT - Double precision Approximation to the integral I RESULT is computed by applying the 41 - POINT GAUSS - KRONROD RULE ( RESK ) obtained by optimal addition of abscissae to the 20 - POINT GAUSS RULE ( RESG ) . ABSERR - Double precision Estimate of the modulus of the absolute error , which should not exceed ABS ( I - RESULT ) RESABS - Double precision Approximation to the integral J RESASC - Double precision Approximation to the integral of ABS ( F - I / ( B - A )) over ( A , B ) REFERENCES  (NONE) ROUTINES CALLED  D1MACH REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB) END PROLOGUE  DQK41 **FIRST EXECUTABLE STATEMENT  DQK41 Arguments Type Intent Optional Attributes Name real :: F double precision :: A double precision :: B double precision :: RESULT double precision :: ABSERR double precision :: RESABS double precision :: RESASC","tags":"","url":"proc/dqk41.html"},{"title":"I1MACH – Yambo","text":"function I1MACH(I) BEGIN PROLOGUE  I1MACH PURPOSE  Return integer machine dependent constants. LIBRARY   SLATEC CATEGORY  R1 TYPE      INTEGER (I1MACH-I) KEYWORDS  MACHINE CONSTANTS AUTHOR  Fox, P. A., (Bell Labs)\n           Hall, A. D., (Bell Labs)\n           Schryer, N. L., (Bell Labs) DESCRIPTION I1MACH can be used to obtain machine-dependent parameters for the\n   local machine environment.  It is a function subprogram with one\n   (input) argument and can be referenced as follows: K = I1MACH(I) where I=1,...,16.  The (output) value of K above is determined by\n   the (input) value of I.  The results for various values of I are\n   discussed below. I/O unit numbers:\n     I1MACH( 1) = the standard input unit.\n     I1MACH( 2) = the standard output unit.\n     I1MACH( 3) = the standard punch unit.\n     I1MACH( 4) = the standard error message unit. Words:\n     I1MACH( 5) = the number of bits per integer storage unit.\n     I1MACH( 6) = the number of characters per integer storage unit. Integers:\n     assume integers are represented in the S-digit, base-A form sign ( X(S-1)*A**(S-1) + ... + X(1)*A + X(0) )\n\n            where 0 .LE. X(I) .LT. A for I=0,...,S-1.\n I1MACH( 7) = A, the base.\n I1MACH( 8) = S, the number of base-A digits.\n I1MACH( 9) = A**S - 1, the largest magnitude. Floating-Point Numbers:\n     Assume floating-point numbers are represented in the T-digit,\n     base-B form\n                sign (B E)*( (X(1)/B) + ... + (X(T)/B T) ) where 0 . LE . X ( I ) . LT . B for I = 1 ,..., T , 0 . LT . X ( 1 ) , and EMIN . LE . E . LE . EMAX . I1MACH ( 10 ) = B , the base . Single-Precision:\n     I1MACH(11) = T, the number of base-B digits.\n     I1MACH(12) = EMIN, the smallest exponent E.\n     I1MACH(13) = EMAX, the largest exponent E. Double-Precision:\n     I1MACH(14) = T, the number of base-B digits.\n     I1MACH(15) = EMIN, the smallest exponent E.\n     I1MACH(16) = EMAX, the largest exponent E. To alter this function for a particular environment, the desired\n   set of DATA statements should be activated by removing the C from\n   column 1.  Also, the values of I1MACH(1) - I1MACH(4) should be\n   checked for consistency with the local operating system. REFERENCES  P. A. Fox, A. D. Hall and N. L. Schryer, Framework for\n                 a portable library, ACM Transactions on Mathematical\n                 Software 4, 2 (June 1978), pp. 177-188. ROUTINES CALLED  (NONE) REVISION HISTORY  (YYMMDD)\n   750101  DATE WRITTEN\n   891012  Added VAX G-floating constants.  (WRB)\n   891012  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900618  Added DEC RISC constants.  (WRB)\n   900723  Added IBM RS 6000 constants.  (WRB)\n   901009  Correct I1MACH(7) for IBM Mainframes. Should be 2 not 16.\n           (RWC)\n   910710  Added HP 730 constants.  (SMR)\n   911114  Added Convex IEEE constants.  (WRB)\n   920121  Added SUN -r8 compiler option constants.  (WRB)\n   920229  Added Touchstone Delta i860 constants.  (WRB)\n   920501  Reformatted the REFERENCES section.  (WRB)\n   920625  Added Convex -p8 and -pd8 compiler option constants.\n           (BKS, WRB)\n   930201  Added DEC Alpha and SGI constants.  (RWC and WRB)\n   930618  Corrected I1MACH(5) for Convex -p8 and -pd8 compiler\n           options.  (DWL, RWC and WRB). END PROLOGUE  I1MACH **FIRST EXECUTABLE STATEMENT  I1MACH Arguments Type Intent Optional Attributes Name integer :: I Return Value integer","tags":"","url":"proc/i1mach.html"},{"title":"COLLISIONS_linearize_and_IO – Yambo","text":"subroutine COLLISIONS_linearize_and_IO(what, i_coll, last_coll, COLL, COLL_element, COLL_ID, COMM) Uses parallel_m COLL_interfaces pars collision_ext IO_m timing_m parallel_int IO_int Arguments Type Intent Optional Attributes Name character(len=*) :: what integer, intent(in) :: i_coll integer, intent(in) :: last_coll type( COLLISIONS_group ), intent(inout) :: COLL type( COLLISIONS_element ), intent(inout) :: COLL_element (COLL%N) integer, intent(inout) :: COLL_ID type( yMPI_comm ), intent(in) :: COMM","tags":"","url":"proc/collisions_linearize_and_io.html"},{"title":"RT_average_operator – Yambo","text":"subroutine RT_average_operator(N_V, O_VALUE, V_VALUE, O_REAL, O_QP, O_MATRIX, V_MATRIX, PV_MATRIX, G, k, en, TRANS, Double_Grid, nK_mem) Uses parallel_m R_lattice parallel_int wave_func wrapper_omp pars QP_m timing_m FFT_m electrons real_time H_interfaces Arguments Type Intent Optional Attributes Name integer, intent(in) :: N_V complex(kind=SP), intent(out), optional :: O_VALUE complex(kind=SP), intent(out), optional :: V_VALUE (N_V) real(kind=SP), intent(in), optional :: O_REAL (fft_size,n_spin) complex(kind=SP), intent(in), optional :: O_QP (QP_n_states) complex(kind=SP), intent(in), optional :: O_MATRIX (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2),nK_mem,n_sp_pol) complex(kind=SP), intent(in), optional :: V_MATRIX (N_V,RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2),nK_mem,n_sp_pol) complex(kind=SP), intent(in), optional :: PV_MATRIX (N_V,RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2),nK_mem,n_sp_pol) complex(kind=SP), intent(in) :: G (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2),PAR_G_k_range(1):PAR_G_k_range(2)) type( bz_samp ), intent(in) :: k type( levels ), intent(in) :: en logical, intent(in), optional :: TRANS character(len=6), intent(in), optional :: Double_Grid integer, intent(in) :: nK_mem","tags":"","url":"proc/rt_average_operator.html"},{"title":"io_elemental – Yambo","text":"subroutine io_elemental(ID, VAR, VAR_SZ, CHECK, WARN, OP, I0, DB_I0, I1, DB_I1, R0, DB_R0, R1, DB_R1, D0, DB_D0, C0, DB_C0, CH0, DB_CH0, CH1, L0, DB_L0, UNIT, MENU, DESCRIPTOR, DO_NOT_DUMP, TERMINATOR) Uses stderr pars com netcdf IO_m descriptors drivers iso_c_binding Arguments Type Intent Optional Attributes Name integer :: ID character(len=*), optional :: VAR integer, optional :: VAR_SZ logical, optional :: CHECK logical, optional :: WARN character(len=*), optional :: OP (:) integer, optional :: I0 integer, optional :: DB_I0 integer, optional :: I1 (:) integer, optional :: DB_I1 (:) real(kind=SP), optional :: R0 real(kind=SP), optional :: DB_R0 real(kind=SP), optional :: R1 (:) real(kind=SP), optional :: DB_R1 (:) real(kind=DP), optional :: D0 real(kind=DP), optional :: DB_D0 complex(kind=SP), optional, target :: C0 complex(kind=SP), optional :: DB_C0 character(len=*), optional :: CH0 character(len=*), optional :: DB_CH0 character(len=*), optional :: CH1 (:) logical, optional :: L0 logical, optional :: DB_L0 real(kind=SP), optional :: UNIT integer, optional :: MENU type( IO_desc ), optional :: DESCRIPTOR logical, optional :: DO_NOT_DUMP character(len=*), optional :: TERMINATOR","tags":"","url":"proc/io_elemental.html"},{"title":"acknowledge_yambo – Yambo","text":"subroutine acknowledge_yambo() Uses LIVE_t com Arguments None","tags":"","url":"proc/acknowledge_yambo.html"},{"title":"External_corrections – Yambo","text":"subroutine External_corrections(en, Xen, Ken, DIPen, Xk, k, X) Uses R_lattice pars X_m QP_CTL_m drivers BS electrons Arguments Type Intent Optional Attributes Name type( levels ) :: en type( levels ) :: Xen type( levels ) :: Ken type( levels ) :: DIPen type( bz_samp ) :: Xk type( bz_samp ) :: k type( X_t ) :: X (5)","tags":"","url":"proc/external_corrections.html"},{"title":"Build_tilde_vbands – Yambo","text":"subroutine Build_tilde_vbands(en, Xk, ikbz, i_sp, istep, id_red, V_bands, V_tilde) Uses R_lattice wrapper_omp pars DIPOLES QP_m vec_operate hamiltonian electrons electric Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: en type( bz_samp ), intent(in) :: Xk integer, intent(in) :: ikbz integer, intent(in) :: i_sp integer, intent(in) :: istep integer, intent(in) :: id_red complex(kind=SP), intent(in) :: V_bands (H_ref_bands(2),en%nbf(i_sp),QP_nk) complex(kind=SP), intent(out) :: V_tilde (en%nbf(i_sp),H_ref_bands(1):H_ref_bands(2),2)","tags":"","url":"proc/build_tilde_vbands.html"},{"title":"PP_becprod_calc – Yambo","text":"subroutine PP_becprod_calc(becprod, nspin, current_spin, domag, mb, nb, becp, becpp) Uses control_flags becmod noncollin_module ions_base kinds uspp_param uspp Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(out) :: becprod (nhm,nhm,nat,nspin) integer, intent(in) :: nspin integer, intent(in) :: current_spin logical, intent(in) :: domag integer, intent(in) :: mb integer, intent(in) :: nb type( bec_type ), intent(in) :: becp type( bec_type ), intent(in) :: becpp","tags":"","url":"proc/pp_becprod_calc.html"},{"title":"add_becprod_nc – Yambo","text":"subroutine add_becprod_nc(na, np, aux_nc, becprod, nspin_mag, domag) Uses noncollin_module uspp_param ions_base kinds Arguments Type Intent Optional Attributes Name integer, intent(in) :: na integer, intent(in) :: np complex(kind=SP), intent(in) :: aux_nc (nh(np),npol,nh(np),npol) complex(kind=SP), intent(inout) :: becprod (nhm,nhm,nat,nspin_mag) integer, intent(in) :: nspin_mag logical, intent(in) :: domag","tags":"","url":"proc/add_becprod_nc.html"},{"title":"add_becprod_so – Yambo","text":"subroutine add_becprod_so(na, np, aux_so, becprod, nspin_mag, domag) Uses noncollin_module ions_base kinds spin_orb uspp_param uspp Arguments Type Intent Optional Attributes Name integer, intent(in) :: na integer, intent(in) :: np complex(kind=SP), intent(in) :: aux_so (nh(np),npol,nh(np),npol) complex(kind=SP), intent(inout) :: becprod (nhm,nhm,nat,nspin_mag) integer, intent(in) :: nspin_mag logical, intent(in) :: domag","tags":"","url":"proc/add_becprod_so.html"},{"title":"I1MACH – Yambo","text":"function I1MACH(I) Arguments Type Intent Optional Attributes Name integer :: I Return Value integer","tags":"","url":"proc/i1mach~2.html"},{"title":"R1MACH – Yambo","text":"function R1MACH(I) Arguments Type Intent Optional Attributes Name integer :: I Return Value real","tags":"","url":"proc/r1mach.html"},{"title":"D1MACH – Yambo","text":"function D1MACH(I) Arguments Type Intent Optional Attributes Name integer :: I Return Value doubleprecision","tags":"","url":"proc/d1mach.html"},{"title":"AMSUB1 – Yambo","text":"function AMSUB1(TEST1) Arguments Type Intent Optional Attributes Name double precision :: TEST1 Return Value doubleprecision","tags":"","url":"proc/amsub1.html"},{"title":"AMACH – Yambo","text":"subroutine AMACH(MODE, I, I1, R1, D1) Arguments Type Intent Optional Attributes Name integer :: MODE 2003-04-25 AMACH  Krogh   Added comment for the Absoft compiler.\n2001-03-13 AMACH  Krogh   Fixed HOW for case when not set in m77job.\n1997-04-16 AMACH  Krogh   Remove blank lines -- was confusing m77con\n1996-03-30 AMACH  Krogh   Added external statement.\n1994-10-26 AMACH  Krogh   Changes to use M77CON\n1994-09-23 AMACH  Snyder  Add VAX G parameters\n1994-06-21 AMACH  Snyder  Compute only round-off and u-flow at first\n1994-05-25 AMACH  Snyder  Added an option to compute at run time.\n1992-04-07 AMACH  Oken    Removed &#94;Z at EOF (error found by VAX comp\n1992-02-20 AMACH  Snyder  Added Cray-J90 stuff, q.v.\n1990-06-11 AMACH  Snyder  Added Apollo DN-10000 stuff, q.v.\n1990-12-14 AMACH  Lawson  Changed to eliminate ENTRY statements.\n1990-08-21 AMACH  Krogh   No test was getting done for bad machine.\n1990-02-28 AMACH  Krogh   Correct missing DOUBLE PRECISION AMSUB1\n1989-08-14 AMACH  Krogh   Parameterized everything -- Massive change\n1989-03-30 AMACH  Snyder  Correct missing \"/\" line 921\n1989-01-30 AMACH  Snyder  Incorporate more constants from NETLIB.\n1988-05-19 AMACH  Lawson  Initial code. integer :: I 2003-04-25 AMACH  Krogh   Added comment for the Absoft compiler.\n2001-03-13 AMACH  Krogh   Fixed HOW for case when not set in m77job.\n1997-04-16 AMACH  Krogh   Remove blank lines -- was confusing m77con\n1996-03-30 AMACH  Krogh   Added external statement.\n1994-10-26 AMACH  Krogh   Changes to use M77CON\n1994-09-23 AMACH  Snyder  Add VAX G parameters\n1994-06-21 AMACH  Snyder  Compute only round-off and u-flow at first\n1994-05-25 AMACH  Snyder  Added an option to compute at run time.\n1992-04-07 AMACH  Oken    Removed &#94;Z at EOF (error found by VAX comp\n1992-02-20 AMACH  Snyder  Added Cray-J90 stuff, q.v.\n1990-06-11 AMACH  Snyder  Added Apollo DN-10000 stuff, q.v.\n1990-12-14 AMACH  Lawson  Changed to eliminate ENTRY statements.\n1990-08-21 AMACH  Krogh   No test was getting done for bad machine.\n1990-02-28 AMACH  Krogh   Correct missing DOUBLE PRECISION AMSUB1\n1989-08-14 AMACH  Krogh   Parameterized everything -- Massive change\n1989-03-30 AMACH  Snyder  Correct missing \"/\" line 921\n1989-01-30 AMACH  Snyder  Incorporate more constants from NETLIB.\n1988-05-19 AMACH  Lawson  Initial code. integer :: I1 2003-04-25 AMACH  Krogh   Added comment for the Absoft compiler.\n2001-03-13 AMACH  Krogh   Fixed HOW for case when not set in m77job.\n1997-04-16 AMACH  Krogh   Remove blank lines -- was confusing m77con\n1996-03-30 AMACH  Krogh   Added external statement.\n1994-10-26 AMACH  Krogh   Changes to use M77CON\n1994-09-23 AMACH  Snyder  Add VAX G parameters\n1994-06-21 AMACH  Snyder  Compute only round-off and u-flow at first\n1994-05-25 AMACH  Snyder  Added an option to compute at run time.\n1992-04-07 AMACH  Oken    Removed &#94;Z at EOF (error found by VAX comp\n1992-02-20 AMACH  Snyder  Added Cray-J90 stuff, q.v.\n1990-06-11 AMACH  Snyder  Added Apollo DN-10000 stuff, q.v.\n1990-12-14 AMACH  Lawson  Changed to eliminate ENTRY statements.\n1990-08-21 AMACH  Krogh   No test was getting done for bad machine.\n1990-02-28 AMACH  Krogh   Correct missing DOUBLE PRECISION AMSUB1\n1989-08-14 AMACH  Krogh   Parameterized everything -- Massive change\n1989-03-30 AMACH  Snyder  Correct missing \"/\" line 921\n1989-01-30 AMACH  Snyder  Incorporate more constants from NETLIB.\n1988-05-19 AMACH  Lawson  Initial code. real :: R1 double precision :: D1","tags":"","url":"proc/amach.html"},{"title":"AMTEST – Yambo","text":"subroutine AMTEST(TEST, D6) Arguments Type Intent Optional Attributes Name double precision :: TEST double precision :: D6","tags":"","url":"proc/amtest.html"},{"title":"fix_QP_DBs – Yambo","text":"subroutine fix_QP_DBs(k, k_save, kpoints_map) Uses R_lattice stderr pars com QP_m IO_m descriptors vec_operate electrons IO_int Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: k_save integer, intent(in) :: kpoints_map (2,k%nibz)","tags":"","url":"proc/fix_qp_dbs.html"},{"title":"NL_exc_driver – Yambo","text":"subroutine NL_exc_driver(en, k) Uses R_lattice electrons Arguments Type Intent Optional Attributes Name type( levels ) :: en type( bz_samp ) :: k","tags":"","url":"proc/nl_exc_driver.html"},{"title":"DESC_write – Yambo","text":"subroutine DESC_write(dest, prefix, desc, d_range, skip_patt) Uses pars com descriptors Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: dest character(len=*), intent(in) :: prefix type( IO_desc ), intent(in) :: desc integer, intent(in), optional :: d_range (2) character(len=*), intent(in), optional :: skip_patt","tags":"","url":"proc/desc_write.html"},{"title":"DERV1 – Yambo","text":"subroutine DERV1(LABEL, VALUE, FLAG) Arguments Type Intent Optional Attributes Name character(len=*) :: LABEL double precision :: VALUE character(len=1) :: FLAG Common Blocks ERFIN (subroutine) SERV1 (subroutine) ERMOR (subroutine) ERMSG (subroutine) \">\n           common /M77ERR/ 1994-10-20 DERV1  Krogh  Changes to use M77CON\n1994-04-20 DERV1  CLL Edited to make DP & SP files similar.\n1985-09-20 DERV1  Lawson  Initial code. Type Attributes Name Initial integer :: IDELTA integer :: IALPHA","tags":"","url":"proc/derv1.html"},{"title":"electrons_spin_factors – Yambo","text":"subroutine electrons_spin_factors(kpts, bands, spin_factors) Uses parallel_m parallel_int wave_func wrapper_omp pars LIVE_t YPPm FFT_m electrons interfaces Arguments Type Intent Optional Attributes Name integer, intent(in) :: kpts (2) integer, intent(in) :: bands (2) real(kind=SP), intent(out) :: spin_factors (bands(1):bands(2),kpts(1):kpts(2),n_spinor)","tags":"","url":"proc/electrons_spin_factors.html"},{"title":"SLK_communicators – Yambo","text":"subroutine SLK_communicators(INTRA_world, INTER_world, N) Uses parallel_m Arguments Type Intent Optional Attributes Name type( yMPI_comm ) :: INTRA_world type( yMPI_comm ) :: INTER_world integer :: N","tags":"","url":"proc/slk_communicators.html"},{"title":"K_multiply_by_V_transpose – Yambo","text":"subroutine K_multiply_by_V_transpose(Vi, Vo, iter_par, iq) Uses parallel_m pars wrapper IO_m BS_solvers BS parallel_int IO_int Arguments Type Intent Optional Attributes Name type( Haydock_vector ) :: Vi (BS_nT_grps) type( Haydock_vector ) :: Vo (BS_nT_grps) integer, intent(in) :: iter_par integer, intent(in) :: iq","tags":"","url":"proc/k_multiply_by_v_transpose.html"},{"title":"f_build_ext – Yambo","text":"subroutine f_build_ext(E, Ef) Uses functions pars electrons D_lattice Arguments Type Intent Optional Attributes Name type( levels ), intent(inout) :: E real(kind=SP), intent(in) :: Ef","tags":"","url":"proc/f_build_ext.html"},{"title":"TDDFT_do_X_W_typs – Yambo","text":"subroutine TDDFT_do_X_W_typs(iq, X, wv) Uses stderr X_m frequency IO_m BS_solvers drivers TDDFT BS IO_int Arguments Type Intent Optional Attributes Name integer :: iq type( X_t ) :: X type( w_samp ) :: wv","tags":"","url":"proc/tddft_do_x_w_typs.html"},{"title":"RT_interpolation_doit_and_transfer – Yambo","text":"subroutine RT_interpolation_doit_and_transfer(OBJ, K, E, nb, l_B, N_carriers, df_Max, dE_Max) Uses RT_control R_lattice interpolate pars electrons real_time Arguments Type Intent Optional Attributes Name character(len=*) :: OBJ type( bz_samp ), intent(inout) :: K type( levels ), intent(inout) :: E integer :: nb (2) logical, intent(in) :: l_B real(kind=SP) :: N_carriers (2) real(kind=SP) :: df_Max real(kind=SP) :: dE_Max","tags":"","url":"proc/rt_interpolation_doit_and_transfer.html"},{"title":"QP_apply_QP – Yambo","text":"subroutine QP_apply_QP(i_ACTION, bands, en, k, qp) Uses R_lattice pars QP_m QP_CTL_m electrons Arguments Type Intent Optional Attributes Name integer :: i_ACTION integer :: bands (2) type( levels ) :: en type( bz_samp ) :: k type( QP_t ) :: qp","tags":"","url":"proc/qp_apply_qp.html"},{"title":"QP_fit_report – Yambo","text":"subroutine QP_fit_report(i_ACTION, bands, en, k, qp) Uses R_lattice stderr pars com QP_m QP_CTL_m UNITS vec_operate electrons interfaces Arguments Type Intent Optional Attributes Name integer :: i_ACTION integer :: bands (2) type( levels ) :: en type( bz_samp ) :: k type( QP_t ) :: qp","tags":"","url":"proc/qp_fit_report.html"},{"title":"DQCHEB – Yambo","text":"subroutine DQCHEB(X, FVAL, CHEB12, CHEB24) BEGIN PROLOGUE  DQCHEB SUBSIDIARY PURPOSE  This routine computes the CHEBYSHEV series expansion\n            of degrees 12 and 24 of a function using A\n            FAST FOURIER TRANSFORM METHOD\n            F(X) = SUM(K=1,..,13) (CHEB12(K) T(K-1,X)),\n            F(X) = SUM(K=1,..,25) (CHEB24(K) T(K-1,X)),\n            Where T(K,X) is the CHEBYSHEV POLYNOMIAL OF DEGREE K. LIBRARY   SLATEC TYPE      DOUBLE PRECISION (QCHEB-S, DQCHEB-D) KEYWORDS  CHEBYSHEV SERIES EXPANSION, FAST FOURIER TRANSFORM AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Chebyshev Series Expansion\n    Standard Fortran Subroutine\n    Double precision version\n\n    PARAMETERS\n      ON ENTRY\n       X      - Double precision\n                Vector of dimension 11 containing the\n                Values COS(K*PI/24), K = 1, ..., 11\n\n       FVAL   - Double precision\n                Vector of dimension 25 containing the\n                function values at the points\n                (B+A+(B-A)*COS(K*PI/24))/2, K = 0, ...,24,\n                where (A,B) is the approximation interval.\n                FVAL(1) and FVAL(25) are divided by two\n                (these values are destroyed at output).\n\n      ON RETURN\n       CHEB12 - Double precision\n                Vector of dimension 13 containing the\n                CHEBYSHEV coefficients for degree 12\n\n       CHEB24 - Double precision\n                Vector of dimension 25 containing the\n                CHEBYSHEV Coefficients for degree 24 SEE ALSO  DQC25C, DQC25F, DQC25S ROUTINES CALLED  (NONE) REVISION HISTORY  (YYMMDD)\n   810101  DATE WRITTEN\n   830518  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900328  Added TYPE section.  (WRB) END PROLOGUE  DQCHEB **FIRST EXECUTABLE STATEMENT  DQCHEB Arguments Type Intent Optional Attributes Name double precision, dimension(11) :: X double precision, dimension(25) :: FVAL double precision, dimension(13) :: CHEB12 double precision, dimension(25) :: CHEB24","tags":"","url":"proc/dqcheb.html"},{"title":"DIPOLE_shifted_grids – Yambo","text":"subroutine DIPOLE_shifted_grids(Xen, Xk, Dip) Uses parallel_m R_lattice wave_func stderr pars com DIPOLES X_m UNITS vec_operate timing_m drivers LIVE_t electrons interfaces wrapper Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: Xen type( bz_samp ), intent(in) :: Xk type( DIPOLE_t ), intent(inout) :: Dip","tags":"","url":"proc/dipole_shifted_grids.html"},{"title":"qe_pseudo_init – Yambo","text":"subroutine qe_pseudo_init() Uses control_flags gvecw noncollin_module io_files pars ions_base pw_data lsda_mod wvfct matrix_inversion spin_orb gvect cell_base electrons Arguments None","tags":"","url":"proc/qe_pseudo_init.html"},{"title":"plot_and_project_1D – Yambo","text":"subroutine plot_and_project_1D(V, direction) Uses R_lattice wave_func D_lattice pars com LIVE_t YPPm vec_operate FFT_m Arguments Type Intent Optional Attributes Name real(kind=SP) :: V (fft_size,3) real(kind=SP) :: direction (3)","tags":"","url":"proc/plot_and_project_1d.html"},{"title":"electrons_angular_momentum – Yambo","text":"subroutine electrons_angular_momentum(nkpt_angular, nband_angular) Uses wave_func D_lattice pars com LIVE_t SC magnetic UNITS FFT_m electrons interfaces wrapper Arguments Type Intent Optional Attributes Name integer :: nkpt_angular (2) integer :: nband_angular (2)","tags":"","url":"proc/electrons_angular_momentum.html"},{"title":"io_bulk – Yambo","text":"subroutine io_bulk(ID, VAR, VAR_SZ, I0, I1, I2, I3, I4, I5, R0, R1, R2, R3, R4, R5, D0, D1, D2, D3, D4, D5, C0, C1, C2, C3, C4, C5, Z0, Z1, Z2, Z3, Z4, Z5, L0, L1, L2, L3, L4, IPOS) Uses pars com netcdf IO_m iso_c_binding Arguments Type Intent Optional Attributes Name integer :: ID character(len=*), optional :: VAR integer, optional :: VAR_SZ (:) integer, optional :: I0 integer, optional :: I1 (:) integer, optional :: I2 (:,:) integer, optional :: I3 (:,:,:) integer, optional :: I4 (:,:,:,:) integer, optional :: I5 (:,:,:,:,:) real(kind=SP), optional :: R0 real(kind=SP), optional :: R1 (:) real(kind=SP), optional :: R2 (:,:) real(kind=SP), optional :: R3 (:,:,:) real(kind=SP), optional :: R4 (:,:,:,:) real(kind=SP), optional :: R5 (:,:,:,:,:) real(kind=DP), optional :: D0 real(kind=DP), optional :: D1 (:) real(kind=DP), optional :: D2 (:,:) real(kind=DP), optional :: D3 (:,:,:) real(kind=DP), optional :: D4 (:,:,:,:) real(kind=DP), optional :: D5 (:,:,:,:,:) complex(kind=SP), optional, target :: C0 complex(kind=SP), optional, target :: C1 (:) complex(kind=SP), optional, target :: C2 (:,:) complex(kind=SP), optional, target :: C3 (:,:,:) complex(kind=SP), optional, target :: C4 (:,:,:,:) complex(kind=SP), optional, target :: C5 (:,:,:,:,:) complex(kind=DP), optional, target :: Z0 complex(kind=DP), optional, target :: Z1 (:) complex(kind=DP), optional, target :: Z2 (:,:) complex(kind=DP), optional, target :: Z3 (:,:,:) complex(kind=DP), optional, target :: Z4 (:,:,:,:) complex(kind=DP), optional, target :: Z5 (:,:,:,:,:) integer(kind=LP), optional :: L0 integer(kind=LP), optional :: L1 (:) integer(kind=LP), optional :: L2 (:,:) integer(kind=LP), optional :: L3 (:,:,:) integer(kind=LP), optional :: L4 (:,:,:,:) integer, optional :: IPOS (:)","tags":"","url":"proc/io_bulk.html"},{"title":"eval_G_minus_G – Yambo","text":"function eval_G_minus_G(iG, iGo, COMM) Uses parallel_m R_lattice gpu_m pars timing_m vec_operate parallel_int Arguments Type Intent Optional Attributes Name integer :: iG integer :: iGo type( yMPI_comm ), optional :: COMM Return Value integer","tags":"","url":"proc/eval_g_minus_g.html"},{"title":"ypp – Yambo","text":"function ypp(np, pid, lnstr, iinf, iind, iod, icd, ijs, instr, inf, ind, od, com_dir, js) Uses parallel_m R_lattice wave_func stderr D_lattice com IO_m it_tools it_m YPPm drivers parallel_int electrons IO_int Arguments Type Intent Optional Attributes Name integer, intent(in) :: np integer, intent(in) :: pid integer, intent(in) :: lnstr integer, intent(inout) :: iinf integer, intent(in) :: iind integer, intent(in) :: iod integer, intent(in) :: icd integer, intent(in) :: ijs character(len=lnstr), intent(in) :: instr character(len=iinf), intent(in) :: inf character(len=iind), intent(in) :: ind character(len=iod), intent(in) :: od character(len=icd), intent(in) :: com_dir character(len=ijs), intent(in) :: js Return Value integer","tags":"","url":"proc/ypp.html"},{"title":"Apply_W_field – Yambo","text":"subroutine Apply_W_field(A_input, Wk, H_nl_sc) Uses hamiltonian pars UNITS fields Arguments Type Intent Optional Attributes Name type( gauge_field ), intent(in) :: A_input complex(kind=SP), intent(in) :: Wk (3,H_ref_bands(1):H_ref_bands(2),H_ref_bands(1):H_ref_bands(2)) complex(kind=SP), intent(inout) :: H_nl_sc (H_ref_bands(1):H_ref_bands(2),H_ref_bands(1):H_ref_bands(2))","tags":"","url":"proc/apply_w_field.html"},{"title":"DQAGE – Yambo","text":"subroutine DQAGE(F, A, B, EPSABS, EPSREL, KEY, LIMIT, RESULT, ABSERR, NEVAL, IER, ALIST, BLIST, RLIST, ELIST, IORD, LAST) BEGIN PROLOGUE  DQAGE PURPOSE  The routine calculates an approximation result to a given\n            definite integral   I = Integral of F over (A,B),\n            hopefully satisfying following claim for accuracy\n            ABS(I-RESLT).LE.MAX(EPSABS,EPSREL ABS(I)). LIBRARY   SLATEC (QUADPACK) CATEGORY  H2A1A1 TYPE      DOUBLE PRECISION (QAGE-S, DQAGE-D) KEYWORDS  AUTOMATIC INTEGRATOR, GAUSS-KRONROD RULES,\n             GENERAL-PURPOSE, GLOBALLY ADAPTIVE, INTEGRAND EXAMINATOR,\n             QUADPACK, QUADRATURE AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven *DESCRIPTION Computation of a definite integral Standard fortran subroutine Double precision version PARAMETERS ON ENTRY F - Double precision Function subprogram defining the integrand function F ( X ). The actual name for F needs to be declared E X T E R N A L in the driver program . A - Double precision Lower limit of integration B - Double precision Upper limit of integration EPSABS - Double precision Absolute accuracy requested EPSREL - Double precision Relative accuracy requested If EPSABS . LE .0 and EPSREL . LT . MAX ( 50 * REL . MACH . ACC ., 0.5 D - 28 ), the routine will end with IER = 6 . KEY - Integer Key for choice of local integration rule A Gauss - Kronrod pair is used with 7 - 15 points if KEY . LT .2 , 10 - 21 points if KEY = 2 , 15 - 31 points if KEY = 3 , 20 - 41 points if KEY = 4 , 25 - 51 points if KEY = 5 , 30 - 61 points if KEY . GT .5 . LIMIT - Integer Gives an upper bound on the number of subintervals in the partition of ( A , B ), LIMIT . GE .1 . ON RETURN RESULT - Double precision Approximation to the integral ABSERR - Double precision Estimate of the modulus of the absolute error , which should equal or exceed ABS ( I - RESULT ) NEVAL - Integer Number of integrand evaluations IER - Integer IER = 0 Normal and reliable termination of the routine . It is assumed that the requested accuracy has been achieved . IER . GT .0 Abnormal termination of the routine The estimates for result and error are less reliable . It is assumed that the requested accuracy has not been achieved . ERROR MESSAGES IER = 1 Maximum number of subdivisions allowed has been achieved . One can allow more subdivisions by increasing the value of LIMIT . However , if this yields no improvement it is rather advised to analyze the integrand in order to determine the integration difficulties . If the position of a local difficulty can be determined ( e . g . SINGULARITY , DISCONTINUITY within the interval ) one will probably gain from splitting up the interval at this point and calling the integrator on the subranges . If possible , an appropriate special - purpose integrator should be used which is designed for handling the type of difficulty involved . = 2 The occurrence of roundoff error is detected , which prevents the requested tolerance from being achieved . = 3 Extremely bad integrand behaviour occurs at some points of the integration interval . = 6 The input is invalid , because ( EPSABS . LE .0 and EPSREL . LT . MAX ( 50 * REL . MACH . ACC ., 0.5 D - 28 ), RESULT , ABSERR , NEVAL , LAST , RLIST ( 1 ) , ELIST ( 1 ) and IORD ( 1 ) are set to zero . ALIST ( 1 ) and BLIST ( 1 ) are set to A and B respectively . ALIST - Double precision Vector of dimension at least LIMIT , the first LAST elements of which are the left end points of the subintervals in the partition of the given integration range ( A , B ) BLIST - Double precision Vector of dimension at least LIMIT , the first LAST elements of which are the right end points of the subintervals in the partition of the given integration range ( A , B ) RLIST - Double precision Vector of dimension at least LIMIT , the first LAST elements of which are the integral approximations on the subintervals ELIST - Double precision Vector of dimension at least LIMIT , the first LAST elements of which are the moduli of the absolute error estimates on the subintervals IORD - Integer Vector of dimension at least LIMIT , the first K elements of which are pointers to the error estimates over the subintervals , such that ELIST ( IORD ( 1 )), ... , ELIST ( IORD ( K )) form a decreasing sequence , with K = LAST if LAST . LE .( LIMIT / 2 + 2 ), and K = LIMIT + 1 - LAST otherwise LAST - Integer Number of subintervals actually produced in the subdivision process REFERENCES  (NONE) ROUTINES CALLED  D1MACH, DQK15, DQK21, DQK31, DQK41, DQK51, DQK61,\n                    DQPSRT REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890831  Modified array declarations.  (WRB)\n   890831  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB) END PROLOGUE  DQAGE **FIRST EXECUTABLE STATEMENT  DQAGE Arguments Type Intent Optional Attributes Name real :: F double precision :: A double precision :: B double precision :: EPSABS double precision :: EPSREL integer :: KEY integer :: LIMIT double precision :: RESULT double precision :: ABSERR integer :: NEVAL integer :: IER double precision, dimension(*) :: ALIST double precision, dimension(*) :: BLIST double precision, dimension(*) :: RLIST double precision, dimension(*) :: ELIST integer, dimension(*) :: IORD integer :: LAST","tags":"","url":"proc/dqage.html"},{"title":"io_RIM_W – Yambo","text":"function io_RIM_W(ID, mode, Xw) Uses R_lattice pars frequency IO_m IO_int Arguments Type Intent Optional Attributes Name integer :: ID character(len=3) :: mode type( w_samp ) :: Xw Return Value integer","tags":"","url":"proc/io_rim_w.html"},{"title":"MAG_common_build_A – Yambo","text":"subroutine MAG_common_build_A(build) Uses D_lattice pars UNITS magnetic vec_operate FFT_m Arguments Type Intent Optional Attributes Name logical :: build","tags":"","url":"proc/mag_common_build_a.html"},{"title":"DLARAN – Yambo","text":"function DLARAN(ISEED) Arguments Type Intent Optional Attributes Name integer :: ISEED (4) Return Value doubleprecision","tags":"","url":"proc/dlaran.html"},{"title":"eval_Mtot – Yambo","text":"subroutine eval_Mtot(en, k, q) Uses R_lattice parallel_int wave_func pars com FFT_m electrons interfaces Arguments Type Intent Optional Attributes Name type( levels ) :: en type( bz_samp ) :: k type( bz_samp ) :: q","tags":"","url":"proc/eval_mtot.html"},{"title":"k_circuit_driver – Yambo","text":"subroutine k_circuit_driver(PATH, n_points) Uses R_lattice YPP_interfaces D_lattice pars com YPPm electrons interfaces Arguments Type Intent Optional Attributes Name character(len=*) :: PATH integer :: n_points","tags":"","url":"proc/k_circuit_driver.html"},{"title":"OEP_iterative – Yambo","text":"subroutine OEP_iterative(E, k, Voep, Vslt, U, rho) Uses R_lattice wave_func D_lattice stderr pars LIVE_t SC drivers FFT_m electrons Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: E type( bz_samp ), intent(in) :: k real(kind=SP), intent(inout) :: Voep (fft_size) real(kind=SP), intent(in) :: Vslt (fft_size) complex(kind=SP), intent(in) :: U (nkibz,maxval(n_met_bands),fft_size) real(kind=SP), intent(in) :: rho (fft_size)","tags":"","url":"proc/oep_iterative.html"},{"title":"fft_3d – Yambo","text":"subroutine fft_3d(c, n, fft_sign) Uses pars Arguments Type Intent Optional Attributes Name complex(kind=DP) :: c (n(1),n(2),n(3)) integer :: n (3) integer :: fft_sign","tags":"","url":"proc/fft_3d~3.html"},{"title":"MATRIX_init – Yambo","text":"subroutine MATRIX_init(what, M_par, N, Nb) Uses parallel_m pars matrix Arguments Type Intent Optional Attributes Name character(len=*) :: what type( PAR_matrix ) :: M_par integer :: N integer :: Nb","tags":"","url":"proc/matrix_init.html"},{"title":"K_Transitions_setup – Yambo","text":"subroutine K_Transitions_setup(iq, Ken, Xk, Dip, V_bands, C_bands) Uses parallel_m R_lattice stderr pars DIPOLES com BS_solvers BS electrons Arguments Type Intent Optional Attributes Name integer, intent(in) :: iq type( levels ), intent(in) :: Ken type( bz_samp ), intent(in) :: Xk type( DIPOLE_t ), intent(in) :: Dip integer, intent(in) :: V_bands (2) integer, intent(in) :: C_bands (2)","tags":"","url":"proc/k_transitions_setup.html"},{"title":"K_Transitions_dimensions – Yambo","text":"subroutine K_Transitions_dimensions(iq, Ken, Xk, Dip, V_bands, C_bands) Uses R_lattice stderr pars DIPOLES com BS electrons Arguments Type Intent Optional Attributes Name integer, intent(in) :: iq type( levels ), intent(in) :: Ken type( bz_samp ), intent(in) :: Xk type( DIPOLE_t ), intent(in) :