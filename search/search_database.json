k_s_m1 integer, intent(in) :: iq_W_s_mq integer, intent(in) :: ig_W_mq integer, intent(in) :: i_kmq_s_m1 integer, intent(in) :: BS_n_g_W complex(kind=SP), intent(inout) :: O1 (BS_n_g_W) complex(kind=SP), intent(inout) :: O2 (BS_n_g_W) complex(kind=SP), intent(inout) :: O_times_W (BS_n_g_W) Return Value complex(kind=SP)","tags":"","url":"proc/k_correlation_kernel_dir.html"},{"title":"io_BS_Fxc – Yambo","text":"function io_BS_Fxc(iq, FXC_W, ID, X) Uses stderr pars frequency X_m IO_m descriptors BS_solvers UNITS TDDFT BS IO_int Arguments Type Intent Optional Attributes Name integer :: iq type( w_samp ) :: FXC_W integer :: ID type( X_t ), optional :: X Return Value integer","tags":"","url":"proc/io_bs_fxc.html"},{"title":"QED_Radiative_Lifetimes – Yambo","text":"subroutine QED_Radiative_Lifetimes(E, k, q, qp, X, Dip) Uses parallel_m R_lattice functions pars DIPOLES X_m QP_m LIVE_t UNITS timing_m parallel_int electrons Arguments Type Intent Optional Attributes Name type( levels ) :: E type( bz_samp ) :: k type( bz_samp ) :: q type( QP_t ) :: qp type( X_t ) :: X type( DIPOLE_t ) :: Dip","tags":"","url":"proc/qed_radiative_lifetimes.html"},{"title":"K_diagonal – Yambo","text":"subroutine K_diagonal(iq, what) Uses pars parser_m BS_solvers BS parallel_int SLK_m Arguments Type Intent Optional Attributes Name integer, intent(in) :: iq character(len=*) :: what","tags":"","url":"proc/k_diagonal.html"},{"title":"io_BSS_Haydock – Yambo","text":"function io_BSS_Haydock(ID, iq, it, reached_treshold, mode, Af, Bf, Cf, Vnm1, Vn, Vnp1) Uses stderr pars IO_m BS_solvers timing_m BS IO_int Arguments Type Intent Optional Attributes Name integer :: ID integer :: iq integer :: it real(kind=SP) :: reached_treshold character(len=*) :: mode real(kind=SP) :: Af (it) real(kind=SP) :: Bf (it+1) complex(kind=SP) :: Cf (:) complex(kind=SP), pointer :: Vnm1 (:) complex(kind=SP), pointer :: Vn (:) complex(kind=SP), pointer :: Vnp1 (:) Return Value integer","tags":"","url":"proc/io_bss_haydock.html"},{"title":"EXP_step – Yambo","text":"subroutine EXP_step(K_out, V_in, H_in, I_in, nbf, dT) Uses pars nl_optics Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(out) :: K_out (NL_bands(2),nbf) complex(kind=SP), intent(in) :: V_in (NL_bands(2),nbf) complex(kind=SP), intent(in) :: H_in (NL_bands(1):NL_bands(2),NL_bands(1):NL_bands(2)) complex(kind=SP), intent(in) :: I_in (NL_bands(1):NL_bands(2),NL_bands(1):NL_bands(2),nbf) integer, intent(in) :: nbf real(kind=SP), intent(in) :: dT","tags":"","url":"proc/exp_step.html"},{"title":"eval_Gradient – Yambo","text":"subroutine eval_Gradient(f, f_gradient, spinor_size, f_type) Uses R_lattice gpu_m devxlib wave_func pars timing_m iso_c_binding FFT_m Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: f (fft_size,spinor_size) complex(kind=SP), intent(out) :: f_gradient (fft_size,spinor_size,3) integer, intent(in) :: spinor_size character(len=*), intent(in) :: f_type","tags":"","url":"proc/eval_gradient~3.html"},{"title":"SERIAL_HERMITIAN_diagonalization – Yambo","text":"subroutine SERIAL_HERMITIAN_diagonalization(n, M, E) Uses linear_algebra pars timing_m drivers Arguments Type Intent Optional Attributes Name integer :: n complex(kind=SP) :: M (n,n) real(kind=SP) :: E (n)","tags":"","url":"proc/serial_hermitian_diagonalization.html"},{"title":"io_MPA – Yambo","text":"function io_MPA(X, Xw, ID) Uses mpa_m stderr pars frequency X_m IO_m timing_m IO_int Arguments Type Intent Optional Attributes Name type( X_t ) :: X type( w_samp ) :: Xw integer :: ID Return Value integer","tags":"","url":"proc/io_mpa.html"},{"title":"variables_MPA – Yambo","text":"function variables_MPA(ID, local_desc, X) Uses pars X_m IO_m descriptors IO_int Arguments Type Intent Optional Attributes Name integer :: ID type( IO_desc ) :: local_desc type( X_t ) :: X Return Value integer","tags":"","url":"proc/variables_mpa.html"},{"title":"CSEVL – Yambo","text":"function CSEVL(X, CS, N) BEGIN PROLOGUE  CSEVL PURPOSE  Evaluate a Chebyshev series. LIBRARY   SLATEC (FNLIB) CATEGORY  C3A2 TYPE      SINGLE PRECISION (CSEVL-S, DCSEVL-D) KEYWORDS  CHEBYSHEV SERIES, FNLIB, SPECIAL FUNCTIONS AUTHOR  Fullerton, W., (LANL) DESCRIPTION Evaluate the N-term Chebyshev series CS at X.  Adapted from\n  a method presented in the paper by Broucke referenced below. Input Arguments -- X    value at which the series is to be evaluated.\n  CS   array of N terms of a Chebyshev series.  In evaluating\n       CS, only half the first coefficient is summed.\n  N    number of terms in array CS. REFERENCES  R. Broucke, Ten subroutines for the manipulation of\n                 Chebyshev series, Algorithm 446, Communications of\n                 the A.C.M. 16, (1973) pp. 254-256.\n               L. Fox and I. B. Parker, Chebyshev Polynomials in\n                 Numerical Analysis, Oxford University Press, 1968,\n                 page 56. ROUTINES CALLED  R1MACH, XERMSG REVISION HISTORY  (YYMMDD)\n   770401  DATE WRITTEN\n   890831  Modified array declarations.  (WRB)\n   890831  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   900329  Prologued revised extensively and code rewritten to allow\n           X to be slightly outside interval (-1,+1).  (WRB)\n   920501  Reformatted the REFERENCES section.  (WRB) END PROLOGUE  CSEVL\n**FIRST EXECUTABLE STATEMENT  CSEVL Arguments Type Intent Optional Attributes Name real :: X real :: CS (*) integer :: N Return Value real","tags":"","url":"proc/csevl.html"},{"title":"PLASMA_tables_and_dimensions – Yambo","text":"function PLASMA_tables_and_dimensions(iqbz, E, k, q, poles, N) Uses parallel_m plasma R_lattice pars collision_ext frequency electrons Arguments Type Intent Optional Attributes Name integer :: iqbz type( levels ) :: E type( bz_samp ) :: k type( bz_samp ) :: q real(kind=SP) :: poles (N) integer :: N Return Value integer","tags":"","url":"proc/plasma_tables_and_dimensions.html"},{"title":"io_Vnl – Yambo","text":"function io_Vnl(Dip, Xen, ID) Uses R_lattice pseudo matrix_operate pars DIPOLES IO_m global_XC electrons IO_int Arguments Type Intent Optional Attributes Name type( DIPOLE_t ) :: Dip type( levels ) :: Xen integer :: ID Return Value integer","tags":"","url":"proc/io_vnl.html"},{"title":"INTERPOLATION_BZ – Yambo","text":"subroutine INTERPOLATION_BZ(K, NK, ID, R1D, R2D, C1D, C2D, E) Uses R_lattice interpolate pars timing_m electrons Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: K integer, intent(in) :: NK integer, intent(in) :: ID real(kind=SP), intent(out), optional :: R1D (:,:) real(kind=SP), intent(out), optional :: R2D (:,:,:) complex(kind=SP), intent(out), optional :: C1D (:,:) complex(kind=SP), intent(out), optional :: C2D (:,:,:) type( levels ), intent(inout), optional :: E","tags":"","url":"proc/interpolation_bz.html"},{"title":"TIMING_overview – Yambo","text":"subroutine TIMING_overview(list, main_name) Uses parallel_m parallel_int stderr pars com timing_m vec_operate LIVE_t Arguments Type Intent Optional Attributes Name type( clock_list ), intent(in) :: list character(len=*), intent(in) :: main_name","tags":"","url":"proc/timing_overview.html"},{"title":"PARSER_dump_the_additional_lines – Yambo","text":"subroutine PARSER_dump_the_additional_lines(ou) Uses parallel_m it_m com drivers Arguments Type Intent Optional Attributes Name integer :: ou","tags":"","url":"proc/parser_dump_the_additional_lines.html"},{"title":"RT_carriers_object – Yambo","text":"subroutine RT_carriers_object(RT, E, K, DB_id, WHAT) Uses RT_control hamiltonian R_lattice RT_occupations pars RT_operations IO_m RT_lifetimes drivers iso_c_binding electrons real_time IO_int Arguments Type Intent Optional Attributes Name type( RT_t ), intent(inout), target :: RT type( levels ), intent(inout), optional :: E type( bz_samp ), intent(in), optional :: K integer, intent(in), optional :: DB_id character(len=*), intent(in), optional :: WHAT","tags":"","url":"proc/rt_carriers_object.html"},{"title":"Vgrad_real_space_to_H – Yambo","text":"subroutine Vgrad_real_space_to_H(ik, H, WF, V_grad) Uses wave_func D_lattice matrix_operate pars timing_m hamiltonian FFT_m electrons wrapper Arguments Type Intent Optional Attributes Name integer, intent(in) :: ik complex(kind=SP), intent(inout) :: H (H_ref_bands(1):H_ref_bands(2),H_ref_bands(1):H_ref_bands(2)) type( WAVEs ), intent(in) :: WF complex(kind=SP), intent(in) :: V_grad (fft_size,3)","tags":"","url":"proc/vgrad_real_space_to_h.html"},{"title":"addusdens – Yambo","text":"subroutine addusdens(ngm, nspin_mag, ldrho, rhog) Uses kinds Arguments Type Intent Optional Attributes Name integer, intent(in) :: ngm integer, intent(in) :: nspin_mag integer, intent(in) :: ldrho complex(kind=DP), intent(inout) :: rhog (ldrho,nspin_mag)","tags":"","url":"proc/addusdens.html"},{"title":"addusdens_g – Yambo","text":"subroutine addusdens_g(ngm, nspin_mag, ldrho, rho) Uses ions_base kinds uspp_param gvect uspp Arguments Type Intent Optional Attributes Name integer, intent(in) :: ngm integer, intent(in) :: nspin_mag integer, intent(in) :: ldrho complex(kind=DP), intent(inout) :: rho (ldrho,nspin_mag)","tags":"","url":"proc/addusdens_g.html"},{"title":"SC_precondition – Yambo","text":"subroutine SC_precondition(delta_rho) Uses R_lattice wave_func D_lattice pars FFT_m electrons Arguments Type Intent Optional Attributes Name real :: delta_rho (fft_size)","tags":"","url":"proc/sc_precondition.html"},{"title":"DQK51 – Yambo","text":"subroutine DQK51(F, A, B, RESULT, ABSERR, RESABS, RESASC) BEGIN PROLOGUE  DQK51 PURPOSE  To compute I = Integral of F over (A,B) with error\n                           estimate\n                       J = Integral of ABS(F) over (A,B) LIBRARY   SLATEC (QUADPACK) CATEGORY  H2A1A2 TYPE      DOUBLE PRECISION (QK51-S, DQK51-D) KEYWORDS  51-POINT GAUSS-KRONROD RULES, QUADPACK, QUADRATURE AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Integration rules Standard fortran subroutine Double precision version PARAMETERS ON ENTRY F - Double precision Function subroutine defining the integrand function F ( X ) . The actual name for F needs to be declared E X T E R N A L in the calling program . A - Double precision Lower limit of integration B - Double precision Upper limit of integration ON RETURN RESULT - Double precision Approximation to the integral I RESULT is computed by applying the 51 - point Kronrod rule ( RESK ) obtained by optimal addition of abscissae to the 25 - point Gauss rule ( RESG ) . ABSERR - Double precision Estimate of the modulus of the absolute error , which should not exceed ABS ( I - RESULT ) RESABS - Double precision Approximation to the integral J RESASC - Double precision Approximation to the integral of ABS ( F - I / ( B - A )) over ( A , B ) REFERENCES  (NONE) ROUTINES CALLED  D1MACH REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   910819  Added WGK(26) to code.  (WRB) END PROLOGUE  DQK51 **FIRST EXECUTABLE STATEMENT  DQK51 Arguments Type Intent Optional Attributes Name real :: F double precision :: A double precision :: B double precision :: RESULT double precision :: ABSERR double precision :: RESABS double precision :: RESASC","tags":"","url":"proc/dqk51.html"},{"title":"plot_interpolated_values – Yambo","text":"subroutine plot_interpolated_values(Xk, Xen, Ef, LOCAL_k, IDs, dims, nquantities, nfiles, basename, int_kind, i_T) Uses R_lattice interpolate stderr pars com UNITS vec_operate YPPm electrons Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: Xk type( levels ), intent(in) :: Xen real(kind=SP), intent(in) :: Ef type( bz_samp ), intent(in) :: LOCAL_k integer, intent(in) :: IDs (nquantities) integer, intent(in) :: dims (2) integer, intent(in) :: nquantities integer, intent(in) :: nfiles (nquantities) character(len=*), intent(in) :: basename character(len=*), intent(in) :: int_kind integer, intent(in) :: i_T","tags":"","url":"proc/plot_interpolated_values.html"},{"title":"Eval_Efermi_DbGd – Yambo","text":"function Eval_Efermi_DbGd(k, q, en) Uses R_lattice ELPH interpolate pars com UNITS electrons interfaces Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: q type( levels ) :: en Return Value real(kind=SP)","tags":"","url":"proc/eval_efermi_dbgd.html"},{"title":"DQK15 – Yambo","text":"subroutine DQK15(F, A, B, RESULT, ABSERR, RESABS, RESASC) BEGIN PROLOGUE  DQK15 PURPOSE  To compute I = Integral of F over (A,B), with error\n                           estimate\n                       J = integral of ABS(F) over (A,B) LIBRARY   SLATEC (QUADPACK) CATEGORY  H2A1A2 TYPE      DOUBLE PRECISION (QK15-S, DQK15-D) KEYWORDS  15-POINT GAUSS-KRONROD RULES, QUADPACK, QUADRATURE AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Integration rules Standard fortran subroutine Double precision version PARAMETERS ON ENTRY F - Double precision Function subprogram defining the integrand FUNCTION F ( X ) . The actual name for F needs to be Declared E X T E R N A L in the calling program . A - Double precision Lower limit of integration B - Double precision Upper limit of integration ON RETURN RESULT - Double precision Approximation to the integral I Result is computed by applying the 15 - POINT KRONROD RULE ( RESK ) obtained by optimal addition of abscissae to the 7 - POINT GAUSS RULE ( RESG ) . ABSERR - Double precision Estimate of the modulus of the absolute error , which should not exceed ABS ( I - RESULT ) RESABS - Double precision Approximation to the integral J RESASC - Double precision Approximation to the integral of ABS ( F - I / ( B - A )) over ( A , B ) REFERENCES  (NONE) ROUTINES CALLED  D1MACH REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB) END PROLOGUE  DQK15 **FIRST EXECUTABLE STATEMENT  DQK15 Arguments Type Intent Optional Attributes Name real :: F double precision :: A double precision :: B double precision :: RESULT double precision :: ABSERR double precision :: RESABS double precision :: RESASC","tags":"","url":"proc/dqk15.html"},{"title":"POLARIZATION_output – Yambo","text":"subroutine POLARIZATION_output(Xen, Xk, Dip) Uses R_lattice D_lattice stderr pars com DIPOLES UNITS vec_operate electrons Arguments Type Intent Optional Attributes Name type( levels ) :: Xen type( bz_samp ) :: Xk type( DIPOLE_t ) :: Dip","tags":"","url":"proc/polarization_output.html"},{"title":"INTERPOLATION_driver_end – Yambo","text":"subroutine INTERPOLATION_driver_end(ID) Uses interpolate_tools interpolate Arguments Type Intent Optional Attributes Name integer, intent(in) :: ID","tags":"","url":"proc/interpolation_driver_end.html"},{"title":"G2G – Yambo","text":"function G2G(ng2close) Uses R_lattice Arguments Type Intent Optional Attributes Name integer, intent(in) :: ng2close Return Value integer","tags":"","url":"proc/g2g.html"},{"title":"E2G – Yambo","text":"function E2G(Energy) Uses pars R_lattice Arguments Type Intent Optional Attributes Name real(kind=SP), intent(in) :: Energy Return Value integer","tags":"","url":"proc/e2g.html"},{"title":"G2E – Yambo","text":"function G2E(ng2close) Uses pars R_lattice Arguments Type Intent Optional Attributes Name integer, intent(in) :: ng2close Return Value real(kind=SP)","tags":"","url":"proc/g2e.html"},{"title":"PARSER_close_G – Yambo","text":"subroutine PARSER_close_G(ng, what) Uses pars R_lattice UNITS Arguments Type Intent Optional Attributes Name integer :: ng character(len=*) :: what","tags":"","url":"proc/parser_close_g.html"},{"title":"cutoff_box – Yambo","text":"subroutine cutoff_box(q, is_cut) Uses parallel_m R_lattice wave_func D_lattice pars openmp LIVE_t vec_operate zeros parallel_int Arguments Type Intent Optional Attributes Name type( bz_samp ) :: q logical :: is_cut (3)","tags":"","url":"proc/cutoff_box.html"},{"title":"K_inversion_Lo – Yambo","text":"subroutine K_inversion_Lo(iq, W, E, k, Lo_dim, Lo_n_loop, Lo) Uses parallel_m R_lattice pars frequency X_m PHOTOLUM LIVE_t BS_solvers BS parallel_int electrons Arguments Type Intent Optional Attributes Name integer, intent(in) :: iq type( w_samp ), intent(inout) :: W type( levels ), intent(in) :: E type( bz_samp ), intent(in) :: k integer, intent(in) :: Lo_dim integer, intent(in) :: Lo_n_loop complex(kind=SP), intent(out) :: Lo (BS_H_dim,W%n_freqs,Lo_dim)","tags":"","url":"proc/k_inversion_lo.html"},{"title":"MEM_global_mesg – Yambo","text":"subroutine MEM_global_mesg(what, xkind, HOST_SIZE) Uses parallel_m stderr pars UNITS LIVE_t Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: what integer, intent(in) :: xkind integer(kind=IPL), intent(in) :: HOST_SIZE (:)","tags":"","url":"proc/mem_global_mesg.html"},{"title":"PARALLEL_build_up_child_INTER_chains – Yambo","text":"subroutine PARALLEL_build_up_child_INTER_chains(i_child, COMM_child, i_father) Arguments Type Intent Optional Attributes Name integer :: i_child real :: COMM_child integer :: i_father","tags":"","url":"proc/parallel_build_up_child_inter_chains.html"},{"title":"electrons_WFs – Yambo","text":"subroutine electrons_WFs(Xen) Uses wave_func stderr pars com QP_m YPPm FFT_m electrons Arguments Type Intent Optional Attributes Name type( levels ) :: Xen","tags":"","url":"proc/electrons_wfs.html"},{"title":"COLLISIONS_eval – Yambo","text":"subroutine COLLISIONS_eval(E, X, k, Xk, q, Xw) Uses parallel_m plasma R_lattice wave_func D_lattice collision_ext X_m frequency IO_m global_XC timing_m drivers hamiltonian parallel_int electrons interfaces IO_int Arguments Type Intent Optional Attributes Name type( levels ) :: E type( X_t ) :: X (4) type( bz_samp ) :: k type( bz_samp ) :: Xk type( bz_samp ) :: q type( w_samp ) :: Xw (2)","tags":"","url":"proc/collisions_eval.html"},{"title":"FREQUENCIES_reset – Yambo","text":"subroutine FREQUENCIES_reset(Xw, what) Uses X_m frequency Arguments Type Intent Optional Attributes Name type( w_samp ) :: Xw character(len=*) :: what","tags":"","url":"proc/frequencies_reset.html"},{"title":"DQAWO – Yambo","text":"subroutine DQAWO(F, A, B, OMEGA, INTEGR, EPSABS, EPSREL, RESULT, ABSERR, NEVAL, IER, LENIW, MAXP1, LENW, LAST, IWORK, WORK) BEGIN PROLOGUE  DQAWO PURPOSE  Calculate an approximation to a given definite integral\n            I= Integral of F(X) W(X) over (A,B), where\n                   W(X) = COS(OMEGA X)\n               or  W(X) = SIN(OMEGA X),\n            hopefully satisfying the following claim for accuracy\n                ABS(I-RESULT).LE.MAX(EPSABS,EPSREL ABS(I)). LIBRARY   SLATEC (QUADPACK) CATEGORY  H2A2A1 TYPE      DOUBLE PRECISION (QAWO-S, DQAWO-D) KEYWORDS  AUTOMATIC INTEGRATOR, CLENSHAW-CURTIS METHOD,\n             EXTRAPOLATION, GLOBALLY ADAPTIVE,\n             INTEGRAND WITH OSCILLATORY COS OR SIN FACTOR, QUADPACK,\n             QUADRATURE, SPECIAL-PURPOSE AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Computation of oscillatory integrals Standard fortran subroutine Double precision version PARAMETERS ON ENTRY F - Double precision Function subprogram defining the function F ( X ). The actual name for F needs to be declared E X T E R N A L in the driver program . A - Double precision Lower limit of integration B - Double precision Upper limit of integration OMEGA - Double precision Parameter in the integrand weight function INTEGR - Integer Indicates which of the weight functions is used INTEGR = 1 W ( X ) = COS ( OMEGA * X ) INTEGR = 2 W ( X ) = SIN ( OMEGA * X ) If INTEGR . NE .1 . AND . INTEGR . NE .2 , the routine will end with IER = 6 . EPSABS - Double precision Absolute accuracy requested EPSREL - Double precision Relative accuracy requested If EPSABS . LE .0 and EPSREL . LT . MAX ( 50 * REL . MACH . ACC ., 0.5 D - 28 ), the routine will end with IER = 6 . ON RETURN RESULT - Double precision Approximation to the integral ABSERR - Double precision Estimate of the modulus of the absolute error , which should equal or exceed ABS ( I - RESULT ) NEVAL - Integer Number of integrand evaluations IER - Integer IER = 0 Normal and reliable termination of the routine . It is assumed that the requested accuracy has been achieved . - IER . GT .0 Abnormal termination of the routine . The estimates for integral and error are less reliable . It is assumed that the requested accuracy has not been achieved . ERROR MESSAGES IER = 1 Maximum number of subdivisions allowed has been achieved (= LENIW / 2 ). One can allow more subdivisions by increasing the value of LENIW ( and taking the according dimension adjustments into account ). However , if this yields no improvement it is advised to analyze the integrand in order to determine the integration difficulties . If the position of a local difficulty can be determined ( e . g . SINGULARITY , DISCONTINUITY within the interval ) one will probably gain from splitting up the interval at this point and calling the integrator on the subranges . If possible , an appropriate special - purpose integrator should be used which is designed for handling the type of difficulty involved . = 2 The occurrence of roundoff error is detected , which prevents the requested tolerance from being achieved . The error may be under - estimated . = 3 Extremely bad integrand behaviour occurs at some interior points of the integration interval . = 4 The algorithm does not converge . Roundoff error is detected in the extrapolation table . It is presumed that the requested tolerance cannot be achieved due to roundoff in the extrapolation table , and that the returned result is the best which can be obtained . = 5 The integral is probably divergent , or slowly convergent . It must be noted that divergence can occur with any other value of IER . = 6 The input is invalid , because ( EPSABS . LE .0 and EPSREL . LT . MAX ( 50 * REL . MACH . ACC ., 0.5 D - 28 )) or ( INTEGR . NE .1 AND INTEGR . NE .2 ), or LENIW . LT .2 OR MAXP1 . LT .1 or LENW . LT . LENIW * 2 + MAXP1 * 25 . RESULT , ABSERR , NEVAL , LAST are set to zero . Except when LENIW , MAXP1 or LENW are invalid , WORK ( LIMIT * 2 + 1 ), WORK ( LIMIT * 3 + 1 ), IWORK ( 1 ), IWORK ( LIMIT + 1 ) are set to zero , WORK ( 1 ) is set to A and WORK ( LIMIT + 1 ) to B . DIMENSIONING PARAMETERS LENIW - Integer Dimensioning parameter for IWORK . LENIW / 2 equals the maximum number of subintervals allowed in the partition of the given integration interval ( A , B ), LENIW . GE .2 . If LENIW . LT .2 , the routine will end with IER = 6 . MAXP1 - Integer Gives an upper bound on the number of Chebyshev moments which can be stored , i . e . for the intervals of lengths ABS ( B - A ) * 2 ** ( - L ), L = 0 , 1 , ... , MAXP1 - 2 , MAXP1 . GE .1 If MAXP1 . LT .1 , the routine will end with IER = 6 . LENW - Integer Dimensioning parameter for WORK LENW must be at least LENIW * 2 + MAXP1 * 25 . If LENW . LT .( LENIW * 2 + MAXP1 * 25 ), the routine will end with IER = 6 . LAST - Integer On return , LAST equals the number of subintervals produced in the subdivision process , which determines the number of significant elements actually in the WORK ARRAYS . WORK ARRAYS IWORK - Integer Vector of dimension at least LENIW on return , the first K elements of which contain pointers to the error estimates over the subintervals , such that WORK ( LIMIT * 3 + IWORK ( 1 )), .. WORK ( LIMIT * 3 + IWORK ( K )) form a decreasing sequence , with LIMIT = LENW / 2 , and K = LAST if LAST . LE .( LIMIT / 2 + 2 ), and K = LIMIT + 1 - LAST otherwise . Furthermore , IWORK ( LIMIT + 1 ), ... , IWORK ( LIMIT + LAST ) indicate the subdivision levels of the subintervals , such that IWORK ( LIMIT + I ) = L means that the subinterval numbered I is of length ABS ( B - A ) * 2 ** ( 1 - L ). WORK - Double precision Vector of dimension at least LENW On return WORK ( 1 ), ... , WORK ( LAST ) contain the left end points of the subintervals in the partition of ( A , B ), WORK ( LIMIT + 1 ), ... , WORK ( LIMIT + LAST ) contain the right end points , WORK ( LIMIT * 2 + 1 ), ... , WORK ( LIMIT * 2 + LAST ) contain the integral approximations over the subintervals , WORK ( LIMIT * 3 + 1 ), ... , WORK ( LIMIT * 3 + LAST ) contain the error estimates . WORK ( LIMIT * 4 + 1 ), ... , WORK ( LIMIT * 4 + MAXP1 * 25 ) Provide space for storing the Chebyshev moments . Note that LIMIT = LENW / 2 . REFERENCES  (NONE) ROUTINES CALLED  DQAWOE, XERMSG REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890831  Modified array declarations.  (WRB)\n   890831  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ) END PROLOGUE  DQAWO **FIRST EXECUTABLE STATEMENT  DQAWO Arguments Type Intent Optional Attributes Name real :: F double precision :: A double precision :: B double precision :: OMEGA integer :: INTEGR double precision :: EPSABS double precision :: EPSREL double precision :: RESULT double precision :: ABSERR integer :: NEVAL integer :: IER integer :: LENIW integer :: MAXP1 integer :: LENW integer :: LAST integer, dimension(*) :: IWORK double precision, dimension(*) :: WORK","tags":"","url":"proc/dqawo.html"},{"title":"Lorentzian_FT – Yambo","text":"function Lorentzian_FT(W, pole, ordering) Uses pars Arguments Type Intent Optional Attributes Name complex(kind=SP) :: W complex(kind=SP) :: pole character(len=*) :: ordering Return Value complex(kind=SP)","tags":"","url":"proc/lorentzian_ft.html"},{"title":"crystal_lattice – Yambo","text":"subroutine crystal_lattice() Uses matrix_operate pars vec_operate D_lattice Arguments None","tags":"","url":"proc/crystal_lattice.html"},{"title":"MATRIX_transpose – Yambo","text":"subroutine MATRIX_transpose(operation, M_in, M_out) Uses matrix interfaces Arguments Type Intent Optional Attributes Name character(len=*) :: operation type( PAR_matrix ), optional :: M_in type( PAR_matrix ) :: M_out","tags":"","url":"proc/matrix_transpose.html"},{"title":"RT_ypp_driver – Yambo","text":"subroutine RT_ypp_driver(en, k, q) Uses parallel_m R_lattice interpolate parser_m YPP_real_time YPPm electrons Arguments Type Intent Optional Attributes Name type( levels ) :: en type( bz_samp ) :: k type( bz_samp ) :: q","tags":"","url":"proc/rt_ypp_driver.html"},{"title":"PARALLEL_global_Non_Linear – Yambo","text":"subroutine PARALLEL_global_Non_Linear(E, Xk, q) Uses parallel_m R_lattice nl_optics collision_ext openmp QP_m parallel_int electrons IO_int Arguments Type Intent Optional Attributes Name type( levels ) :: E type( bz_samp ) :: Xk type( bz_samp ) :: q","tags":"","url":"proc/parallel_global_non_linear.html"},{"title":"K_multiply_by_V – Yambo","text":"subroutine K_multiply_by_V(Vi, Vo, iter_par, iq, mode) Uses parallel_m pars wrapper IO_m BS_solvers BS parallel_int IO_int Arguments Type Intent Optional Attributes Name type( Haydock_vector ) :: Vi (BS_nT_grps) type( Haydock_vector ) :: Vo (BS_nT_grps) integer, intent(in) :: iter_par integer, intent(in) :: iq character(len=*), intent(in) :: mode","tags":"","url":"proc/k_multiply_by_v.html"},{"title":"RT_occupations_driver – Yambo","text":"subroutine RT_occupations_driver(k, q, en) Uses RT_control R_lattice YPP_interfaces IO_m QP_CTL_m YPP_real_time YPPm drivers electrons real_time Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k type( bz_samp ) :: q type( levels ) :: en","tags":"","url":"proc/rt_occupations_driver.html"},{"title":"OCCUPATIONS_Extend_Double_Grid – Yambo","text":"subroutine OCCUPATIONS_Extend_Double_Grid(what, E, k) Uses R_lattice D_lattice pars functions com parser_m UNITS electrons Arguments Type Intent Optional Attributes Name character(len=*) :: what type( levels ) :: E type( bz_samp ) :: k","tags":"","url":"proc/occupations_extend_double_grid.html"},{"title":"INIT – Yambo","text":"function INIT(en, q, k, X, Xw, Dip, instr, lnstr, CLOSE_Gs, FINALIZE) Uses R_lattice com DIPOLES parser_m QP_m it_tools X_m BS_solvers vec_operate parallel_int stderr pars frequency it_m global_XC drivers BS LIVE_t electrons Arguments Type Intent Optional Attributes Name type( levels ) :: en type( bz_samp ) :: q type( bz_samp ) :: k type( X_t ) :: X (5) type( w_samp ) :: Xw (5) type( DIPOLE_t ) :: Dip character(len=lnstr) :: instr integer :: lnstr logical :: CLOSE_Gs logical :: FINALIZE Return Value integer","tags":"","url":"proc/init.html"},{"title":"PARALLEL_global_indexes – Yambo","text":"subroutine PARALLEL_global_indexes(E, Xk, q, ENVIRONMENT, X, Dip, RESET, Dip_limits_pre_defined) Uses parallel_m R_lattice pars DIPOLES X_m parallel_int electrons Arguments Type Intent Optional Attributes Name type( levels ) :: E type( bz_samp ) :: Xk type( bz_samp ) :: q character(len=*) :: ENVIRONMENT type( X_t ), optional :: X type( DIPOLE_t ), optional :: Dip logical, optional :: RESET logical, optional :: Dip_limits_pre_defined","tags":"","url":"proc/parallel_global_indexes.html"},{"title":"get_ph_E_DbGd – Yambo","text":"function get_ph_E_DbGd(il, iq_fg, iq_bz, q) Uses ELPH pars R_lattice @brief Return phonon energy in the double-grid Arguments Type Intent Optional Attributes Name integer, intent(in) :: il integer, intent(in) :: iq_fg integer, intent(in) :: iq_bz type( bz_samp ), intent(in) :: q Return Value real(kind=SP)","tags":"","url":"proc/get_ph_e_dbgd.html"},{"title":"PARALLEL_global_Response_IO – Yambo","text":"subroutine PARALLEL_global_Response_IO() Uses parallel_m IO_m Arguments None","tags":"","url":"proc/parallel_global_response_io.html"},{"title":"RT_Lifetimes_merge_inter_k – Yambo","text":"subroutine RT_Lifetimes_merge_inter_k(LIFE) Uses parallel_m R_lattice RT_lifetimes parallel_int real_time Arguments Type Intent Optional Attributes Name type( RT_lifetime ), intent(inout) :: LIFE","tags":"","url":"proc/rt_lifetimes_merge_inter_k.html"},{"title":"QP_W2Sc – Yambo","text":"subroutine QP_W2Sc(iqbz, k, E, Xw, Sc_W) Uses parallel_m R_lattice functions pars frequency QP_m electrons Arguments Type Intent Optional Attributes Name integer :: iqbz type( bz_samp ) :: k type( levels ) :: E type( w_samp ) :: Xw type( w_samp ) :: Sc_W (QP_n_states)","tags":"","url":"proc/qp_w2sc.html"},{"title":"QCHEB – Yambo","text":"subroutine QCHEB(X, FVAL, CHEB12, CHEB24) BEGIN PROLOGUE  QCHEB SUBSIDIARY PURPOSE  This routine computes the CHEBYSHEV series expansion\n            of degrees 12 and 24 of a function using A\n            FAST FOURIER TRANSFORM METHOD\n            F(X) = SUM(K=1,..,13) (CHEB12(K) T(K-1,X)),\n            F(X) = SUM(K=1,..,25) (CHEB24(K) T(K-1,X)),\n            Where T(K,X) is the CHEBYSHEV POLYNOMIAL OF DEGREE K. LIBRARY   SLATEC TYPE      SINGLE PRECISION (QCHEB-S, DQCHEB-D) KEYWORDS  CHEBYSHEV SERIES EXPANSION, FAST FOURIER TRANSFORM AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Chebyshev Series Expansion\n    Standard Fortran Subroutine\n    Real version\n\n    PARAMETERS\n      ON ENTRY\n       X      - Real\n                Vector of dimension 11 containing the\n                Values COS(K*PI/24), K = 1, ..., 11\n\n       FVAL   - Real\n                Vector of dimension 25 containing the\n                function values at the points\n                (B+A+(B-A)*COS(K*PI/24))/2, K = 0, ...,24,\n                where (A,B) is the approximation interval.\n                FVAL(1) and FVAL(25) are divided by two\n                (these values are destroyed at output).\n\n      ON RETURN\n       CHEB12 - Real\n                Vector of dimension 13 containing the\n                CHEBYSHEV coefficients for degree 12\n\n       CHEB24 - Real\n                Vector of dimension 25 containing the\n                CHEBYSHEV Coefficients for degree 24 SEE ALSO  QC25C, QC25F, QC25S ROUTINES CALLED  (NONE) REVISION HISTORY  (YYMMDD)\n   810101  DATE WRITTEN\n   830518  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900328  Added TYPE section.  (WRB) END PROLOGUE  QCHEB **FIRST EXECUTABLE STATEMENT  QCHEB Arguments Type Intent Optional Attributes Name real, dimension(11) :: X real, dimension(25) :: FVAL real, dimension(13) :: CHEB12 real, dimension(25) :: CHEB24","tags":"","url":"proc/qcheb.html"},{"title":"PARALLEL_global_Response_T_base – Yambo","text":"subroutine PARALLEL_global_Response_T_base(Xk) Uses parallel_m R_lattice parallel_int openmp Arguments Type Intent Optional Attributes Name type( bz_samp ) :: Xk","tags":"","url":"proc/parallel_global_response_t_base.html"},{"title":"excitons_find_degeneracies – Yambo","text":"subroutine excitons_find_degeneracies(BS_E, BS_E_degs) Uses pars com BS_solvers YPPm vec_operate Arguments Type Intent Optional Attributes Name complex(kind=SP) :: BS_E (BSS_n_eig) integer :: BS_E_degs (BSS_n_eig)","tags":"","url":"proc/excitons_find_degeneracies.html"},{"title":"TDDFT_ALDA_lower_cutoff – Yambo","text":"subroutine TDDFT_ALDA_lower_cutoff(FXC_mode) Uses R_lattice pars com TDDFT BS FFT_m electrons xc_functionals I need FXC_n_g_corr up to wf_ng to arrive up to ng_closed\nThis is consistent with what done in G-space TDDFT Arguments Type Intent Optional Attributes Name character(len=12) :: FXC_mode","tags":"","url":"proc/tddft_alda_lower_cutoff.html"},{"title":"k_find_border_and_merge – Yambo","text":"subroutine k_find_border_and_merge(FineGd_E, FineGd_k, n_FineGd_DBs, FineGd_io_E, FineGd_io_k, Xk, l_skip_border_pts) Uses R_lattice electrons com stderr Arguments Type Intent Optional Attributes Name type( levels ), intent(out) :: FineGd_E type( bz_samp ), intent(out) :: FineGd_k integer, intent(in) :: n_FineGd_DBs type( levels ), intent(inout) :: FineGd_io_E (n_FineGd_DBs) type( bz_samp ), intent(inout) :: FineGd_io_k (n_FineGd_DBs) type( bz_samp ), intent(in) :: Xk logical, intent(in) :: l_skip_border_pts","tags":"","url":"proc/k_find_border_and_merge.html"},{"title":"D1MACH – Yambo","text":"function D1MACH(I) BEGIN PROLOGUE  D1MACH PURPOSE  Return floating point machine dependent constants. LIBRARY   SLATEC CATEGORY  R1 TYPE      DOUBLE PRECISION (R1MACH-S, D1MACH-D) KEYWORDS  MACHINE CONSTANTS AUTHOR  Fox, P. A., (Bell Labs)\n           Hall, A. D., (Bell Labs)\n           Schryer, N. L., (Bell Labs) DESCRIPTION D1MACH can be used to obtain machine-dependent parameters for the\n   local machine environment.  It is a function subprogram with one\n   (input) argument, and can be referenced as follows: D = D1MACH(I) where I=1,...,5.  The (output) value of D above is determined by\n   the (input) value of I.  The results for various values of I are\n   discussed below. D1MACH( 1) = B (EMIN-1), the smallest positive magnitude.\n   D1MACH( 2) = B EMAX (1 - B (-T)), the largest magnitude.\n   D1MACH( 3) = B (-T), the smallest relative spacing.\n   D1MACH( 4) = B *(1-T), the largest relative spacing.\n   D1MACH( 5) = LOG10(B) Assume double precision numbers are represented in the T-digit,\n   base-B form sign (B**E)*( (X(1)/B) + ... + (X(T)/B**T) ) where 0 .LE. X(I) .LT. B for I=1,...,T, 0 .LT. X(1), and\n   EMIN .LE. E .LE. EMAX. The values of B, T, EMIN and EMAX are provided in I1MACH as\n   follows:\n   I1MACH(10) = B, the base.\n   I1MACH(14) = T, the number of base-B digits.\n   I1MACH(15) = EMIN, the smallest exponent E.\n   I1MACH(16) = EMAX, the largest exponent E. To alter this function for a particular environment, the desired\n   set of DATA statements should be activated by removing the C from\n   column 1.  Also, the values of D1MACH(1) - D1MACH(4) should be\n   checked for consistency with the local operating system. REFERENCES  P. A. Fox, A. D. Hall and N. L. Schryer, Framework for\n                 a portable library, ACM Transactions on Mathematical\n                 Software 4, 2 (June 1978), pp. 177-188. ROUTINES CALLED  XERMSG REVISION HISTORY  (YYMMDD)\n   750101  DATE WRITTEN\n   890213  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   900618  Added DEC RISC constants.  (WRB)\n   900723  Added IBM RS 6000 constants.  (WRB)\n   900911  Added SUN 386i constants.  (WRB)\n   910710  Added HP 730 constants.  (SMR)\n   911114  Added Convex IEEE constants.  (WRB)\n   920121  Added SUN -r8 compiler option constants.  (WRB)\n   920229  Added Touchstone Delta i860 constants.  (WRB)\n   920501  Reformatted the REFERENCES section.  (WRB)\n   920625  Added CONVEX -p8 and -pd8 compiler option constants.\n           (BKS, WRB)\n   930201  Added DEC Alpha and SGI constants.  (RWC and WRB) END PROLOGUE  D1MACH **FIRST EXECUTABLE STATEMENT  D1MACH Arguments Type Intent Optional Attributes Name integer :: I Return Value doubleprecision","tags":"","url":"proc/d1mach~2.html"},{"title":"XC_potentials – Yambo","text":"subroutine XC_potentials(POTENTIALS_string) Uses stderr pars collision_ext global_XC drivers hamiltonian electrons xc_functionals Arguments Type Intent Optional Attributes Name character(len=*) :: POTENTIALS_string","tags":"","url":"proc/xc_potentials.html"},{"title":"OSCLL_compose_vbands – Yambo","text":"subroutine OSCLL_compose_vbands(V_input, H_nl_sc, k, q, E, i_k, i_sp_pol) Uses parallel_m R_lattice wrapper_omp pars nl_optics collision_ext QP_m FFT_m electrons Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: V_input (NL_bands(2),maxval(E%nbf),QP_nk,n_sp_pol) complex(kind=SP), intent(inout) :: H_nl_sc (NL_bands(1):NL_bands(2),NL_bands(1):NL_bands(2)) type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: q type( levels ), intent(in) :: E integer, intent(in) :: i_k integer, intent(in) :: i_sp_pol","tags":"","url":"proc/oscll_compose_vbands.html"},{"title":"WF_alloc – Yambo","text":"subroutine WF_alloc(WF, k_extrema_only) Uses gpu_m devxlib wave_func FFT_m pars parallel_int electrons Arguments Type Intent Optional Attributes Name type( WAVEs ) :: WF logical, intent(in) :: k_extrema_only","tags":"","url":"proc/wf_alloc.html"},{"title":"K_kernel – Yambo","text":"subroutine K_kernel(iq, Ken, Xk, q, X, Xw, W_bss) Uses parallel_m R_lattice com X_m QP_m parser_m BS_solvers openmp parallel_int interfaces stderr LOGO MAGNONS IO_int collision_el wave_func D_lattice pars frequency global_XC FFT_m IO_m PHOTOLUM timing_m drivers TDDFT BS LIVE_t electrons xc_functionals Arguments Type Intent Optional Attributes Name integer :: iq type( levels ) :: Ken type( bz_samp ) :: Xk type( bz_samp ) :: q type( X_t ) :: X type( w_samp ) :: Xw type( w_samp ) :: W_bss","tags":"","url":"proc/k_kernel.html"},{"title":"Laplace_transform – Yambo","text":"function Laplace_transform(F, N, dT, Eo) Uses pars Arguments Type Intent Optional Attributes Name real(kind=SP), intent(in) :: F (N) integer, intent(in) :: N real(kind=SP), intent(in) :: dT real(kind=SP), intent(in) :: Eo Return Value real(kind=SP)","tags":"","url":"proc/laplace_transform.html"},{"title":"BESK1 – Yambo","text":"function BESK1(X) BEGIN PROLOGUE  BESK1 PURPOSE  Compute the modified (hyperbolic) Bessel function of the\n            third kind of order one. LIBRARY   SLATEC (FNLIB) CATEGORY  C10B1 TYPE      SINGLE PRECISION (BESK1-S, DBESK1-D) KEYWORDS  FNLIB, HYPERBOLIC BESSEL FUNCTION,\n             MODIFIED BESSEL FUNCTION, ORDER ONE, SPECIAL FUNCTIONS,\n             THIRD KIND AUTHOR  Fullerton, W., (LANL) DESCRIPTION BESK1(X) computes the modified (hyperbolic) Bessel function of third\n kind of order one for real argument X, where X .GT. 0. Series for BK1        on the interval  0.          to  4.00000D+00\n                                        with weighted error   7.02E-18\n                                         log weighted error  17.15\n                               significant figures required  16.73\n                                    decimal places required  17.67 REFERENCES  (NONE) ROUTINES CALLED  BESI1, BESK1E, CSEVL, INITS, R1MACH, XERMSG REVISION HISTORY  (YYMMDD)\n   770401  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   900326  Removed duplicate information from DESCRIPTION section.\n           (WRB) END PROLOGUE  BESK1\n**FIRST EXECUTABLE STATEMENT  BESK1 Arguments Type Intent Optional Attributes Name real :: X Return Value real","tags":"","url":"proc/besk1.html"},{"title":"k_map_fine_to_coarse_init – Yambo","text":"subroutine k_map_fine_to_coarse_init(Xk, Xen, FineGd_k, FineGd_is_expanded, PH_grid) Uses R_lattice stderr D_lattice pars com parser_m IO_m UNITS zeros YPPm electrons interfaces Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: Xk type( levels ), intent(inout) :: Xen type( bz_samp ), intent(out) :: FineGd_k logical, intent(out) :: FineGd_is_expanded logical, intent(in) :: PH_grid","tags":"","url":"proc/k_map_fine_to_coarse_init.html"},{"title":"RT_TRabs_output – Yambo","text":"subroutine RT_TRabs_output(what, how, ofile, N_files, W, TIME) Uses OUTPUT RT_output_m stderr pars frequency YPP_real_time BS_solvers UNITS BS interfaces Arguments Type Intent Optional Attributes Name character(len=*) :: what character(len=*) :: how character(len=schlen) :: ofile (20) integer :: N_files type( w_samp ) :: W real(kind=SP) :: TIME","tags":"","url":"proc/rt_trabs_output.html"},{"title":"PARALLEL_global_DIPOLES – Yambo","text":"subroutine PARALLEL_global_DIPOLES(E, Xk, q, ENVIRONMENT) Uses parallel_m R_lattice parallel_int DIPOLES openmp electrons IO_int Arguments Type Intent Optional Attributes Name type( levels ) :: E type( bz_samp ) :: Xk type( bz_samp ) :: q character(len=*) :: ENVIRONMENT","tags":"","url":"proc/parallel_global_dipoles.html"},{"title":"XC_additional_SC_potentials – Yambo","text":"subroutine XC_additional_SC_potentials() Uses hamiltonian stderr global_XC drivers Arguments None","tags":"","url":"proc/xc_additional_sc_potentials.html"},{"title":"io_BS_PAR_free – Yambo","text":"subroutine io_BS_PAR_free(ID_head, ID, mode, l_kernel_complete) Uses parallel_m pars IO_m BS parallel_int IO_int Arguments Type Intent Optional Attributes Name integer, intent(in) :: ID_head integer, intent(in) :: ID character(len=*), intent(in) :: mode logical, intent(in) :: l_kernel_complete","tags":"","url":"proc/io_bs_par_free.html"},{"title":"p2y_atmproj – Yambo","text":"subroutine p2y_atmproj(filename, k) Uses R_lattice atmproj_tools_module qe_pseudo_m pars IO_m atom_proj electrons IO_int Arguments Type Intent Optional Attributes Name character(len=schlen), intent(in) :: filename type( bz_samp ), intent(in) :: k","tags":"","url":"proc/p2y_atmproj.html"},{"title":"a2y – Yambo","text":"function a2y(np, pid, lnstr, iinf, iind, iod, icd, ijs, instr, inf, ind, od, com_dir, js) Uses parallel_m R_lattice wave_func pseudo D_lattice netcdf_data pars com netcdf IO_m mod_wf2y it_m vec_operate mod_com2y LOGO electrons IO_int Arguments Type Intent Optional Attributes Name integer, intent(in) :: np integer, intent(in) :: pid integer, intent(in) :: lnstr integer, intent(in) :: iinf integer, intent(in) :: iind integer, intent(in) :: iod integer, intent(in) :: icd integer, intent(in) :: ijs character(len=lnstr), intent(in) :: instr character(len=iinf), intent(in) :: inf character(len=iind), intent(in) :: ind character(len=iod), intent(in) :: od character(len=icd), intent(in) :: com_dir character(len=ijs), intent(in) :: js Return Value integer","tags":"","url":"proc/a2y.html"},{"title":"WANNIER_driver – Yambo","text":"subroutine WANNIER_driver(k, E) Uses R_lattice pars com QP_m IO_m UNITS YPPm vec_operate zeros electrons IO_int Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k type( levels ) :: E","tags":"","url":"proc/wannier_driver.html"},{"title":"io_BS_PAR_init – Yambo","text":"function io_BS_PAR_init(iq, ID, mode) Uses stderr pars com IO_m BS IO_int Complex dim Arguments Type Intent Optional Attributes Name integer, intent(in) :: iq integer, intent(in) :: ID character(len=*), intent(in) :: mode Return Value integer","tags":"","url":"proc/io_bs_par_init.html"},{"title":"SERIAL_lin_system – Yambo","text":"subroutine SERIAL_lin_system(n, nrhs, A, B) Uses linear_algebra pars timing_m drivers Arguments Type Intent Optional Attributes Name integer :: n integer :: nrhs complex(kind=SP) :: A (n,n) complex(kind=SP) :: B (n,nrhs)","tags":"","url":"proc/serial_lin_system.html"},{"title":"ldim_cyclic – Yambo","text":"function ldim_cyclic(gdim, np, me) Arguments Type Intent Optional Attributes Name integer :: gdim integer :: np integer :: me Return Value integer","tags":"","url":"proc/ldim_cyclic.html"},{"title":"ldim_block – Yambo","text":"function ldim_block(gdim, np, me) Arguments Type Intent Optional Attributes Name integer :: gdim integer :: np integer :: me Return Value integer","tags":"","url":"proc/ldim_block.html"},{"title":"ldim_block_sca – Yambo","text":"function ldim_block_sca(gdim, np, me) Arguments Type Intent Optional Attributes Name integer :: gdim integer :: np integer :: me Return Value integer","tags":"","url":"proc/ldim_block_sca.html"},{"title":"ldim_block_cyclic – Yambo","text":"function ldim_block_cyclic(N, NB, NPROCS, IPROC) Arguments Type Intent Optional Attributes Name integer :: N integer :: NB integer :: NPROCS integer :: IPROC Return Value integer","tags":"","url":"proc/ldim_block_cyclic.html"},{"title":"lind_block – Yambo","text":"function lind_block(ig, nx, np, me) Arguments Type Intent Optional Attributes Name integer :: ig integer :: nx integer :: np integer :: me Return Value integer","tags":"","url":"proc/lind_block.html"},{"title":"lind_block_sca – Yambo","text":"function lind_block_sca(ig, nx, np, me) Arguments Type Intent Optional Attributes Name integer :: ig integer :: nx integer :: np integer :: me Return Value integer","tags":"","url":"proc/lind_block_sca.html"},{"title":"lind_cyclic – Yambo","text":"function lind_cyclic(ig, nx, np, me) Arguments Type Intent Optional Attributes Name integer :: ig integer :: nx integer :: np integer :: me Return Value integer","tags":"","url":"proc/lind_cyclic.html"},{"title":"lind_block_cyclic – Yambo","text":"function lind_block_cyclic(INDXGLOB, NB, NPROCS, IPROC) Arguments Type Intent Optional Attributes Name integer :: INDXGLOB integer :: NB integer :: NPROCS integer :: IPROC Return Value integer","tags":"","url":"proc/lind_block_cyclic.html"},{"title":"gind_cyclic – Yambo","text":"function gind_cyclic(lind, n, np, me) Arguments Type Intent Optional Attributes Name integer, intent(in) :: lind integer, intent(in) :: n integer, intent(in) :: np integer, intent(in) :: me Return Value integer","tags":"","url":"proc/gind_cyclic.html"},{"title":"gind_block – Yambo","text":"function gind_block(lind, n, np, me) Arguments Type Intent Optional Attributes Name integer, intent(in) :: lind integer, intent(in) :: n integer, intent(in) :: np integer, intent(in) :: me Return Value integer","tags":"","url":"proc/gind_block.html"},{"title":"gind_block_sca – Yambo","text":"function gind_block_sca(lind, n, np, me) Arguments Type Intent Optional Attributes Name integer, intent(in) :: lind integer, intent(in) :: n integer, intent(in) :: np integer, intent(in) :: me Return Value integer","tags":"","url":"proc/gind_block_sca.html"},{"title":"gind_block_cyclic – Yambo","text":"function gind_block_cyclic(lind, n, nb, np, me) Arguments Type Intent Optional Attributes Name integer, intent(in) :: lind integer, intent(in) :: n integer, intent(in) :: nb integer, intent(in) :: np integer, intent(in) :: me Return Value integer","tags":"","url":"proc/gind_block_cyclic.html"},{"title":"block_distribute – Yambo","text":"subroutine block_distribute(nat, me_image, nproc_image, ia_s, ia_e, mykey) Arguments Type Intent Optional Attributes Name integer, intent(in) :: nat integer, intent(in) :: me_image integer, intent(in) :: nproc_image integer, intent(out) :: ia_s integer, intent(out) :: ia_e integer, intent(out) :: mykey","tags":"","url":"proc/block_distribute.html"},{"title":"GRID2D_DIMS – Yambo","text":"subroutine GRID2D_DIMS(grid_shape, nproc, nprow, npcol) Arguments Type Intent Optional Attributes Name character(len=1), intent(in) :: grid_shape integer, intent(in) :: nproc integer, intent(out) :: nprow integer, intent(out) :: npcol","tags":"","url":"proc/grid2d_dims.html"},{"title":"GRID2D_COORDS – Yambo","text":"subroutine GRID2D_COORDS(order, rank, nprow, npcol, row, col) Arguments Type Intent Optional Attributes Name character(len=1), intent(in) :: order integer, intent(in) :: rank integer, intent(in) :: nprow integer, intent(in) :: npcol integer, intent(out) :: row integer, intent(out) :: col","tags":"","url":"proc/grid2d_coords.html"},{"title":"GRID2D_RANK – Yambo","text":"subroutine GRID2D_RANK(order, nprow, npcol, row, col, rank) Arguments Type Intent Optional Attributes Name character(len=1), intent(in) :: order integer, intent(in) :: nprow integer, intent(in) :: npcol integer, intent(in) :: row integer, intent(in) :: col integer, intent(out) :: rank","tags":"","url":"proc/grid2d_rank.html"},{"title":"RT_TRabs_residuals – Yambo","text":"subroutine RT_TRabs_residuals(what, N_trans, N_dirs, DIP_dir, Xen, Xk, nb, l_EQ) Uses parallel_m R_lattice pars X_m YPP_real_time BS_solvers YPPm BS electrons real_time Arguments Type Intent Optional Attributes Name character(len=*) :: what integer :: N_trans integer :: N_dirs real(kind=SP) :: DIP_dir (3,3) type( levels ) :: Xen type( bz_samp ) :: Xk integer :: nb (2) logical :: l_EQ","tags":"","url":"proc/rt_trabs_residuals.html"},{"title":"Build_LSEX_collisions – Yambo","text":"subroutine Build_LSEX_collisions(k, q, i_qp, COLL) Uses R_lattice pars collision_ext QP_m electrons Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: q integer, intent(in) :: i_qp complex(kind=SP), intent(out) :: COLL (COLL_bands(1):COLL_bands(2),COLL_bands(1):COLL_bands(2),QP_nk)","tags":"","url":"proc/build_lsex_collisions.html"},{"title":"DBESJ1_ – Yambo","text":"function DBESJ1_(X) BEGIN PROLOGUE  DBESJ1 PURPOSE  Compute the Bessel function of the first kind of order one. LIBRARY   SLATEC (FNLIB) CATEGORY  C10A1 TYPE      DOUBLE PRECISION (BESJ1-S, DBESJ1-D) KEYWORDS  BESSEL FUNCTION, FIRST KIND, FNLIB, ORDER ONE,\n             SPECIAL FUNCTIONS AUTHOR  Fullerton, W., (LANL) DESCRIPTION DBESJ1(X) calculates the double precision Bessel function of the\n first kind of order one for double precision argument X. Series for BJ1        on the interval  0.          to  1.60000E+01\n                                        with weighted error   1.16E-33\n                                         log weighted error  32.93\n                               significant figures required  32.36\n                                    decimal places required  33.57 REFERENCES  (NONE) ROUTINES CALLED  D1MACH, D9B1MP, DCSEVL, INITDS, XERMSG REVISION HISTORY  (YYMMDD)\n   780601  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   910401  Corrected error in code which caused values to have the\n           wrong sign for arguments less than 4.0.  (WRB) END PROLOGUE  DBESJ1\n**FIRST EXECUTABLE STATEMENT  DBESJ1 Arguments Type Intent Optional Attributes Name double precision :: X Return Value doubleprecision","tags":"","url":"proc/dbesj1_.html"},{"title":"INIT_ypp_load – Yambo","text":"subroutine INIT_ypp_load(defs) Uses R_lattice wave_func interpolate D_lattice YPP_symm it_tools it_m YPPm LIVE_t electrons Arguments Type Intent Optional Attributes Name type( initdefs ) :: defs","tags":"","url":"proc/init_ypp_load.html"},{"title":"QP_apply – Yambo","text":"subroutine QP_apply(bands, en, k, object, msg_fmt, qp_impose, QP_ctl_impose, main_section) Uses R_lattice D_lattice com QP_m QP_CTL_m UNITS global_XC drivers electrons interfaces Arguments Type Intent Optional Attributes Name integer :: bands (2) type( levels ) :: en type( bz_samp ) :: k character(len=1) :: object character(len=*) :: msg_fmt type( QP_t ), optional :: qp_impose type( QP_ctl_t ), optional :: QP_ctl_impose (n_sp_pol) logical, optional :: main_section","tags":"","url":"proc/qp_apply.html"},{"title":"K_diago_right_residuals – Yambo","text":"subroutine K_diago_right_residuals(mode, i_BS_mat, BS_E, BS_R_right, BS_V_right) Uses parallel_m DICHROISM wrapper_omp pars X_m LIVE_t BS_solvers BS parallel_int MAGNONS Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: mode integer, intent(in) :: i_BS_mat complex(kind=SP), intent(in) :: BS_E (BSS_n_eig) complex(kind=SP), intent(out) :: BS_R_right (BSS_n_eig) complex(kind=SP), intent(in) :: BS_V_right (:,:)","tags":"","url":"proc/k_diago_right_residuals.html"},{"title":"OEP_Hole – Yambo","text":"subroutine OEP_Hole(E, k, Vslt, U_x) Uses R_lattice wave_func D_lattice pars SC FFT_m electrons Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: E type( bz_samp ), intent(in) :: k real(kind=SP), intent(out) :: Vslt (fft_size) complex(kind=SP), intent(in) :: U_x (nkibz,maxval(n_met_bands),fft_size)","tags":"","url":"proc/oep_hole.html"},{"title":"INITDS – Yambo","text":"function INITDS(OS, NOS, ETA) BEGIN PROLOGUE  INITDS PURPOSE  Determine the number of terms needed in an orthogonal\n            polynomial series so that it meets a specified accuracy. LIBRARY   SLATEC (FNLIB) CATEGORY  C3A2 TYPE      DOUBLE PRECISION (INITS-S, INITDS-D) KEYWORDS  CHEBYSHEV, FNLIB, INITIALIZE, ORTHOGONAL POLYNOMIAL,\n             ORTHOGONAL SERIES, SPECIAL FUNCTIONS AUTHOR  Fullerton, W., (LANL) DESCRIPTION Initialize the orthogonal series, represented by the array OS, so\n  that INITDS is the number of terms needed to insure the error is no\n  larger than ETA.  Ordinarily, ETA will be chosen to be one-tenth\n  machine precision. Input Arguments -- OS     double precision array of NOS coefficients in an orthogonal\n          series.\n   NOS    number of coefficients in OS.\n   ETA    single precision scalar containing requested accuracy of\n          series. REFERENCES  (NONE) ROUTINES CALLED  XERMSG REVISION HISTORY  (YYMMDD)\n   770601  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890831  Modified array declarations.  (WRB)\n   891115  Modified error message.  (WRB)\n   891115  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ) END PROLOGUE  INITDS Arguments Type Intent Optional Attributes Name double precision :: OS (*) **FIRST EXECUTABLE STATEMENT  INITDS integer :: NOS real :: ETA Return Value integer","tags":"","url":"proc/initds.html"},{"title":"DCSEVL – Yambo","text":"function DCSEVL(X, CS, N) BEGIN PROLOGUE  DCSEVL PURPOSE  Evaluate a Chebyshev series. LIBRARY   SLATEC (FNLIB) CATEGORY  C3A2 TYPE      DOUBLE PRECISION (CSEVL-S, DCSEVL-D) KEYWORDS  CHEBYSHEV SERIES, FNLIB, SPECIAL FUNCTIONS AUTHOR  Fullerton, W., (LANL) DESCRIPTION Evaluate the N-term Chebyshev series CS at X.  Adapted from\n  a method presented in the paper by Broucke referenced below. Input Arguments -- X    value at which the series is to be evaluated.\n  CS   array of N terms of a Chebyshev series.  In evaluating\n       CS, only half the first coefficient is summed.\n  N    number of terms in array CS. REFERENCES  R. Broucke, Ten subroutines for the manipulation of\n                 Chebyshev series, Algorithm 446, Communications of\n                 the A.C.M. 16, (1973) pp. 254-256.\n               L. Fox and I. B. Parker, Chebyshev Polynomials in\n                 Numerical Analysis, Oxford University Press, 1968,\n                 page 56. ROUTINES CALLED  D1MACH, XERMSG REVISION HISTORY  (YYMMDD)\n   770401  DATE WRITTEN\n   890831  Modified array declarations.  (WRB)\n   890831  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   900329  Prologued revised extensively and code rewritten to allow\n           X to be slightly outside interval (-1,+1).  (WRB)\n   920501  Reformatted the REFERENCES section.  (WRB) END PROLOGUE  DCSEVL\n**FIRST EXECUTABLE STATEMENT  DCSEVL Arguments Type Intent Optional Attributes Name double precision :: X double precision :: CS (*) integer :: N Return Value doubleprecision","tags":"","url":"proc/dcsevl.html"},{"title":"c2y – Yambo","text":"function c2y(np, pid, lnstr, iinf, iind, iod, icd, ijs, instr, inf, ind, od, com_dir, js) Uses parallel_m R_lattice wave_func pars com IO_m mod_wf2y mod_com2y LOGO parallel_int electrons IO_int Arguments Type Intent Optional Attributes Name integer, intent(in) :: np integer, intent(in) :: pid integer, intent(in) :: lnstr integer, intent(in) :: iinf integer, intent(in) :: iind integer, intent(in) :: iod integer, intent(in) :: icd integer, intent(in) :: ijs character(len=lnstr), intent(in) :: instr character(len=iinf), intent(in) :: inf character(len=iind), intent(in) :: ind character(len=iod), intent(in) :: od character(len=icd), intent(in) :: com_dir character(len=ijs), intent(in) :: js Return Value integer","tags":"","url":"proc/c2y.html"},{"title":"K_IP – Yambo","text":"subroutine K_IP(iq, Ken, Xk, Dip, W_bss) Uses parallel_m R_lattice parallel_int stderr pars com DIPOLES frequency X_m parser_m PHOTOLUM BS_solvers timing_m UNITS drivers BS LIVE_t electrons Arguments Type Intent Optional Attributes Name integer :: iq type( levels ) :: Ken type( bz_samp ) :: Xk type( DIPOLE_t ) :: Dip type( w_samp ) :: W_bss","tags":"","url":"proc/k_ip.html"},{"title":"INTERPOLATION_vec_in_star – Yambo","text":"function INTERPOLATION_vec_in_star(vec, nstar, star_vec) Uses pars vec_operate Arguments Type Intent Optional Attributes Name real(kind=SP), intent(in) :: vec (3) integer, intent(in) :: nstar real(kind=SP), intent(in) :: star_vec (3,nstar) Return Value logical","tags":"","url":"proc/interpolation_vec_in_star.html"},{"title":"DIPOLE_kb_project – Yambo","text":"subroutine DIPOLE_kb_project(pp_range, ib_range, ib, i_wf, wf_ncx, nbndx, npp, pp_dim_atom, pp_dim_yambo, WF, kbv, XX) Uses iso_c_binding pars electrons devxlib Arguments Type Intent Optional Attributes Name integer, intent(in) :: pp_range (2) integer, intent(in) :: ib_range (2) integer, intent(in) :: ib integer, intent(in) :: i_wf integer, intent(in) :: wf_ncx integer, intent(in) :: nbndx integer, intent(in) :: npp integer, intent(in) :: pp_dim_atom integer, intent(in) :: pp_dim_yambo complex(kind=SP), intent(in), target :: WF (wf_ncx,n_spinor,nbndx) complex(kind=SP), intent(in), target :: kbv (wf_ncx,n_spinor,4,pp_dim_atom) complex(kind=SP), intent(inout), target :: XX (n_spinor,n_spinor,4,pp_dim_yambo,ib_range(1):ib_range(2))","tags":"","url":"proc/dipole_kb_project.html"},{"title":"DIPOLE_kb_sum – Yambo","text":"subroutine DIPOLE_kb_sum(rho, pp_dim_yambo, ib_range, iv, ic, XX) Uses gpu_m devxlib pars DIPOLES electrons Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(inout) :: rho (3) integer, intent(in) :: pp_dim_yambo integer, intent(in) :: ib_range (2) integer, intent(in) :: iv integer, intent(in) :: ic complex(kind=SP), intent(in) :: XX (n_spinor,n_spinor,4,pp_dim_yambo,ib_range(1):ib_range(2))","tags":"","url":"proc/dipole_kb_sum.html"},{"title":"electrons_magn_factors – Yambo","text":"subroutine electrons_magn_factors(kpts, bands, magn_factors) Uses parallel_m parallel_int wave_func FFT_m wrapper_omp pars LIVE_t interfaces Arguments Type Intent Optional Attributes Name integer, intent(in) :: kpts (2) integer, intent(in) :: bands (2) real(kind=SP), intent(out) :: magn_factors (bands(1):bands(2),kpts(1):kpts(2),3)","tags":"","url":"proc/electrons_magn_factors.html"},{"title":"WF_spatial_inversion – Yambo","text":"subroutine WF_spatial_inversion(en, Xk) Uses R_lattice wave_func D_lattice pars com FFT_m electrons interfaces Arguments Type Intent Optional Attributes Name type( levels ) :: en type( bz_samp ) :: Xk","tags":"","url":"proc/wf_spatial_inversion.html"},{"title":"BS_exchange_oscillators_alloc – Yambo","text":"subroutine BS_exchange_oscillators_alloc(iG) Uses BS gpu_m Arguments Type Intent Optional Attributes Name integer, intent(in) :: iG","tags":"","url":"proc/bs_exchange_oscillators_alloc.html"},{"title":"BS_correlation_oscillators_alloc – Yambo","text":"subroutine BS_correlation_oscillators_alloc(iB) Uses BS gpu_m Arguments Type Intent Optional Attributes Name integer, intent(in) :: iB","tags":"","url":"proc/bs_correlation_oscillators_alloc.html"},{"title":"BS_exchange_oscillators_free – Yambo","text":"subroutine BS_exchange_oscillators_free(iG_ref) Uses BS Arguments Type Intent Optional Attributes Name integer, intent(in) :: iG_ref","tags":"","url":"proc/bs_exchange_oscillators_free.html"},{"title":"BS_correlation_oscillators_free – Yambo","text":"subroutine BS_correlation_oscillators_free(iB_ref, l_std_alg) Uses BS Arguments Type Intent Optional Attributes Name integer, intent(in) :: iB_ref logical, intent(in) :: l_std_alg","tags":"","url":"proc/bs_correlation_oscillators_free.html"},{"title":"TDDFT_oscillators_alloc_L – Yambo","text":"subroutine TDDFT_oscillators_alloc_L(iGL) Uses BS gpu_m electrons Arguments Type Intent Optional Attributes Name integer, intent(in) :: iGL","tags":"","url":"proc/tddft_oscillators_alloc_l.html"},{"title":"TDDFT_oscillators_alloc_R – Yambo","text":"subroutine TDDFT_oscillators_alloc_R(iGR) Uses BS gpu_m electrons Arguments Type Intent Optional Attributes Name integer, intent(in) :: iGR","tags":"","url":"proc/tddft_oscillators_alloc_r.html"},{"title":"TDDFT_oscillators_free_L – Yambo","text":"subroutine TDDFT_oscillators_free_L(iG_ref) Uses BS Arguments Type Intent Optional Attributes Name integer, intent(in) :: iG_ref","tags":"","url":"proc/tddft_oscillators_free_l.html"},{"title":"TDDFT_oscillators_free_R – Yambo","text":"subroutine TDDFT_oscillators_free_R(iG_ref) Uses BS Arguments Type Intent Optional Attributes Name integer, intent(in) :: iG_ref","tags":"","url":"proc/tddft_oscillators_free_r.html"},{"title":"X_mat_filling – Yambo","text":"subroutine X_mat_filling(iq_mem, X, Xw, X_MEM_n_freqs, X_MEM_n_tot_freqs, X_mat) Uses parallel_m pars X_m frequency IO_m parallel_int Arguments Type Intent Optional Attributes Name integer :: iq_mem type( X_t ) :: X type( w_samp ) :: Xw integer :: X_MEM_n_freqs integer :: X_MEM_n_tot_freqs complex(kind=SP) :: X_mat (X%ng,X%ng,X_MEM_n_tot_freqs)","tags":"","url":"proc/x_mat_filling.html"},{"title":"ELPH_databases_grids_map – Yambo","text":"subroutine ELPH_databases_grids_map(k, q) Uses R_lattice ELPH pars vec_operate zeros drivers Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k type( bz_samp ) :: q","tags":"","url":"proc/elph_databases_grids_map.html"},{"title":"R1MACH – Yambo","text":"function R1MACH(I) BEGIN PROLOGUE  R1MACH PURPOSE  Return floating point machine dependent constants. LIBRARY   SLATEC CATEGORY  R1 TYPE      SINGLE PRECISION (R1MACH-S, D1MACH-D) KEYWORDS  MACHINE CONSTANTS AUTHOR  Fox, P. A., (Bell Labs)\n           Hall, A. D., (Bell Labs)\n           Schryer, N. L., (Bell Labs) DESCRIPTION R1MACH can be used to obtain machine-dependent parameters for the\n   local machine environment.  It is a function subprogram with one\n   (input) argument, and can be referenced as follows: A = R1MACH(I) where I=1,...,5.  The (output) value of A above is determined by\n   the (input) value of I.  The results for various values of I are\n   discussed below. R1MACH(1) = B (EMIN-1), the smallest positive magnitude.\n   R1MACH(2) = B EMAX (1 - B (-T)), the largest magnitude.\n   R1MACH(3) = B (-T), the smallest relative spacing.\n   R1MACH(4) = B *(1-T), the largest relative spacing.\n   R1MACH(5) = LOG10(B) Assume single precision numbers are represented in the T-digit,\n   base-B form sign (B**E)*( (X(1)/B) + ... + (X(T)/B**T) ) where 0 .LE. X(I) .LT. B for I=1,...,T, 0 .LT. X(1), and\n   EMIN .LE. E .LE. EMAX. The values of B, T, EMIN and EMAX are provided in I1MACH as\n   follows:\n   I1MACH(10) = B, the base.\n   I1MACH(11) = T, the number of base-B digits.\n   I1MACH(12) = EMIN, the smallest exponent E.\n   I1MACH(13) = EMAX, the largest exponent E. To alter this function for a particular environment, the desired\n   set of DATA statements should be activated by removing the C from\n   column 1.  Also, the values of R1MACH(1) - R1MACH(4) should be\n   checked for consistency with the local operating system. REFERENCES  P. A. Fox, A. D. Hall and N. L. Schryer, Framework for\n                 a portable library, ACM Transactions on Mathematical\n                 Software 4, 2 (June 1978), pp. 177-188. ROUTINES CALLED  XERMSG REVISION HISTORY  (YYMMDD)\n   790101  DATE WRITTEN\n   890213  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   900618  Added DEC RISC constants.  (WRB)\n   900723  Added IBM RS 6000 constants.  (WRB)\n   910710  Added HP 730 constants.  (SMR)\n   911114  Added Convex IEEE constants.  (WRB)\n   920121  Added SUN -r8 compiler option constants.  (WRB)\n   920229  Added Touchstone Delta i860 constants.  (WRB)\n   920501  Reformatted the REFERENCES section.  (WRB)\n   920625  Added CONVEX -p8 and -pd8 compiler option constants.\n           (BKS, WRB)\n   930201  Added DEC Alpha and SGI constants.  (RWC and WRB) END PROLOGUE  R1MACH **FIRST EXECUTABLE STATEMENT  R1MACH Arguments Type Intent Optional Attributes Name integer :: I Return Value real","tags":"","url":"proc/r1mach~2.html"},{"title":"QK51 – Yambo","text":"subroutine QK51(F, A, B, RESULT, ABSERR, RESABS, RESASC) BEGIN PROLOGUE  QK51 PURPOSE  To compute I = Integral of F over (A,B) with error\n                           estimate\n                       J = Integral of ABS(F) over (A,B) LIBRARY   SLATEC (QUADPACK) CATEGORY  H2A1A2 TYPE      SINGLE PRECISION (QK51-S, DQK51-D) KEYWORDS  51-POINT GAUSS-KRONROD RULES, QUADPACK, QUADRATURE AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Integration rules Standard fortran subroutine Real version PARAMETERS ON ENTRY F - Real Function subroutine defining the integrand function F ( X ) . The actual name for F needs to be declared E X T E R N A L in the calling program . A - Real Lower limit of integration B - Real Upper limit of integration ON RETURN RESULT - Real Approximation to the integral I RESULT is computed by applying the 51 - point Kronrod rule ( RESK ) obtained by optimal addition of abscissae to the 25 - point Gauss rule ( RESG ) . ABSERR - Real Estimate of the modulus of the absolute error , which should not exceed ABS ( I - RESULT ) RESABS - Real Approximation to the integral J RESASC - Real Approximation to the integral of ABS ( F - I / ( B - A )) over ( A , B ) REFERENCES  (NONE) ROUTINES CALLED  R1MACH REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB) END PROLOGUE  QK51 **FIRST EXECUTABLE STATEMENT  QK51 Arguments Type Intent Optional Attributes Name real :: F real :: A real :: B real :: RESULT real :: ABSERR real :: RESABS real :: RESASC","tags":"","url":"proc/qk51.html"},{"title":"INTERPOLATION_fourier – Yambo","text":"subroutine INTERPOLATION_fourier(K, VALUES, engre, nvalues, NK, ID) Uses parallel_m R_lattice parallel_int interpolate D_lattice pars interpolate_tools timing_m vec_operate LIVE_t Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: K real(kind=SP), intent(out) :: VALUES (nvalues,NK) complex(kind=DP), intent(in) :: engre (nshells,nvalues) integer, intent(in) :: nvalues integer, intent(in) :: NK integer, intent(in) :: ID","tags":"","url":"proc/interpolation_fourier.html"},{"title":"RT_time_configuration_setup – Yambo","text":"subroutine RT_time_configuration_setup(what, GENERAL_RT_IO_t) Uses RT_control pars com YPP_real_time UNITS real_time Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: what type( RT_IO_t ), intent(in) :: GENERAL_RT_IO_t","tags":"","url":"proc/rt_time_configuration_setup.html"},{"title":"DBESJ0_ – Yambo","text":"function DBESJ0_(X) BEGIN PROLOGUE  DBESJ0 PURPOSE  Compute the Bessel function of the first kind of order\n            zero. LIBRARY   SLATEC (FNLIB) CATEGORY  C10A1 TYPE      DOUBLE PRECISION (BESJ0-S, DBESJ0-D) KEYWORDS  BESSEL FUNCTION, FIRST KIND, FNLIB, ORDER ZERO,\n             SPECIAL FUNCTIONS AUTHOR  Fullerton, W., (LANL) DESCRIPTION DBESJ0(X) calculates the double precision Bessel function of\n the first kind of order zero for double precision argument X. Series for BJ0        on the interval  0.          to  1.60000E+01\n                                        with weighted error   4.39E-32\n                                         log weighted error  31.36\n                               significant figures required  31.21\n                                    decimal places required  32.00 REFERENCES  (NONE) ROUTINES CALLED  D1MACH, D9B0MP, DCSEVL, INITDS REVISION HISTORY  (YYMMDD)\n   770701  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB) END PROLOGUE  DBESJ0\n**FIRST EXECUTABLE STATEMENT  DBESJ0 Arguments Type Intent Optional Attributes Name double precision :: X Return Value doubleprecision","tags":"","url":"proc/dbesj0_.html"},{"title":"Dipole_kb_abinit_def_dim – Yambo","text":"subroutine Dipole_kb_abinit_def_dim() Uses R_lattice wave_func pseudo D_lattice pars Arguments None","tags":"","url":"proc/dipole_kb_abinit_def_dim.html"},{"title":"NL_average_operator – Yambo","text":"subroutine NL_average_operator(O_VALUE, V_VALUE, O_REAL, O_MATRIX, V_MATRIX, PV_MATRIX, V_bands, dG, k, en, TRANS, nK_mem) Uses parallel_m R_lattice parallel_int wave_func wrapper_omp pars nl_optics QP_m FFT_m electrons H_interfaces @brief Calculate the average value of an operator Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(out), optional :: O_VALUE complex(kind=SP), intent(out), optional :: V_VALUE (3) real(kind=SP), intent(in), optional :: O_REAL (fft_size,n_spin) complex(kind=SP), intent(in), optional :: O_MATRIX (NL_bands(1):NL_bands(2),NL_bands(1):NL_bands(2),nK_mem,n_sp_pol) complex(kind=SP), intent(in), optional :: V_MATRIX (3,NL_bands(1):NL_bands(2),NL_bands(1):NL_bands(2),nK_mem,n_sp_pol) complex(kind=SP), intent(in), optional :: PV_MATRIX (3,NL_bands(1):NL_bands(2),NL_bands(1):NL_bands(2),nK_mem,n_sp_pol) complex(kind=SP), intent(in), optional :: V_bands (NL_bands(2),maxval(en%nbf),QP_nk,n_sp_pol) complex(kind=SP), intent(in), optional :: dG (NL_bands(1):NL_bands(2),NL_bands(1):NL_bands(2),nXkibz) type( bz_samp ), intent(in) :: k type( levels ), intent(in) :: en logical, intent(in), optional :: TRANS integer, intent(in) :: nK_mem","tags":"","url":"proc/nl_average_operator.html"},{"title":"X_delta_part – Yambo","text":"subroutine X_delta_part(NG, NW, X, Gamp) Uses pars D_lattice Arguments Type Intent Optional Attributes Name integer :: NG integer :: NW complex(kind=SP) :: X (NG,NG,NW) complex(kind=SP) :: Gamp (NG,NG)","tags":"","url":"proc/x_delta_part.html"},{"title":"QP_interpolate_W – Yambo","text":"subroutine QP_interpolate_W(X, Xw, q, mode) Uses parallel_m R_lattice stderr D_lattice pars com X_m frequency IO_m timing_m vec_operate ALLOC IO_int Arguments Type Intent Optional Attributes Name type( X_t ) :: X type( w_samp ) :: Xw type( bz_samp ) :: q character(len=3) :: mode","tags":"","url":"proc/qp_interpolate_w.html"},{"title":"find_q_nns – Yambo","text":"subroutine find_q_nns(q, q_grid_b_iku, idx_q, idx_is, idx_G) Uses pars R_lattice vec_operate Arguments Type Intent Optional Attributes Name type( bz_samp ) :: q real(kind=SP) :: q_grid_b_iku (3,2) integer :: idx_q (RIM_W_ng,q%nibz,5) integer :: idx_is (RIM_W_ng,q%nibz,5) integer :: idx_G (RIM_W_ng,q%nibz,5)","tags":"","url":"proc/find_q_nns.html"},{"title":"QK41 – Yambo","text":"subroutine QK41(F, A, B, RESULT, ABSERR, RESABS, RESASC) BEGIN PROLOGUE  QK41 PURPOSE  To compute I = Integral of F over (A,B), with error\n                           estimate\n                       J = Integral of ABS(F) over (A,B) LIBRARY   SLATEC (QUADPACK) CATEGORY  H2A1A2 TYPE      SINGLE PRECISION (QK41-S, DQK41-D) KEYWORDS  41-POINT GAUSS-KRONROD RULES, QUADPACK, QUADRATURE AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Integration rules Standard fortran subroutine Real version PARAMETERS ON ENTRY F - Real Function subprogram defining the integrand FUNCTION F ( X ) . The actual name for F needs to be declared E X T E R N A L in the calling program . A - Real Lower limit of integration B - Real Upper limit of integration ON RETURN RESULT - Real Approximation to the integral I RESULT is computed by applying the 41 - POINT GAUSS - KRONROD RULE ( RESK ) obtained by optimal addition of abscissae to the 20 - POINT GAUSS RULE ( RESG ) . ABSERR - Real Estimate of the modulus of the absolute error , which should not exceed ABS ( I - RESULT ) RESABS - Real Approximation to the integral J RESASC - Real Approximation to the integral of ABS ( F - I / ( B - A )) over ( A , B ) REFERENCES  (NONE) ROUTINES CALLED  R1MACH REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB) END PROLOGUE  QK41 **FIRST EXECUTABLE STATEMENT  QK41 Arguments Type Intent Optional Attributes Name real :: F real :: A real :: B real :: RESULT real :: ABSERR real :: RESABS real :: RESASC","tags":"","url":"proc/qk41.html"},{"title":"DBESK0 – Yambo","text":"function DBESK0(X) BEGIN PROLOGUE  DBESK0 PURPOSE  Compute the modified (hyperbolic) Bessel function of the\n            third kind of order zero. LIBRARY   SLATEC (FNLIB) CATEGORY  C10B1 TYPE      DOUBLE PRECISION (BESK0-S, DBESK0-D) KEYWORDS  FNLIB, HYPERBOLIC BESSEL FUNCTION,\n             MODIFIED BESSEL FUNCTION, ORDER ZERO, SPECIAL FUNCTIONS,\n             THIRD KIND AUTHOR  Fullerton, W., (LANL) DESCRIPTION DBESK0(X) calculates the double precision modified (hyperbolic)\n Bessel function of the third kind of order zero for double\n precision argument X.  The argument must be greater than zero\n but not so large that the result underflows. Series for BK0        on the interval  0.          to  4.00000E+00\n                                        with weighted error   3.08E-33\n                                         log weighted error  32.51\n                               significant figures required  32.05\n                                    decimal places required  33.11 REFERENCES  (NONE) ROUTINES CALLED  D1MACH, DBESI0, DBSK0E, DCSEVL, INITDS, XERMSG REVISION HISTORY  (YYMMDD)\n   770701  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ) END PROLOGUE  DBESK0\n**FIRST EXECUTABLE STATEMENT  DBESK0 Arguments Type Intent Optional Attributes Name double precision :: X Return Value doubleprecision","tags":"","url":"proc/dbesk0.html"},{"title":"STOP_now – Yambo","text":"function STOP_now(DO_IT_NOW) Uses parallel_m pars parser_m it_tools BS LIVE_t Arguments Type Intent Optional Attributes Name logical :: DO_IT_NOW Return Value logical","tags":"","url":"proc/stop_now.html"},{"title":"RT_split_Polarization – Yambo","text":"subroutine RT_split_Polarization(nh, nt, W, X, P, what) Uses RT_control stderr pars YPP_real_time UNITS LIVE_t real_time Arguments Type Intent Optional Attributes Name integer, intent(in) :: nh integer, intent(in) :: nt real(kind=SP), intent(inout) :: W (nh) complex(kind=SP), intent(inout) :: X (nh,3) real(kind=SP), intent(inout) :: P (nt,3) character(len=*), intent(in) :: what","tags":"","url":"proc/rt_split_polarization.html"},{"title":"K_dipoles – Yambo","text":"subroutine K_dipoles(iq, Ken, Xk, q, X_oscillators, Dip) Uses parallel_m R_lattice com DIPOLES X_m BS_solvers vec_operate parallel_int ALLOC interfaces stderr collision_el wave_func pars IO_m timing_m BS LIVE_t electrons Arguments Type Intent Optional Attributes Name integer :: iq type( levels ) :: Ken type( bz_samp ) :: Xk type( bz_samp ) :: q type( X_t ) :: X_oscillators type( DIPOLE_t ) :: Dip","tags":"","url":"proc/k_dipoles.html"},{"title":"QK61 – Yambo","text":"subroutine QK61(F, A, B, RESULT, ABSERR, RESABS, RESASC) BEGIN PROLOGUE  QK61 PURPOSE  To compute I = Integral of F over (A,B) with error\n                           estimate\n                       J = Integral of ABS(F) over (A,B) LIBRARY   SLATEC (QUADPACK) CATEGORY  H2A1A2 TYPE      SINGLE PRECISION (QK61-S, DQK61-D) KEYWORDS  61-POINT GAUSS-KRONROD RULES, QUADPACK, QUADRATURE AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Integration rule Standard fortran subroutine Real version PARAMETERS ON ENTRY F - Real Function subprogram defining the integrand function F ( X ) . The actual name for F needs to be declared E X T E R N A L in the calling program . A - Real Lower limit of integration B - Real Upper limit of integration ON RETURN RESULT - Real Approximation to the integral I RESULT is computed by applying the 61 - point Kronrod rule ( RESK ) obtained by optimal addition of abscissae to the 30 - point Gauss rule ( RESG ) . ABSERR - Real Estimate of the modulus of the absolute error , which should equal or exceed ABS ( I - RESULT ) RESABS - Real Approximation to the integral J RESASC - Real Approximation to the integral of ABS ( F - I / ( B - A )) REFERENCES  (NONE) ROUTINES CALLED  R1MACH REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB) END PROLOGUE  QK61 **FIRST EXECUTABLE STATEMENT  QK61 Arguments Type Intent Optional Attributes Name real :: F real :: A real :: B real :: RESULT real :: ABSERR real :: RESABS real :: RESASC","tags":"","url":"proc/qk61.html"},{"title":"Dipole_kb_pwscf_def_dim – Yambo","text":"subroutine Dipole_kb_pwscf_def_dim() Uses R_lattice wave_func pseudo D_lattice pars electrons Arguments None","tags":"","url":"proc/dipole_kb_pwscf_def_dim.html"},{"title":"SC_start_and_restart – Yambo","text":"subroutine SC_start_and_restart(X, E, Xk, Dip) Uses R_lattice pars com DIPOLES parser_m QP_m X_m IO_m SC UNITS collision_ext descriptors drivers hamiltonian FFT_m electrons IO_int Arguments Type Intent Optional Attributes Name type( X_t ) :: X (2) type( levels ) :: E type( bz_samp ) :: Xk type( DIPOLE_t ) :: Dip","tags":"","url":"proc/sc_start_and_restart.html"},{"title":"electrons_spin_and_magn_interpolate – Yambo","text":"subroutine electrons_spin_and_magn_interpolate(what, SEED_k, OUT_k, BANDS_range, ID_spin, ID_magn) Uses pars electrons R_lattice interpolate Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: what type( bz_samp ), intent(in) :: SEED_k type( bz_samp ), intent(inout) :: OUT_k integer, intent(in) :: BANDS_range (2) integer, intent(out) :: ID_spin integer, intent(out) :: ID_magn","tags":"","url":"proc/electrons_spin_and_magn_interpolate.html"},{"title":"MATRIX_transfer_side_crop – Yambo","text":"subroutine MATRIX_transfer_side_crop(I, J, O) Arguments Type Intent Optional Attributes Name integer :: I (2) integer :: J (2) integer :: O (2)","tags":"","url":"proc/matrix_transfer_side_crop.html"},{"title":"C_driver_transfer – Yambo","text":"subroutine C_driver_transfer() Uses C_driver Arguments None","tags":"","url":"proc/c_driver_transfer.html"},{"title":"RT_update_TIME_CONF_descriptions – Yambo","text":"subroutine RT_update_TIME_CONF_descriptions() Uses RT_control RT_output_m stderr descriptors UNITS RT_lifetimes real_time Arguments None","tags":"","url":"proc/rt_update_time_conf_descriptions.html"},{"title":"el_density_of_states – Yambo","text":"subroutine el_density_of_states(Xk, Xen, dos_E, DOS_broadening, DOS_bands, dos_value, USE_the_DbGd, USE_Eo, USE_W, USE_occupations, WF_fac, PDOS_fac) Uses R_lattice D_lattice functions pars electrons Arguments Type Intent Option