:: RT_lifetime Components Type Visibility Attributes Name Initial logical, public :: active = .FALSE. character(len=schlen), public :: KIND = \"none\" integer, public :: D1 (2) = 0 integer, public :: D2 = 0 real(kind=SP), public, allocatable :: abs (:,:) real(kind=SP), public, allocatable :: emit (:,:) real(kind=SP), public, allocatable :: abs_save (:,:,:) real(kind=SP), public, allocatable :: emit_save (:,:,:) real(kind=SP), public :: prefactor (2) = rZERO real(kind=SP), public :: mean (2) = rZERO real(kind=SP), public :: Tfit (2) = rZERO","tags":"","url":"type/rt_lifetime.html"},{"title":"RT_obj_lifetime – Yambo ","text":"type, public :: RT_obj_lifetime Components Type Visibility Attributes Name Initial logical, public :: active = .FALSE. character(len=schlen), public :: KIND = \"none\" integer, public :: D = 0 real(kind=SP), public, allocatable :: abs (:) real(kind=SP), public, allocatable :: emit (:) real(kind=SP), public, allocatable :: abs_bare (:) real(kind=SP), public, allocatable :: emit_bare (:)","tags":"","url":"type/rt_obj_lifetime.html"},{"title":"io_BS_PAR_block – Yambo","text":"subroutine io_BS_PAR_block(iq, i_block, ID, mode) Uses stderr BS pars IO_m timing_m iso_c_binding IO_int Arguments Type Intent Optional Attributes Name integer, intent(in) :: iq integer, intent(in) :: i_block integer, intent(in) :: ID character(len=*), intent(in) :: mode","tags":"","url":"proc/io_bs_par_block.html"},{"title":"K_multiply_by_V_slepc – Yambo","text":"subroutine K_multiply_by_V_slepc(slepc_mat, vi, vo, ierr) Uses parallel_m slepcsysdef pars petscmat BS_solvers petscmatdef BS slepcsys Arguments Type Intent Optional Attributes Name real :: slepc_mat real :: vi real :: vo integer :: ierr","tags":"","url":"proc/k_multiply_by_v_slepc.html"},{"title":"a2y_kb_pp – Yambo","text":"subroutine a2y_kb_pp(ikibz, ncid) Uses wave_func pseudo D_lattice netcdf_data pars netcdf Arguments Type Intent Optional Attributes Name integer, intent(in) :: ikibz integer, intent(in) :: ncid","tags":"","url":"proc/a2y_kb_pp.html"},{"title":"a2y_kb_pp_wfk – Yambo","text":"subroutine a2y_kb_pp_wfk(ikibz, i_sp_pol, ncid) Uses wave_func pseudo D_lattice netcdf_data pars netcdf vec_operate Arguments Type Intent Optional Attributes Name integer, intent(in) :: ikibz integer, intent(in) :: i_sp_pol integer, intent(in) :: ncid","tags":"","url":"proc/a2y_kb_pp_wfk.html"},{"title":"BESK1E – Yambo","text":"function BESK1E(X) BEGIN PROLOGUE  BESK1E PURPOSE  Compute the exponentially scaled modified (hyperbolic)\n            Bessel function of the third kind of order one. LIBRARY   SLATEC (FNLIB) CATEGORY  C10B1 TYPE      SINGLE PRECISION (BESK1E-S, DBSK1E-D) KEYWORDS  EXPONENTIALLY SCALED, FNLIB, HYPERBOLIC BESSEL FUNCTION,\n             MODIFIED BESSEL FUNCTION, ORDER ONE, SPECIAL FUNCTIONS,\n             THIRD KIND AUTHOR  Fullerton, W., (LANL) DESCRIPTION BESK1E(X) computes the exponentially scaled modified (hyperbolic)\n Bessel function of third kind of order one for real argument\n X .GT. 0.0, i.e., EXP(X)*K1(X). Series for BK1        on the interval  0.          to  4.00000D+00\n                                        with weighted error   7.02E-18\n                                         log weighted error  17.15\n                               significant figures required  16.73\n                                    decimal places required  17.67 Series for AK1        on the interval  1.25000D-01 to  5.00000D-01\n                                        with weighted error   6.06E-17\n                                         log weighted error  16.22\n                               significant figures required  15.41\n                                    decimal places required  16.83 Series for AK12       on the interval  0.          to  1.25000D-01\n                                        with weighted error   2.58E-17\n                                         log weighted error  16.59\n                               significant figures required  15.22\n                                    decimal places required  17.16 REFERENCES  (NONE) ROUTINES CALLED  BESI1, CSEVL, INITS, R1MACH, XERMSG REVISION HISTORY  (YYMMDD)\n   770401  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   900326  Removed duplicate information from DESCRIPTION section.\n           (WRB) END PROLOGUE  BESK1E\n**FIRST EXECUTABLE STATEMENT  BESK1E Arguments Type Intent Optional Attributes Name real :: X Return Value real","tags":"","url":"proc/besk1e.html"},{"title":"RT_Glesser_rotate – Yambo","text":"subroutine RT_Glesser_rotate(dG) Uses pars real_time Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: dG (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2),RT_nk)","tags":"","url":"proc/rt_glesser_rotate.html"},{"title":"fix_symmetries – Yambo","text":"subroutine fix_symmetries(old_nsym, old_dl_sop, old_sop_inv, S_contains_TR) Uses R_lattice stderr D_lattice matrix_operate pars com parser_m YPPm vec_operate electrons Remove Symmetries  * First replace (or remove) Time reversal Arguments Type Intent Optional Attributes Name integer, intent(out) :: old_nsym real(kind=SP), intent(out) :: old_dl_sop (3,3,nsym) integer, intent(out) :: old_sop_inv (nsym) integer(kind=LP), intent(out) :: S_contains_TR (nsym)","tags":"","url":"proc/fix_symmetries.html"},{"title":"atoms_check_symm – Yambo","text":"subroutine atoms_check_symm(symm_to_check, n_syms_to_check, found_symm) Uses matrix_operate pars D_lattice Arguments Type Intent Optional Attributes Name real(kind=SP) :: symm_to_check (3,3,n_syms_to_check) integer :: n_syms_to_check logical :: found_symm","tags":"","url":"proc/atoms_check_symm.html"},{"title":"ELPH_databases_IO_pol_and_freqs – Yambo","text":"subroutine ELPH_databases_IO_pol_and_freqs(IDB) Uses D_lattice YPP_ELPH pars UNITS vec_operat