{"title":"RT_Rabi_frequency_ALL_and_print – Yambo","text":"subroutine RT_Rabi_frequency_ALL_and_print(En, i_field) Uses parallel_m R_lattice OUTPUT pars DIPOLES X_m UNITS vec_operate fields electrons real_time Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: En integer, intent(in) :: i_field","tags":"","url":"proc/rt_rabi_frequency_all_and_print.html"},{"title":"RT_build_T1_and_T2 – Yambo","text":"subroutine RT_build_T1_and_T2(ik, T1_k, T2_k, I1_matrix, dT) Uses pars real_time Arguments Type Intent Optional Attributes Name integer, intent(in) :: ik complex(kind=SP), intent(out) :: T1_k (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) complex(kind=SP), intent(out) :: T2_k (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) complex(kind=SP), intent(in) :: I1_matrix (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) real(kind=SP), intent(in) :: dT","tags":"","url":"proc/rt_build_t1_and_t2.html"},{"title":"io_NL – Yambo","text":"function io_NL(what, ID) Uses RT_control stderr pars nl_optics IO_m UNITS fields real_time IO_int Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: what integer, intent(in) :: ID Return Value integer","tags":"","url":"proc/io_nl.html"},{"title":"PARALLEL_global_ScaLapacK – Yambo","text":"subroutine PARALLEL_global_ScaLapacK() Uses linear_algebra parallel_m parallel_int SLK_m Arguments None","tags":"","url":"proc/parallel_global_scalapack.html"},{"title":"COLLISIONS_momentum – Yambo","text":"subroutine COLLISIONS_momentum(E, k, q) Uses parallel_m COLL_interfaces R_lattice parallel_int collision_el wave_func pars com collision_ext QP_m IO_m timing_m LIVE_t electrons interfaces Arguments Type Intent Optional Attributes Name type( levels ) :: E type( bz_samp ) :: k type( bz_samp ) :: q","tags":"","url":"proc/collisions_momentum.html"},{"title":"ELPH_databases_load – Yambo","text":"subroutine ELPH_databases_load(GKKP_sq, E, k, q, n_bands, q_range, K_mode, SCATT_mode) Uses parallel_m R_lattice ELPH ALLOC pars IO_m LIVE_t parallel_int electrons IO_int Arguments Type Intent Optional Attributes Name type( GKKP_me ), intent(inout) :: GKKP_sq type( levels ), intent(in) :: E type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: q integer, intent(in) :: n_bands (2) integer, intent(in) :: q_range (2) character(len=*), intent(in) :: K_mode character(len=*), intent(in) :: SCATT_mode","tags":"","url":"proc/elph_databases_load.html"},{"title":"BESK0 – Yambo","text":"function BESK0(X) BEGIN PROLOGUE  BESK0 PURPOSE  Compute the modified (hyperbolic) Bessel function of the\n            third kind of order zero. LIBRARY   SLATEC (FNLIB) CATEGORY  C10B1 TYPE      SINGLE PRECISION (BESK0-S, DBESK0-D) KEYWORDS  FNLIB, HYPERBOLIC BESSEL FUNCTION,\n             MODIFIED BESSEL FUNCTION, ORDER ZERO, SPECIAL FUNCTIONS,\n             THIRD KIND AUTHOR  Fullerton, W., (LANL) DESCRIPTION BESK0(X) calculates the modified (hyperbolic) Bessel function\n of the third kind of order zero for real argument X .GT. 0.0. Series for BK0        on the interval  0.          to  4.00000D+00\n                                        with weighted error   3.57E-19\n                                         log weighted error  18.45\n                               significant figures required  17.99\n                                    decimal places required  18.97 REFERENCES  (NONE) ROUTINES CALLED  BESI0, BESK0E, CSEVL, INITS, R1MACH, XERMSG REVISION HISTORY  (YYMMDD)\n   770401  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   900326  Removed duplicate information from DESCRIPTION section.\n           (WRB) END PROLOGUE  BESK0\n**FIRST EXECUTABLE STATEMENT  BESK0 Arguments Type Intent Optional Attributes Name real :: X Return Value real","tags":"","url":"proc/besk0.html"},{"title":"EPS_2_trasmission_and_reflection – Yambo","text":"function EPS_2_trasmission_and_reflection() Uses pars Arguments None Return Value real(kind=SP)","tags":"","url":"proc/eps_2_trasmission_and_reflection.html"},{"title":"k_grid_printer – Yambo","text":"subroutine k_grid_printer(nk, k, coo_in, form, wk, coo_out) Uses stderr pars com parser_m vec_operate YPPm LIVE_t Arguments Type Intent Optional Attributes Name integer :: nk real(kind=SP) :: k (nk,3) character(len=*) :: coo_in character(len=*) :: form real(kind=SP), optional :: wk (nk) character(len=*), optional :: coo_out","tags":"","url":"proc/k_grid_printer.html"},{"title":"FREQUENCIES_setup – Yambo","text":"subroutine FREQUENCIES_setup(W) Uses parser_m pars frequency Arguments Type Intent Optional Attributes Name type( w_samp ) :: W","tags":"","url":"proc/frequencies_setup.html"},{"title":"PROJECTION_k_on_the_path_or_plane – Yambo","text":"function PROJECTION_k_on_the_path_or_plane(ik) Uses YPPm Arguments Type Intent Optional Attributes Name integer :: ik Return Value integer","tags":"","url":"proc/projection_k_on_the_path_or_plane.html"},{"title":"electrons_driver – Yambo","text":"subroutine electrons_driver(Xk, Xen, Xq) Uses R_lattice parallel_int wave_func YPP_interfaces stderr interpolate QP_m YPPm FFT_m electrons xc_functionals interfaces Arguments Type Intent Optional Attributes Name type( bz_samp ) :: Xk type( levels ) :: Xen type( bz_samp ) :: Xq","tags":"","url":"proc/electrons_driver.html"},{"title":"PARALLEL_global_BZINDX – Yambo","text":"subroutine PARALLEL_global_BZINDX(E, Xk, q, ENVIRONMENT) Uses parallel_m R_lattice parallel_int openmp electrons IO_int Arguments Type Intent Optional Attributes Name type( levels ) :: E type( bz_samp ) :: Xk type( bz_samp ) :: q character(len=*) :: ENVIRONMENT","tags":"","url":"proc/parallel_global_bzindx.html"},{"title":"Pseudo_Hamiltonian – Yambo","text":"subroutine Pseudo_Hamiltonian(Xk, Xen, l_equilibrium) Uses R_lattice parallel_int wave_func pseudo D_lattice pars IO_int IO_m LIVE_t timing_m drivers hamiltonian FFT_m electrons interfaces wrapper Arguments Type Intent Optional Attributes Name type( bz_samp ) :: Xk type( levels ) :: Xen logical :: l_equilibrium","tags":"","url":"proc/pseudo_hamiltonian.html"},{"title":"V_mean_potential – Yambo","text":"subroutine V_mean_potential(ik, i_sp_pol, WFo) Uses wave_func pars SC hamiltonian FFT_m wrapper Arguments Type Intent Optional Attributes Name integer :: ik integer :: i_sp_pol type( WAVEs ) :: WFo","tags":"","url":"proc/v_mean_potential.html"},{"title":"io_BS_header – Yambo","text":"function io_BS_header(iq, X, ID, mode) Uses parallel_m stderr pars com X_m IO_m descriptors BS_solvers BS parallel_int IO_int Arguments Type Intent Optional Attributes Name integer :: iq type( X_t ) :: X integer :: ID character(len=*), intent(in) :: mode Return Value integer","tags":"","url":"proc/io_bs_header.html"},{"title":"DPOLFT – Yambo","text":"subroutine DPOLFT(N, X, Y, W, MAXDEG, NDEG, EPS, R, IERR, A) BEGIN PROLOGUE  DPOLFT PURPOSE  Fit discrete data in a least squares sense by polynomials\n            in one variable. LIBRARY   SLATEC CATEGORY  K1A1A2 TYPE      DOUBLE PRECISION (POLFIT-S, DPOLFT-D) KEYWORDS  CURVE FITTING, DATA FITTING, LEAST SQUARES, POLYNOMIAL FIT AUTHOR  Shampine, L. F., (SNLA)\n           Davenport, S. M., (SNLA)\n           Huddleston, R. E., (SNLL) DESCRIPTION Abstract Given a collection of points X ( I ) and a set of values Y ( I ) which correspond to some function or measurement at each of the X ( I ), subroutine DPOLFT computes the weighted least - squares polynomial fits of all degrees up to some degree either specified by the user or determined by the routine . The fits thus obtained are in orthogonal polynomial form . Subroutine DP1VLU may then be called to evaluate the fitted polynomials and any of their derivatives at any point . The subroutine DPCOEF may be used to express the polynomial fits as powers of ( X - C ) for any specified point C . The parameters for DPOLFT are Input -- All TYPE REAL variables are DOUBLE PRECISION N - the number of data points . The arrays X , Y and W must be dimensioned at least N ( N . GE . 1 ) . X - array of values of the independent variable . These values may appear in any order and need not all be distinct . Y - array of corresponding function values . W - array of positive values to be used as weights . If W ( 1 ) is negative , DPOLFT will set all the weights to 1.0 , which means unweighted least squares error will be minimized . To minimize relative error , the user should set the weights to : W ( I ) = 1.0 / Y ( I ) ** 2 , I = 1 , ... , N . MAXDEG - maximum degree to be allowed for polynomial fit . MAXDEG may be any non - negative integer less than N . Note -- MAXDEG cannot be equal to N - 1 when a statistical test is to be used for degree selection , i . e . , when input value of EPS is negative . EPS - specifies the criterion to be used in determining the degree of fit to be computed . ( 1 ) If EPS is input negative , DPOLFT chooses the degree based on a statistical F test of significance . One of three possible significance levels will be used : . 01 , . 05 or . 10. If EPS =- 1.0 , the routine will automatically select one of these levels based on the number of data points and the maximum degree to be considered . If EPS is input as -. 01 , -. 05 , or -. 10 , a significance level of . 01 , . 05 , or . 10 , respectively , will be used . ( 2 ) If EPS is set to 0. , DPOLFT computes the polynomials of degrees 0 through MAXDEG . ( 3 ) If EPS is input positive , EPS is the RMS error tolerance which must be satisfied by the fitted polynomial . DPOLFT will increase the degree of fit until this criterion is met or until the maximum degree is reached . Output -- All TYPE REAL variables are DOUBLE PRECISION NDEG - degree of the highest degree fit computed . EPS - RMS error of the polynomial of degree NDEG . R - vector of dimension at least NDEG containing values of the fit of degree NDEG at each of the X ( I ) . Except when the statistical test is used , these values are more accurate than results from subroutine DP1VLU normally are . IERR - error flag with the following possible values . 1 -- indicates normal execution , i . e . , either ( 1 ) the input value of EPS was negative , and the computed polynomial fit of degree NDEG satisfies the specified F test , or ( 2 ) the input value of EPS was 0. , and the fits of all degrees up to MAXDEG are complete , or ( 3 ) the input value of EPS was positive , and the polynomial of degree NDEG satisfies the RMS error requirement . 2 -- invalid input parameter . At least one of the input parameters has an illegal value and must be corrected before DPOLFT can proceed . Valid input results when the following restrictions are observed N . GE . 1 0 . LE . MAXDEG . LE . N - 1 for EPS . GE . 0. 0 . LE . MAXDEG . LE . N - 2 for EPS . LT . 0. W ( 1 ) =- 1.0 or W ( I ) . GT . 0. , I = 1 , ... , N . 3 -- cannot satisfy the RMS error requirement with a polynomial of degree no greater than MAXDEG . Best fit found is of degree MAXDEG . 4 -- cannot satisfy the test for significance using current value of MAXDEG . Statistically , the best fit found is of order NORD . ( In this case , NDEG will have one of the values : MAXDEG - 2 , MAXDEG - 1 , or MAXDEG ) . Using a higher value of MAXDEG may result in passing the test . A - work and output array having at least 3 N + 3 MAXDEG + 3 locations Note - DPOLFT calculates all fits of degrees up to and including NDEG . Any or all of these fits can be evaluated or expressed as powers of ( X - C ) using DP1VLU and DPCOEF after just one call to DPOLFT . REFERENCES  L. F. Shampine, S. M. Davenport and R. E. Huddleston,\n                 Curve fitting by polynomials in one variable, Report\n                 SLA-74-0270, Sandia Laboratories, June 1974. ROUTINES CALLED  DP1VLU, XERMSG REVISION HISTORY  (YYMMDD)\n   740601  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   891006  Cosmetic changes to prologue.  (WRB)\n   891006  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   900911  Added variable YP to DOUBLE PRECISION declaration.  (WRB)\n   920501  Reformatted the REFERENCES section.  (WRB)\n   920527  Corrected erroneous statements in DESCRIPTION.  (WRB) END PROLOGUE  DPOLFT\n**FIRST EXECUTABLE STATEMENT  DPOLFT Arguments Type Intent Optional Attributes Name integer :: N double precision :: X (*) double precision :: Y (*) double precision :: W (*) integer :: MAXDEG integer :: NDEG double precision :: EPS double precision :: R (*) integer :: IERR double precision :: A (*)","tags":"","url":"proc/dpolft.html"},{"title":"RT_Observables – Yambo","text":"subroutine RT_Observables(en, k, dG_lesser, OBSERVABLES) Uses R_lattice pars timing_m fields electrons real_time Arguments Type Intent Optional Attributes Name type( levels ), intent(inout) :: en type( bz_samp ), intent(in) :: k complex(kind=SP), intent(in) :: dG_lesser (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2),RT_nk) real(kind=SP), intent(inout) :: OBSERVABLES (25)","tags":"","url":"proc/rt_observables.html"},{"title":"QP_life_transitions – Yambo","text":"function QP_life_transitions(iqibz_in, E, k, q, X_life_W) Uses R_lattice pars frequency QP_m electrons Arguments Type Intent Optional Attributes Name integer :: iqibz_in type( levels ) :: E type( bz_samp ) :: k type( bz_samp ) :: q type( w_samp ) :: X_life_W Return Value integer","tags":"","url":"proc/qp_life_transitions.html"},{"title":"RT_MEMORY_index – Yambo","text":"subroutine RT_MEMORY_index() Uses real_time Arguments None","tags":"","url":"proc/rt_memory_index.html"},{"title":"errore – Yambo","text":"subroutine errore(calling_routine, message, ierr) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: calling_routine character(len=*), intent(in) :: message integer, intent(in) :: ierr","tags":"","url":"proc/errore.html"},{"title":"qe_erf – Yambo","text":"function qe_erf(x) Uses kinds Arguments Type Intent Optional Attributes Name real(kind=DP), intent(in) :: x Return Value real(kind=DP)","tags":"","url":"proc/qe_erf~2.html"},{"title":"qe_erfc – Yambo","text":"function qe_erfc(x) Uses kinds Arguments Type Intent Optional Attributes Name real(kind=DP), intent(in) :: x Return Value real(kind=DP)","tags":"","url":"proc/qe_erfc~2.html"},{"title":"gauss_freq – Yambo","text":"function gauss_freq(x) Uses kinds Arguments Type Intent Optional Attributes Name real(kind=DP), intent(in) :: x Return Value real(kind=DP)","tags":"","url":"proc/gauss_freq.html"},{"title":"PARSER_array – Yambo","text":"subroutine PARSER_array(mode, VAR, N, M, DESC, CH_v, R_v, I_v, Kn) Uses stderr pars it_m parser_m Arguments Type Intent Optional Attributes Name character(len=*) :: mode character(len=*) :: VAR integer :: N integer :: M character(len=*), optional :: DESC character(len=*), optional :: CH_v (N,M) real(kind=SP), optional :: R_v (N,M) integer, optional :: I_v (N,M) character(len=1), optional :: Kn (M)","tags":"","url":"proc/parser_array.html"},{"title":"DIPOLE_IO – Yambo","text":"subroutine DIPOLE_IO(Xk, Xen, Dip, check_read_or_write, io_err, PAR_K_scheme_kind) Uses parallel_m R_lattice stderr pars com DIPOLES parser_m IO_m parallel_int electrons IO_int Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: Xk type( levels ), intent(in) :: Xen type( DIPOLE_t ), intent(inout) :: Dip character(len=*), intent(in) :: check_read_or_write integer, intent(out) :: io_err character(len=*), intent(in) :: PAR_K_scheme_kind","tags":"","url":"proc/dipole_io.html"},{"title":"io_full_SYMMs – Yambo","text":"function io_full_SYMMs(k, ID) Uses R_lattice D_lattice pars IO_m IO_int Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: k integer, intent(in) :: ID Return Value integer","tags":"","url":"proc/io_full_symms.html"},{"title":"SC_add_XC – Yambo","text":"subroutine SC_add_XC(X, Xw, Xk, E, k, q, iteration, V_xc_nm1, ELEC, HOLE, DELTA) Uses parallel_m R_lattice pars frequency QP_m X_m SC drivers hamiltonian FFT_m electrons xc_functionals IO_int Arguments Type Intent Optional Attributes Name type( X_t ) :: X (2) type( w_samp ) :: Xw (2) type( bz_samp ) :: Xk type( levels ) :: E type( bz_samp ) :: k type( bz_samp ) :: q integer :: iteration real(kind=SP) :: V_xc_nm1 (fft_size,n_spin) real(kind=SP) :: ELEC real(kind=SP) :: HOLE real(kind=SP) :: DELTA","tags":"","url":"proc/sc_add_xc.html"},{"title":"k_the_nearest – Yambo","text":"function k_the_nearest(k_ref, k, n_k, k_dist, ROTATE_k_ref, k_symm, i_err, border_point) Uses pars R_lattice vec_operate D_lattice Arguments Type Intent Optional Attributes Name real(kind=SP), intent(in) :: k_ref (3) real(kind=SP), intent(in) :: k (n_k,3) integer, intent(in) :: n_k real(kind=SP), intent(out), optional :: k_dist (n_k) logical, intent(in), optional :: ROTATE_k_ref integer, intent(out), optional :: k_symm integer, intent(out), optional :: i_err logical, intent(out), optional :: border_point Return Value integer","tags":"","url":"proc/k_the_nearest.html"},{"title":"RT_transient_absorption – Yambo","text":"subroutine RT_transient_absorption(Xen, Xk, Xq) Uses parallel_m R_lattice interpolate com X_m YPP_real_time vec_operate YPPm parallel_int real_time stderr pars frequency RT_control IO_m drivers BS LIVE_t electrons Arguments Type Intent Optional Attributes Name type( levels ) :: Xen type( bz_samp ) :: Xk type( bz_samp ) :: Xq","tags":"","url":"proc/rt_transient_absorption.html"},{"title":"ELPH_general_gFsq – Yambo","text":"subroutine ELPH_general_gFsq(k, en, Xk, Xen, q, BS_E_degs) Uses parallel_m R_lattice ELPH com QP_m BS_solvers YPPm parallel_int ALLOC stderr YPP_ELPH functions IO_int pars frequency IO_m UNITS BS LIVE_t electrons Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k type( levels ) :: en type( bz_samp ) :: Xk type( levels ) :: Xen type( bz_samp ) :: q integer, optional :: BS_E_degs (BSS_n_eig)","tags":"","url":"proc/elph_general_gfsq.html"},{"title":"K_eps_interpolate – Yambo","text":"subroutine K_eps_interpolate(nW, W, err) Uses pars vec_operate POL_FIT_m X_m Arguments Type Intent Optional Attributes Name integer :: nW real(kind=SP) :: W (nW) integer :: err (nW)","tags":"","url":"proc/k_eps_interpolate.html"},{"title":"QP_state_print – Yambo","text":"subroutine QP_state_print(qp) Uses stderr pars com QP_m descriptors Arguments Type Intent Optional Attributes Name type( QP_t ), optional :: qp","tags":"","url":"proc/qp_state_print.html"},{"title":"DBESI0 – Yambo","text":"function DBESI0(X) BEGIN PROLOGUE  DBESI0 PURPOSE  Compute the hyperbolic Bessel function of the first kind\n            of order zero. LIBRARY   SLATEC (FNLIB) CATEGORY  C10B1 TYPE      DOUBLE PRECISION (BESI0-S, DBESI0-D) KEYWORDS  FIRST KIND, FNLIB, HYPERBOLIC BESSEL FUNCTION,\n             MODIFIED BESSEL FUNCTION, ORDER ZERO, SPECIAL FUNCTIONS AUTHOR  Fullerton, W., (LANL) DESCRIPTION DBESI0(X) calculates the double precision modified (hyperbolic)\n Bessel function of the first kind of order zero and double\n precision argument X. Series for BI0        on the interval  0.          to  9.00000E+00\n                                        with weighted error   9.51E-34\n                                         log weighted error  33.02\n                               significant figures required  33.31\n                                    decimal places required  33.65 REFERENCES  (NONE) ROUTINES CALLED  D1MACH, DBSI0E, DCSEVL, INITDS, XERMSG REVISION HISTORY  (YYMMDD)\n   770701  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ) END PROLOGUE  DBESI0\n**FIRST EXECUTABLE STATEMENT  DBESI0 Arguments Type Intent Optional Attributes Name double precision :: X Return Value doubleprecision","tags":"","url":"proc/dbesi0.html"},{"title":"fft_desc_init – Yambo","text":"subroutine fft_desc_init(n, iGo_max, dfft) Uses parallel_m R_lattice fft_types D_lattice pars stick_set fft_scalar Arguments Type Intent Optional Attributes Name integer, intent(in) :: n (3) integer, intent(in) :: iGo_max type(fft_dlay_descriptor) :: dfft","tags":"","url":"proc/fft_desc_init.html"},{"title":"bessel_J0 – Yambo","text":"function bessel_J0(s) Uses pars R_lattice Arguments Type Intent Optional Attributes Name real(kind=SP) :: s Return Value real(kind=SP)","tags":"","url":"proc/bessel_j0.html"},{"title":"K_driver – Yambo","text":"subroutine K_driver(Xen, Ken, Xk, q, X_static_pp, Xw, Dip) Uses parallel_m R_lattice stderr pars com DIPOLES frequency X_m IO_m BS_solvers vec_operate drivers TDDFT BS parallel_int electrons interfaces IO_int Arguments Type Intent Optional Attributes Name type( levels ) :: Xen type( levels ) :: Ken type( bz_samp ) :: Xk type( bz_samp ) :: q type( X_t ) :: X_static_pp type( w_samp ) :: Xw type( DIPOLE_t ) :: Dip","tags":"","url":"proc/k_driver.html"},{"title":"REPORT_Occupations – Yambo","text":"subroutine REPORT_Occupations(what, E) Uses D_lattice pars com UNITS drivers electrons interfaces Arguments Type Intent Optional Attributes Name character(len=*) :: what type( levels ) :: E","tags":"","url":"proc/report_occupations.html"},{"title":"DIPOLE_setup – Yambo","text":"subroutine DIPOLE_setup(Dip) Uses stderr DIPOLES parser_m IO_m drivers BS electrons Arguments Type Intent Optional Attributes Name type( DIPOLE_t ), intent(inout) :: Dip","tags":"","url":"proc/dipole_setup.html"},{"title":"XC_eval_gga_potential – Yambo","text":"subroutine XC_eval_gga_potential(v1rho, v1sigma, drho, V_xc) Uses R_lattice D_lattice pars QP_m FFT_m electrons xc_functionals Arguments Type Intent Optional Attributes Name real(kind=DP), intent(in) :: v1rho (n_spin,fft_size) real(kind=DP), intent(in) :: v1sigma (xc_spin(1),fft_size) real(kind=SP), intent(in) :: drho (fft_size,n_spin,3) real(kind=SP), intent(inout) :: V_xc (fft_size,n_spin)","tags":"","url":"proc/xc_eval_gga_potential.html"},{"title":"el_density_vbands – Yambo","text":"subroutine el_density_vbands(en, Xk, rho, VAL_BANDS) Uses parallel_m R_lattice parallel_int D_lattice pars FFT_m electrons Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: en type( bz_samp ), intent(in) :: Xk real(kind=SP), intent(out) :: rho (fft_size) complex(kind=SP), intent(in) :: VAL_BANDS (fft_size,maxval(en%nbf),PAR_Xk_nibz,n_sp_pol)","tags":"","url":"proc/el_density_vbands.html"},{"title":"NL_build_dG_lesser – Yambo","text":"subroutine NL_build_dG_lesser(en, V_bands, dG) Uses parallel_m wrapper_omp pars nl_optics QP_m parallel_int electrons @brief Calculate the density matrix variation \\Delta \\rho_{ij} @param[in]       V_bands                     time-dependent valence bands\n@param[in]       en                          energies array @param[out]      dG                          \\Delta G-lesser diagonal part = -i\\rho Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: en complex(kind=SP), intent(in) :: V_bands (NL_bands(2),maxval(en%nbf),QP_nk,n_sp_pol) complex(kind=SP), intent(out) :: dG (NL_bands(1):NL_bands(2),NL_bands(1):NL_bands(2),QP_nk)","tags":"","url":"proc/nl_build_dg_lesser.html"},{"title":"RT_OBSERVABLES_IO – Yambo","text":"subroutine RT_OBSERVABLES_IO(what, Curr, Pol, IO_error, first_sec_only, G_lesser_only, COM_) Uses RT_control R_lattice pars IO_m YPP_real_time fields real_time IO_int Arguments Type Intent Optional Attributes Name character(len=*) :: what type( OBS_el ), optional :: Curr type( OBS_el ), optional :: Pol logical, optional :: IO_error logical, optional :: first_sec_only logical, optional :: G_lesser_only integer, optional :: COM_","tags":"","url":"proc/rt_observables_io.html"},{"title":"K_OUTPUT – Yambo","text":"subroutine K_OUTPUT(iq, W, WHAT, OBS) Uses R_lattice stderr pars com DIPOLES frequency X_m PHOTOLUM BS_solvers UNITS drivers BS electrons Arguments Type Intent Optional Attributes Name integer :: iq type( w_samp ) :: W character(len=*) :: WHAT character(len=*) :: OBS","tags":"","url":"proc/k_output.html"},{"title":"K_components_folded_in_serial_arrays – Yambo","text":"subroutine K_components_folded_in_serial_arrays(iq) Uses parallel_m DICHROISM PHOTOLUM LIVE_t BS_solvers timing_m BS parallel_int MAGNONS Arguments Type Intent Optional Attributes Name integer :: iq","tags":"","url":"proc/k_components_folded_in_serial_arrays.html"},{"title":"COLLISIONS_compose_sc – Yambo","text":"subroutine COLLISIONS_compose_sc(G_sex, G_coh) Uses parallel_m pars collision_ext QP_m timing_m drivers parallel_int Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: G_sex (COLL_bands(1):COLL_bands(2),COLL_bands(1):COLL_bands(2),QP_nk) complex(kind=SP), intent(in) :: G_coh (COLL_bands(1):COLL_bands(2),COLL_bands(1):COLL_bands(2),QP_nk)","tags":"","url":"proc/collisions_compose_sc.html"},{"title":"ELPH_simmetrize_and_distribute_gsqF – Yambo","text":"subroutine ELPH_simmetrize_and_distribute_gsqF(en) Uses parallel_m R_lattice ELPH QP_m LIVE_t parallel_int electrons Arguments Type Intent Optional Attributes Name type( levels ) :: en","tags":"","url":"proc/elph_simmetrize_and_distribute_gsqf.html"},{"title":"PARSER_convert_REAL – Yambo","text":"subroutine PARSER_convert_REAL(rfac, v_descr) Uses pars UNITS Arguments Type Intent Optional Attributes Name real(kind=SP) :: rfac character(len=*) :: v_descr","tags":"","url":"proc/parser_convert_real.html"},{"title":"RT_manual_excitation – Yambo","text":"subroutine RT_manual_excitation(E_RT, k, do_kpt, SUCCESS) Uses R_lattice stderr D_lattice pars com YPP_real_time UNITS electrons real_time Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: E_RT type( bz_samp ), intent(in) :: k logical, intent(in) :: do_kpt (RT_carriers%nk) logical, intent(out) :: SUCCESS","tags":"","url":"proc/rt_manual_excitation.html"},{"title":"CGEMM_omp – Yambo","text":"subroutine CGEMM_omp(TRANSA, TRANSB, M, N, K, ALPHA, A, LDA, B, LDB, BETA, C, LDC) Arguments Type Intent Optional Attributes Name character(len=1) :: TRANSA character(len=1) :: TRANSB integer :: M integer :: N integer :: K complex :: ALPHA complex :: A (LDA,*) integer :: LDA complex :: B (LDB,*) integer :: LDB complex :: BETA complex :: C (LDC,*) integer :: LDC","tags":"","url":"proc/cgemm_omp.html"},{"title":"NL_current – Yambo","text":"subroutine NL_current(k, E, V_input, NL_J) Uses parallel_m R_lattice D_lattice pars nl_optics DIPOLES X_m QP_m NL_interfaces UNITS fields electrons Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: k type( levels ), intent(in) :: E complex(kind=SP), intent(in) :: V_input (NL_bands(2),maxval(E%nbf),QP_nk,n_sp_pol) complex(kind=SP), intent(out) :: NL_J (6)","tags":"","url":"proc/nl_current.html"},{"title":"K_diago_overlap_matrix – Yambo","text":"subroutine K_diago_overlap_matrix(BS_V_left, BS_V_right, BS_overlap) Uses linear_algebra wrapper_omp pars BS_solvers BS LIVE_t interfaces Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: BS_V_left (BS_H_dim,BSS_n_eig) complex(kind=SP), intent(in) :: BS_V_right (BS_H_dim,BSS_n_eig) complex(kind=SP), intent(out) :: BS_overlap (BSS_n_eig,BSS_n_eig)","tags":"","url":"proc/k_diago_overlap_matrix.html"},{"title":"QAWOE – Yambo","text":"subroutine QAWOE(F, A, B, OMEGA, INTEGR, EPSABS, EPSREL, LIMIT, ICALL, MAXP1, RESULT, ABSERR, NEVAL, IER, LAST, ALIST, BLIST, RLIST, ELIST, IORD, NNLOG, MOMCOM, CHEBMO) BEGIN PROLOGUE  QAWOE PURPOSE  Calculate an approximation to a given definite integral\n               I = Integral of F(X) W(X) over (A,B), where\n                  W(X) = COS(OMEGA X)\n               or W(X) = SIN(OMEGA X),\n            hopefully satisfying the following claim for accuracy\n               ABS(I-RESULT).LE.MAX(EPSABS,EPSREL ABS(I)). LIBRARY   SLATEC (QUADPACK) CATEGORY  H2A2A1 TYPE      SINGLE PRECISION (QAWOE-S, DQAWOE-D) KEYWORDS  AUTOMATIC INTEGRATOR, CLENSHAW-CURTIS METHOD,\n             EXTRAPOLATION, GLOBALLY ADAPTIVE,\n             INTEGRAND WITH OSCILLATORY COS OR SIN FACTOR, QUADPACK,\n             QUADRATURE, SPECIAL-PURPOSE AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Computation of Oscillatory integrals Standard fortran subroutine Real version PARAMETERS ON ENTRY F - Real Function subprogram defining the integrand function F ( X ). The actual name for F needs to be declared E X T E R N A L in the driver program . A - Real Lower limit of integration B - Real Upper limit of integration OMEGA - Real Parameter in the integrand weight function INTEGR - Integer Indicates which of the WEIGHT functions is to be used INTEGR = 1 W ( X ) = COS ( OMEGA * X ) INTEGR = 2 W ( X ) = SIN ( OMEGA * X ) If INTEGR . NE .1 and INTEGR . NE .2 , the routine will end with IER = 6 . EPSABS - Real Absolute accuracy requested EPSREL - Real Relative accuracy requested If EPSABS . LE .0 and EPSREL . LT . MAX ( 50 * REL . MACH . ACC ., 0.5 D - 28 ), the routine will end with IER = 6 . LIMIT - Integer Gives an upper bound on the number of subdivisions in the partition of ( A , B ), LIMIT . GE .1 . ICALL - Integer If QAWOE is to be used only once , ICALL must be set to 1 . Assume that during this call , the Chebyshev moments ( for CLENSHAW - CURTIS integration of degree 24 ) have been computed for intervals of lengths ( ABS ( B - A )) * 2 ** ( - L ), L = 0 , 1 , 2 , ... MOMCOM - 1 . If ICALL . GT .1 this means that QAWOE has been called twice or more on intervals of the same length ABS ( B - A ). The Chebyshev moments already computed are then re - used in subsequent calls . If ICALL . LT .1 , the routine will end with IER = 6 . MAXP1 - Integer Gives an upper bound on the number of Chebyshev moments which can be stored , i . e . for the intervals of lengths ABS ( B - A ) * 2 ** ( - L ), L = 0 , 1 , ... , MAXP1 - 2 , MAXP1 . GE .1 . If MAXP1 . LT .1 , the routine will end with IER = 6 . ON RETURN RESULT - Real Approximation to the integral ABSERR - Real Estimate of the modulus of the absolute error , which should equal or exceed ABS ( I - RESULT ) NEVAL - Integer Number of integrand evaluations IER - Integer IER = 0 Normal and reliable termination of the routine . It is assumed that the requested accuracy has been achieved . - IER . GT .0 Abnormal termination of the routine . The estimates for integral and error are less reliable . It is assumed that the requested accuracy has not been achieved . ERROR MESSAGES IER = 1 Maximum number of subdivisions allowed has been achieved . One can allow more subdivisions by increasing the value of LIMIT ( and taking according dimension adjustments into account ). However , if this yields no improvement it is advised to analyze the integrand , in order to determine the integration difficulties . If the position of a local difficulty can be determined ( e . g . SINGULARITY , DISCONTINUITY within the interval ) one will probably gain from splitting up the interval at this point and calling the integrator on the subranges . If possible , an appropriate special - purpose integrator should be used which is designed for handling the type of difficulty involved . = 2 The occurrence of roundoff error is detected , which prevents the requested tolerance from being achieved . The error may be under - estimated . = 3 Extremely bad integrand behaviour occurs at some points of the integration interval . = 4 The algorithm does not converge . Roundoff error is detected in the extrapolation table . It is presumed that the requested tolerance cannot be achieved due to roundoff in the extrapolation table , and that the returned result is the best which can be obtained . = 5 The integral is probably divergent , or slowly convergent . It must be noted that divergence can occur with any other value of IER . GT .0 . = 6 The input is invalid , because ( EPSABS . LE .0 and EPSREL . LT . MAX ( 50 * REL . MACH . ACC ., 0.5 D - 28 )) or ( INTEGR . NE .1 and INTEGR . NE .2 ) or ICALL . LT .1 or MAXP1 . LT .1 . RESULT , ABSERR , NEVAL , LAST , RLIST ( 1 ), ELIST ( 1 ), IORD ( 1 ) and NNLOG ( 1 ) are set to ZERO . ALIST ( 1 ) and BLIST ( 1 ) are set to A and B respectively . LAST - Integer On return , LAST equals the number of subintervals produces in the subdivision process , which determines the number of significant elements actually in the WORK ARRAYS . ALIST - Real Vector of dimension at least LIMIT , the first LAST elements of which are the left end points of the subintervals in the partition of the given integration range ( A , B ) BLIST - Real Vector of dimension at least LIMIT , the first LAST elements of which are the right end points of the subintervals in the partition of the given integration range ( A , B ) RLIST - Real Vector of dimension at least LIMIT , the first LAST elements of which are the integral approximations on the subintervals ELIST - Real Vector of dimension at least LIMIT , the first LAST elements of which are the moduli of the absolute error estimates on the subintervals IORD - Integer Vector of dimension at least LIMIT , the first K elements of which are pointers to the error estimates over the subintervals , such that ELIST ( IORD ( 1 )), ... , ELIST ( IORD ( K )) form a decreasing sequence , with K = LAST if LAST . LE .( LIMIT / 2 + 2 ), and K = LIMIT + 1 - LAST otherwise . NNLOG - Integer Vector of dimension at least LIMIT , containing the subdivision levels of the subintervals , i . e . IWORK ( I ) = L means that the subinterval numbered I is of length ABS ( B - A ) * 2 ** ( 1 - L ) ON ENTRY AND RETURN MOMCOM - Integer Indicating that the Chebyshev moments have been computed for intervals of lengths ( ABS ( B - A )) * 2 ** ( - L ), L = 0 , 1 , 2 , ... , MOMCOM - 1 , MOMCOM . LT . MAXP1 CHEBMO - Real Array of dimension ( MAXP1 , 25 ) containing the Chebyshev moments REFERENCES  (NONE) ROUTINES CALLED  QC25F, QELG, QPSRT, R1MACH REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890831  Modified array declarations.  (WRB)\n   890831  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB) END PROLOGUE  QAWOE **FIRST EXECUTABLE STATEMENT  QAWOE Arguments Type Intent Optional Attributes Name real :: F real :: A real :: B real :: OMEGA integer :: INTEGR real :: EPSABS real :: EPSREL integer :: LIMIT integer :: ICALL integer :: MAXP1 real :: RESULT real :: ABSERR integer :: NEVAL integer :: IER integer :: LAST real, dimension(*) :: ALIST real, dimension(*) :: BLIST real, dimension(*) :: RLIST real, dimension(*) :: ELIST integer, dimension(*) :: IORD integer, dimension(*) :: NNLOG integer :: MOMCOM real, dimension(maxp1,25) :: CHEBMO","tags":"","url":"proc/qawoe.html"},{"title":"DIPOLE_ypp_driver – Yambo","text":"subroutine DIPOLE_ypp_driver(k, E, q) Uses parallel_m R_lattice OUTPUT ALLOC interpolate YPP_interfaces stderr pars com DIPOLES parser_m QP_CTL_m IO_m YPPm vec_operate parallel_int electrons interfaces Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k type( levels ) :: E type( bz_samp ) :: q","tags":"","url":"proc/dipole_ypp_driver.html"},{"title":"io_COLLISIONS – Yambo","text":"function io_COLLISIONS(ID, COLL, COLL_element, i_coll_) Uses parallel_m plasma pars collision_ext X_m QP_m IO_m global_XC timing_m drivers iso_c_binding IO_int Arguments Type Intent Optional Attributes Name integer, intent(inout) :: ID type( COLLISIONS_group ) :: COLL type( COLLISIONS_element ), optional, target :: COLL_element integer, intent(in), optional :: i_coll_ Return Value integer","tags":"","url":"proc/io_collisions~2.html"},{"title":"QELG – Yambo","text":"subroutine QELG(N, EPSTAB, RESULT, ABSERR, RES3LA, NRES) BEGIN PROLOGUE  QELG SUBSIDIARY PURPOSE  The routine determines the limit of a given sequence of\n            approximations, by means of the Epsilon algorithm of\n            P. Wynn. An estimate of the absolute error is also given.\n            The condensed Epsilon table is computed. Only those\n            elements needed for the computation of the next diagonal\n            are preserved. LIBRARY   SLATEC TYPE      SINGLE PRECISION (QELG-S, DQELG-D) KEYWORDS  CONVERGENCE ACCELERATION, EPSILON ALGORITHM, EXTRAPOLATION AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Epsilon algorithm\n       Standard fortran subroutine\n       Real version\n\n       PARAMETERS\n          N      - Integer\n                   EPSTAB(N) contains the new element in the\n                   first column of the epsilon table.\n\n          EPSTAB - Real\n                   Vector of dimension 52 containing the elements\n                   of the two lower diagonals of the triangular\n                   epsilon table. The elements are numbered\n                   starting at the right-hand corner of the\n                   triangle.\n\n          RESULT - Real\n                   Resulting approximation to the integral\n\n          ABSERR - Real\n                   Estimate of the absolute error computed from\n                   RESULT and the 3 previous results\n\n          RES3LA - Real\n                   Vector of dimension 3 containing the last 3\n                   results\n\n          NRES   - Integer\n                   Number of calls to the routine\n                   (should be zero at first call) SEE ALSO  QAGIE, QAGOE, QAGPE, QAGSE ROUTINES CALLED  R1MACH REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900328  Added TYPE section.  (WRB) END PROLOGUE  QELG **FIRST EXECUTABLE STATEMENT  QELG Arguments Type Intent Optional Attributes Name integer :: N real, dimension(52) :: EPSTAB real :: RESULT real :: ABSERR real, dimension(3) :: RES3LA integer :: NRES","tags":"","url":"proc/qelg.html"},{"title":"rim_spherical – Yambo","text":"subroutine rim_spherical(Np, points, p_weight, radius, power, MULTIPLY_BY_Q) Uses R_lattice stderr D_lattice pars com vec_operate drivers LIVE_t Arguments Type Intent Optional Attributes Name integer, intent(in) :: Np real(kind=SP), intent(in) :: points (Np,3) real(kind=SP), intent(inout) :: p_weight (Np) real(kind=SP), intent(in) :: radius integer, intent(in) :: power logical, intent(in) :: MULTIPLY_BY_Q","tags":"","url":"proc/rim_spherical.html"},{"title":"msg_characters_vector_int – Yambo","text":"subroutine msg_characters_vector_int(how, mesg, val, after_msg, USE_TABS, INDENT, MSG_string) Uses stderr pars com LIVE_t com_interfcs Arguments Type Intent Optional Attributes Name character(len=*) :: how character(len=*) :: mesg character(len=*) :: val (:) character(len=*), optional :: after_msg logical, optional :: USE_TABS integer, optional :: INDENT character(len=lchlen), optional :: MSG_string","tags":"","url":"proc/msg_characters_vector_int.html"},{"title":"add_the_semi_column – Yambo","text":"subroutine add_the_semi_column(string, n, string_plus) Uses pars Arguments Type Intent Optional Attributes Name character(len=*) :: string integer :: n character(len=lchlen) :: string_plus","tags":"","url":"proc/add_the_semi_column.html"},{"title":"fix_the_new_line – Yambo","text":"subroutine fix_the_new_line(how, string, l_new_line) Arguments Type Intent Optional Attributes Name character(len=*) :: how character(len=*) :: string logical :: l_new_line","tags":"","url":"proc/fix_the_new_line.html"},{"title":"BESK0E – Yambo","text":"function BESK0E(X) BEGIN PROLOGUE  BESK0E PURPOSE  Compute the exponentially scaled modified (hyperbolic)\n            Bessel function of the third kind of order zero. LIBRARY   SLATEC (FNLIB) CATEGORY  C10B1 TYPE      SINGLE PRECISION (BESK0E-S, DBSK0E-D) KEYWORDS  EXPONENTIALLY SCALED, FNLIB, HYPERBOLIC BESSEL FUNCTION,\n             MODIFIED BESSEL FUNCTION, ORDER ZERO, SPECIAL FUNCTIONS,\n             THIRD KIND AUTHOR  Fullerton, W., (LANL) DESCRIPTION BESK0E(X) computes the exponentially scaled modified (hyperbolic)\n Bessel function of third kind of order zero for real argument\n X .GT. 0.0, i.e., EXP(X)*K0(X). Series for BK0        on the interval  0.          to  4.00000D+00\n                                        with weighted error   3.57E-19\n                                         log weighted error  18.45\n                               significant figures required  17.99\n                                    decimal places required  18.97 Series for AK0        on the interval  1.25000D-01 to  5.00000D-01\n                                        with weighted error   5.34E-17\n                                         log weighted error  16.27\n                               significant figures required  14.92\n                                    decimal places required  16.89 Series for AK02       on the interval  0.          to  1.25000D-01\n                                        with weighted error   2.34E-17\n                                         log weighted error  16.63\n                               significant figures required  14.67\n                                    decimal places required  17.20 REFERENCES  (NONE) ROUTINES CALLED  BESI0, CSEVL, INITS, R1MACH, XERMSG REVISION HISTORY  (YYMMDD)\n   770401  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   900326  Removed duplicate information from DESCRIPTION section.\n           (WRB) END PROLOGUE  BESK0E\n**FIRST EXECUTABLE STATEMENT  BESK0E Arguments Type Intent Optional Attributes Name real :: X Return Value real","tags":"","url":"proc/besk0e.html"},{"title":"eval_R_minus_R – Yambo","text":"subroutine eval_R_minus_R() Uses FFT_m D_lattice Arguments None","tags":"","url":"proc/eval_r_minus_r.html"},{"title":"bessel_F3 – Yambo","text":"function bessel_F3(z) Uses pars R_lattice Arguments Type Intent Optional Attributes Name real(kind=SP) :: z Return Value real(kind=SP)","tags":"","url":"proc/bessel_f3.html"},{"title":"ELPH_databases_IO_gkkp_expand – Yambo","text":"subroutine ELPH_databases_IO_gkkp_expand(mode, iq, iq_s, k, q, qindx_ID, qindx_ID_frag, GKKP) Uses R_lattice ELPH D_lattice YPP_ELPH pars ALLOC Arguments Type Intent Optional Attributes Name character(len=*) :: mode integer, intent(in) :: iq integer, intent(in) :: iq_s type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: q integer, intent(in) :: qindx_ID integer, intent(in) :: qindx_ID_frag type( GKKP_me ) :: GKKP","tags":"","url":"proc/elph_databases_io_gkkp_expand.html"},{"title":"RT_Dephasing_Matrix – Yambo","text":"subroutine RT_Dephasing_Matrix(E) Uses R_lattice pars com UNITS electrons real_time Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: E","tags":"","url":"proc/rt_dephasing_matrix.html"},{"title":"DBESI1 – Yambo","text":"function DBESI1(X) BEGIN PROLOGUE  DBESI1 PURPOSE  Compute the modified (hyperbolic) Bessel function of the\n            first kind of order one. LIBRARY   SLATEC (FNLIB) CATEGORY  C10B1 TYPE      DOUBLE PRECISION (BESI1-S, DBESI1-D) KEYWORDS  FIRST KIND, FNLIB, HYPERBOLIC BESSEL FUNCTION,\n             MODIFIED BESSEL FUNCTION, ORDER ONE, SPECIAL FUNCTIONS AUTHOR  Fullerton, W., (LANL) DESCRIPTION DBESI1(X) calculates the double precision modified (hyperbolic)\n Bessel function of the first kind of order one and double precision\n argument X. Series for BI1        on the interval  0.          to  9.00000E+00\n                                        with weighted error   1.44E-32\n                                         log weighted error  31.84\n                               significant figures required  31.45\n                                    decimal places required  32.46 REFERENCES  (NONE) ROUTINES CALLED  D1MACH, DBSI1E, DCSEVL, INITDS, XERMSG REVISION HISTORY  (YYMMDD)\n   770701  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ) END PROLOGUE  DBESI1\n**FIRST EXECUTABLE STATEMENT  DBESI1 Arguments Type Intent Optional Attributes Name double precision :: X Return Value doubleprecision","tags":"","url":"proc/dbesi1.html"},{"title":"Fermi_fnc_fit – Yambo","text":"function Fermi_fnc_fit(RT_occ_in, nstates, T_fit, Ef_fit, err_fit, RT_occ_fit_out, RT_E_fit_out) Uses functions pars vec_operate electrons real_time Arguments Type Intent Optional Attributes Name real(kind=SP), intent(in) :: RT_occ_in (nstates) integer, intent(in) :: nstates real(kind=SP), intent(out) :: T_fit (2) real(kind=SP), intent(out) :: Ef_fit (2) real(kind=SP), intent(out) :: err_fit (4) real(kind=SP), intent(out), optional :: RT_occ_fit_out (1000,2) real(kind=SP), intent(out), optional :: RT_E_fit_out (1000,2) Return Value integer","tags":"","url":"proc/fermi_fnc_fit.html"},{"title":"build_spin_sop – Yambo","text":"subroutine build_spin_sop() Uses gpu_m D_lattice matrix_operate pars electrons Arguments None","tags":"","url":"proc/build_spin_sop.html"},{"title":"CGEMV_omp – Yambo","text":"subroutine CGEMV_omp(TRANS, M, N, ALPHA, A, LDA, X, INCX, BETA, Y, INCY) Arguments Type Intent Optional Attributes Name character(len=1) :: TRANS integer :: M integer :: N complex :: ALPHA complex :: A (LDA,*) integer :: LDA comp