Attributes Name integer :: N complex :: A (*) integer :: IA integer :: JA integer :: DESCA (*) integer :: INFO","tags":"","url":"proc/pclamodhilb.html"},{"title":"k_build_map – Yambo","text":"subroutine k_build_map(k, k_save, kpoints_map) Uses pars R_lattice zeros vec_operate Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(inout) :: k type( bz_samp ), intent(in) :: k_save integer, intent(out) :: kpoints_map (2,k%nibz)","tags":"","url":"proc/k_build_map.html"},{"title":"X_irredux – Yambo","text":"subroutine X_irredux(iq, what, X_par, Xen, Xk, Xw, X, Dip) Uses parallel_m R_lattice com DIPOLES X_m parallel_int openmp ALLOC interfaces stderr matrix gpu_m collision_el wave_func D_lattice pars frequency wrapper devxlib IO_m timing_m drivers LIVE_t electrons @callgraph\n@callergraph Arguments Type Intent Optional Attributes Name integer :: iq character(len=*) :: what type( PAR_matrix ), target :: X_par type( levels ) :: Xen type( bz_samp ) :: Xk type( w_samp ) :: Xw type( X_t ) :: X type( DIPOLE_t ) :: Dip","tags":"","url":"proc/x_irredux.html"},{"title":"RT_driver – Yambo","text":"subroutine RT_driver(E, X, k, q, Dip) Uses parallel_m R_lattice DIPOLES com X_m LIVE_t RT_lifetimes parallel_int real_time interfaces plasma stderr IO_int wave_func pars collision_ext QP_CTL_m hamiltonian fields RT_control IO_m UNITS drivers FFT_m electrons Arguments Type Intent Optional Attributes Name type( levels ) :: E type( X_t ) :: X (2) type( bz_samp ) :: k type( bz_samp ) :: q type( DIPOLE_t ) :: Dip","tags":"","url":"proc/rt_driver.html"},{"title":"WF_apply_symm – Yambo","text":"subroutine WF_apply_symm(isc, WF_symm) Uses parallel_m devxlib wave_func stderr D_lattice pars FFT_m electrons Arguments Type Intent Optional Attributes Name integer, intent(in) :: isc (4) complex(kind=SP), intent(out) :: WF_symm (fft_size,n_spinor)","tags":"","url":"proc/wf_apply_symm.html"},{"title":"DGTSL – Yambo","text":"subroutine DGTSL(N, C, D, E, B, INFO) BEGIN PROLOGUE  DGTSL PURPOSE  Solve a tridiagonal linear system. LIBRARY   SLATEC (LINPACK) CATEGORY  D2A2A TYPE      DOUBLE PRECISION (SGTSL-S, DGTSL-D, CGTSL-C) KEYWORDS  LINEAR ALGEBRA, LINPACK, MATRIX, SOLVE, TRIDIAGONAL AUTHOR  Dongarra, J., (ANL) DESCRIPTION DGTSL given a general tridiagonal matrix and a right hand side will find the solution . On Entry N INTEGER is the order of the tridiagonal matrix . C DOUBLE PRECISION ( N ) is the subdiagonal of the tridiagonal matrix . C ( 2 ) through C ( N ) should contain the subdiagonal . On output C is destroyed . D DOUBLE PRECISION ( N ) is the diagonal of the tridiagonal matrix . On output D is destroyed . E DOUBLE PRECISION ( N ) is the superdiagonal of the tridiagonal matrix . E ( 1 ) through E ( N - 1 ) should contain the superdiagonal . On output E is destroyed . B DOUBLE PRECISION ( N ) is the right hand side vector . On Return B is the solution vector . INFO INTEGER = 0 normal value . = K if the K - th element of the diagonal becomes exactly zero . The subroutine returns when this is detected . REFERENCES  J. J. Dongarra, J. R. Bunch, C. B. Moler, and G. W.\n                 Stewart, LINPACK Users' Guide, SIAM, 1979. ROUTINES CALLED  (NONE) REVISION HISTORY  (YYMMDD)\n   780814  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890831  Modified array declarations.  (WRB)\n   890831  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900326  Removed duplicate information from DESCRIPTION section.\n           (WRB)\n   920501  Reformatted the REFERENCES section.  (WRB) END PROLOGUE  DGTSL Arguments Type Intent Optional Attributes Name integer :: N double precision :: C (*) double precision :: D (*) double precision :: E (*) double precision :: B (*) integer :: INFO","tags":"","url":"proc/dgtsl.html"},{"title":"io_RT_components_OBS – Yambo","text":"subroutine io_RT_components_OBS(ID, what) Uses RT_control pars netcdf IO_m electrons real_time IO_int Arguments Type Intent Optional Attributes Name integer, intent(in) :: ID character(len=*), intent(in) :: what","tags":"","url":"proc/io_rt_components_obs.html"},{"title":"RT_components_energy_plot – Yambo","text":"subroutine RT_components_energy_plot(En, kpt, n_T_steps) Uses RT_control R_lattice RT_output_m stderr pars functions com parser_m QP_m YPP_real_time UNITS vec_operate drivers LIVE_t electrons real_time interfaces Arguments Type Intent Optional Attributes Name type( levels ) :: En type( bz_samp ) :: kpt integer :: n_T_steps","tags":"","url":"proc/rt_components_energy_plot.html"},{"title":"OEP_exact_inversion – Yambo","text":"subroutine OEP_exact_inversion(X, E, k, Voep, W_x) Uses R_lattice collision_el wave_func D_lattice linear_algebra pars X_m electrons frequency FFT_m ALLOC interfaces Arguments Type Intent Optional Attributes Name type( X_t ) :: X type( levels ), intent(in) :: E type( bz_samp ), intent(in) :: k real(kind=SP), intent(out) :: Voep (fft_size) complex(kind=SP), intent(in) :: W_x (nkibz,maxval(n_met_bands),fft_size)","tags":"","url":"proc/oep_exact_inversion.html"},{"title":"QP_eval_the_FIT – Yambo","text":"function QP_eval_the_FIT(i_ACTION, i_sp_pol, Energy, E_ref_in, bands, E, k, what, is_valence) Uses R_lattice pars QP_CTL_m UNITS electrons interfaces Arguments Type Intent Optional Attributes Name integer :: i_ACTION integer :: i_sp_pol real(kind=SP) :: Energy real(kind=SP) :: E_ref_in (2) integer :: bands (2) type( levels ) :: E type( bz_samp ) :: k character(len=1), intent(in) :: what logical, intent(in) :: is_valence Return Value complex(kind=sp)","tags":"","url":"proc/qp_eval_the_fit.html"},{"title":"RT_entropy – Yambo","text":"subroutine RT_entropy(en, k, dG_lesser, Entr, TEntr, EnEntr, E_IP) Uses parallel_m R_lattice pars UNITS RT_occupations electrons real_time Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: en type( bz_samp ), intent(in) :: k complex(kind=SP), intent(in) :: dG_lesser (RT_bands(1):RT_bands(2),RT_bands(1