pol, do_derivative, use_live_timing) Uses R_lattice wave_func stderr D_lattice pars LIVE_t FFT_m electrons interfaces Arguments Type Intent Optional Attributes Name integer, intent(in) :: derivative_bands (2) integer, intent(in) :: derivative_kpt (2) integer, intent(in) :: derivative_sppol (2) logical, intent(in) :: do_derivative (3) logical, intent(in) :: use_live_timing","tags":"","url":"proc/wf_derivative.html"},{"title":"fft_3d_cuda – Yambo","text":"subroutine fft_3d_cuda(c_d, n, fft_sign, cufft_plan) Uses devxlib_environment pars gpu_m devxlib_async Arguments Type Intent Optional Attributes Name complex(kind=DP) :: c_d (n(1),n(2),n(3)) integer :: n (3) integer :: fft_sign integer :: cufft_plan","tags":"","url":"proc/fft_3d_cuda.html"},{"title":"ELPH_double_grid – Yambo","text":"subroutine ELPH_double_grid(k, E, q) Uses R_lattice ELPH stderr YPP_ELPH pars com parser_m IO_m electrons IO_int Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k type( levels ) :: E type( bz_samp ) :: q","tags":"","url":"proc/elph_double_grid.html"},{"title":"PARALLEL_check_phase_space – Yambo","text":"subroutine PARALLEL_check_phase_space(N_PAR_elements, WORLD, WORLD_size, MSG) Uses parallel_m stderr pars LIVE_t parallel_int Arguments Type Intent Optional Attributes Name integer :: N_PAR_elements integer, optional :: WORLD integer, optional :: WORLD_size character(len=*), optional :: MSG","tags":"","url":"proc/parallel_check_phase_space.html"},{"title":"NL_initialize – Yambo","text":"subroutine NL_initialize(E, k) Uses R_lattice nl_optics com X_m QP_m parser_m vec_operate real_time stderr zeros electric pars collision_ext hamiltonian fields RT_control UNITS drivers electrons Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: E type( bz_samp ), intent(in) :: k","tags":"","url":"proc/nl_initialize.html"},{"title":"OCCUPATIONS_Extend – Yambo","text":"subroutine OCCUPATIONS_Extend(Xe, E, k) Uses R_lattice pars UNITS electrons interfaces Arguments Type Intent Optional Attributes Name type( levels ) :: Xe type( levels ) :: E type( bz_samp ) :: k","tags":"","url":"proc/occupations_extend.html"},{"title":"WF_free – Yambo","text":"subroutine WF_free(WF, keep_fft, keep_states_to_load) Uses gpu_m devxlib wave_func pseudo Arguments Type Intent Optional Attributes Name type( WAVEs ) :: WF logical, optional :: keep_fft logical, optional :: keep_states_to_load","tags":"","url":"proc/wf_free.html"},{"title":"QK21 – Yambo","text":"subroutine QK21(F, A, B, RESULT, ABSERR, RESABS, RESASC) BEGIN PROLOGUE  QK21 PURPOSE  To compute I = Integral of F over (A,B), with error\n                           estimate\n                       J = Integral of ABS(F) over (A,B) LIBRARY   SLATEC (QUADPACK) CATEGORY  H2A1A2 TYPE      SINGLE PRECISION (QK21-S, DQK21-D) KEYWORDS  21-POINT GAUSS-KRONROD RULES, QUADPACK, QUADRATURE AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Integration rules Standard fortran subroutine Real version PARAMETERS ON ENTRY F - Real Function subprogram defining the integrand FUNCTION F ( X ) . The actual name for F needs to be Declared E X T E R N A L in the driver program . A - Real Lower limit of integration B - Real Upper limit of integration ON RETURN RESULT - Real Approximation to the integral I RESULT is computed by applying the 21 - POINT KRONROD RULE ( RESK ) obtained by optimal addition of abscissae to the 10 - POINT GAUSS RULE ( RESG ) . ABSERR - Real Estimate of the modulus of the absolute error , which should not exceed ABS ( I - RESULT ) RESABS - Real Approximation to the integral J RESASC - Real Approximation to the integral of ABS ( F - I / ( B - A )) over ( A , B ) REFERENCES  (NONE) ROUTINES CALLED  R1MACH REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB) END PROLOGUE  QK21 **FIRST EXECUTABLE STATEMENT  QK21 Arguments Type Intent Optional Attributes Name real :: F real :: A real :: B real :: RESULT real :: ABSERR real :: RESABS real :: RESASC","tags":"","url":"proc/qk21.html"},{"title":"RT_coefficients_Fourier – Yambo","text":"subroutine RT_coefficients_Fourier(nt, P, nw, W, X, X_err, deltaW) Uses fields pars real_time YPP_real_time Arguments Type Intent Optional Attributes Name integer, intent(in) :: nt real(kind=SP), intent(in) :: P (nt) integer, intent(in) :: nw real(kind=SP), intent(in) :: W (nw) complex(kind=SP), intent(out) :: X (nw) complex(kind=SP), intent(out) :: X_err (nw) real(kind=SP), intent(in) :: deltaW","tags":"","url":"proc/rt_coefficients_fourier.html"},{"title":"excitons_ph_ass_dos – Yambo","text":"subroutine excitons_ph_ass_dos(k, Xk, en, Xen, q_exc) Uses parallel_m R_lattice parallel_int ELPH interpolate D_lattice stderr YPP_ELPH pars functions com UNITS vec_operate YPPm LIVE_t electrons Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k type( bz_samp ) :: Xk type( levels ) :: en type( levels ) :: Xen type( bz_samp ) :: q_exc","tags":"","url":"proc/excitons_ph_ass_dos.html"},{"title":"a2y_wf – Yambo","text":"subroutine a2y_wf(wf_disk, i_sp_pol, ikibz, ib_grp, ncid) Uses wave_func netcdf_data pars netcdf vec_operate mod_com2y electrons Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(out) :: wf_disk (wf_ncx,n_spinor,wf_nb_io) integer, intent(in) :: i_sp_pol integer, intent(in) :: ikibz integer, intent(in) :: ib_grp integer, intent(in) :: ncid","tags":"","url":"proc/a2y_wf.html"},{"title":"k_build_up_BZ_tables – Yambo","text":"subroutine k_build_up_BZ_tables(k) Uses R_lattice D_lattice pars zeros vec_operate Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k","tags":"","url":"proc/k_build_up_bz_tables.html"},{"title":"acfdt_tot_energy – Yambo","text":"subroutine acfdt_tot_energy(Xen, Xk, En, k, q, X, Dip) Uses parallel_m R_lattice DIPOLES com X_m QP_m parallel_int ALLOC interfaces IO_int collision_el wave_func D_lattice linear_algebra pars frequency global_XC ACFDT FFT_m IO_m UNITS LIVE_t electrons xc_functionals Arguments Type Intent Optional Attributes Name type( levels ) :: Xen type( bz_samp ) :: Xk type( levels ) :: En type( bz_samp ) :: k type( bz_samp ) :: q type( X_t ) :: X type( DIPOLE_t ) :: Dip","tags":"","url":"proc/acfdt_tot_energy.html"},{"title":"scatter_Bamp_spin – Yambo","text":"subroutine scatter_Bamp_spin(isc, which) Uses R_lattice collision_el D_lattice pars FFT_m electrons interfaces Arguments Type Intent Optional Attributes Name type( elemental_collision ) :: isc character(len=1) :: which","tags":"","url":"proc/scatter_bamp_spin.html"},{"title":"electrons_magnetization – Yambo","text":"subroutine electrons_magnetization(Xk, Xen) Uses R_lattice stderr pars com YPPm FFT_m electrons xc_functionals interfaces Arguments Type Intent Optional Attributes Name type( bz_samp ) :: Xk type( levels ) :: Xen","tags":"","url":"proc/electrons_magnetization.html"},{"title":"io_BSS_invert – Yambo","text":"function io_BSS_invert(iq, W, ID) Uses stderr frequency IO_m BS_solvers UNITS timing_m BS IO_int Arguments Type Intent Optional Attributes Name integer :: iq type( w_samp ) :: W integer :: ID Return Value integer","tags":"","url":"proc/io_bss_invert.html"},{"title":"msg_reals_vector_int – Yambo","text":"subroutine msg_reals_vector_int(how, mesg, val, after_msg, USE_TABS, INDENT, EXT_FORMAT, MSG_string) Uses stderr pars com IO_m LIVE_t com_interfcs Arguments Type Intent Optional Attributes Name character(len=*) :: how character(len=*) :: mesg real(kind=SP) :: val (:) character(len=*), optional :: after_msg logical, optional :: USE_TABS integer, optional :: INDENT logical, optional :: EXT_FORMAT character(len=lchlen), optional :: MSG_string","tags":"","url":"proc/msg_reals_vector_int.html"},{"title":"QP_DB_expand – Yambo","text":"subroutine QP_DB_expand(k) Uses R_lattice pars QP_m IO_m YPPm IO_int Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k","tags":"","url":"proc/qp_db_expand.html"},{"title":"electrons_dos_elemental – Yambo","text":"subroutine electrons_dos_elemental(k, E, bands, el_dos, dos_E, spin_fac, pdos_fac, USE_the_DbGd, QUIET, FORCE_occ) Uses parallel_m R_lattice parallel_int pars parser_m YPPm LIVE_t electrons interfaces IO_int Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: k type( levels ), intent(in) :: E integer, intent(in) :: bands (2) real(kind=SP), intent(out) :: el_dos (DOS_E_steps,n_spin) real(kind=SP), intent(in) :: dos_E (DOS_E_steps) real(kind=SP), intent(in), optional, pointer :: spin_fac (:,:,:) real(kind=SP), intent(in), optional, pointer :: pdos_fac (:,:,:) logical, intent(in), optional :: USE_the_DbGd logical, intent(in), optional :: QUIET logical, intent(in), optional :: FORCE_occ","tags":"","url":"proc/electrons_dos_elemental.html"},{"title":"X_GreenF_convoluted – Yambo","text":"subroutine X_GreenF_convoluted(iq, transitions, Xw, Xen, Xk, GreenF, ordering) Uses R_lattice pars frequency UNITS electrons Arguments Type Intent Optional Attributes Name integer :: iq integer :: transitions (4) type( w_samp ) :: Xw type( levels ) :: Xen type( bz_samp ) :: Xk complex(kind=SP) :: GreenF (Xw%n_freqs) character(len=*) :: ordering","tags":"","url":"proc/x_greenf_convoluted.html"},{"title":"DIPOLE_x_real_space – Yambo","text":"subroutine DIPOLE_x_real_space(Xen, Xk, Dip, idir_todo) Uses parallel_m R_lattice wave_func D_lattice wrapper_omp pars DIPOLES X_m LIVE_t timing_m drivers FFT_m electrons interfaces Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: Xen type( bz_samp ), intent(in) :: Xk type( DIPOLE_t ), intent(inout) :: Dip logical, intent(in) :: idir_todo (3)","tags":"","url":"proc/dipole_x_real_space.html"},{"title":"k_map_fine_to_coarse_driver – Yambo","text":"subroutine k_map_fine_to_coarse_driver(Xk, Xen) Uses R_lattice stderr pars com IO_m YPPm electrons IO_int Arguments Type Intent Optional Attributes Name type( bz_samp ) :: Xk type( levels ) :: Xen","tags":"","url":"proc/k_map_fine_to_coarse_driver.html"},{"title":"build_xc_spin_map – Yambo","text":"subroutine build_xc_spin_map() Uses electrons xc_functionals Arguments None","tags":"","url":"proc/build_xc_spin_map.html"},{"title":"XC_eval_lda_kernel – Yambo","text":"subroutine XC_eval_lda_kernel(v1rho, v2rho2) Uses D_lattice pars BS FFT_m electrons xc_functionals Arguments Type Intent Optional Attributes Name real(kind=DP), intent(in) :: v1rho (n_spin,fft_size) real(kind=DP), intent(in) :: v2rho2 (xc_spin(1),fft_size)","tags":"","url":"proc/xc_eval_lda_kernel.html"},{"title":"QED_Sigma_c – Yambo","text":"subroutine QED_Sigma_c(E, k, q, qp) Uses parallel_m R_lattice QP_m vec_operate parallel_int interfaces COLL_interfaces functions collision_el wave_func D_lattice pars collision_ext IO_m UNITS timing_m drivers LIVE_t electrons Arguments Type Intent Optional Attributes Name type( levels ) :: E type( bz_samp ) :: k type( bz_samp ) :: q type( QP_t ) :: qp","tags":"","url":"proc/qed_sigma_c.html"},{"title":"PARALLEL_global_dimensions – Yambo","text":"subroutine PARALLEL_global_dimensions(E, Xk, q, ENVIRONMENT) Uses parallel_m R_lattice com X_m QP_m drivers BS electrons Arguments Type Intent Optional Attributes Name type( levels ) :: E type( bz_samp ) :: Xk type( bz_samp ) :: q character(len=*) :: ENVIRONMENT","tags":"","url":"proc/parallel_global_dimensions.html"},{"title":"BESI0E – Yambo","text":"function BESI0E(X) BEGIN PROLOGUE  BESI0E PURPOSE  Compute the exponentially scaled modified (hyperbolic)\n            Bessel function of the first kind of order zero. LIBRARY   SLATEC (FNLIB) CATEGORY  C10B1 TYPE      SINGLE PRECISION (BESI0E-S, DBSI0E-D) KEYWORDS  EXPONENTIALLY SCALED, FIRST KIND, FNLIB,\n             HYPERBOLIC BESSEL FUNCTION, MODIFIED BESSEL FUNCTION,\n             ORDER ZERO, SPECIAL FUNCTIONS AUTHOR  Fullerton, W., (LANL) DESCRIPTION BESI0E(X) calculates the exponentially scaled modified (hyperbolic)\n Bessel function of the first kind of order zero for real argument X;\n i.e., EXP(-ABS(X))*I0(X). Series for BI0        on the interval  0.          to  9.00000D+00\n                                        with weighted error   2.46E-18\n                                         log weighted error  17.61\n                               significant figures required  17.90\n                                    decimal places required  18.15 Series for AI0        on the interval  1.25000D-01 to  3.33333D-01\n                                        with weighted error   7.87E-17\n                                         log weighted error  16.10\n                               significant figures required  14.69\n                                    decimal places required  16.76 Series for AI02       on the interval  0.          to  1.25000D-01\n                                        with weighted error   3.79E-17\n                                         log weighted error  16.42\n                               significant figures required  14.86\n                                    decimal places required  17.09 REFERENCES  (NONE) ROUTINES CALLED  CSEVL, INITS, R1MACH REVISION HISTORY  (YYMMDD)\n   770701  DATE WRITTEN\n   890313  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB) END PROLOGUE  BESI0E\n**FIRST EXECUTABLE STATEMENT  BESI0E Arguments Type Intent Optional Attributes Name real :: X Return Value real","tags":"","url":"proc/besi0e.html"},{"title":"io_RT_components_header – Yambo","text":"subroutine io_RT_components_header(ID, what, loading_carr_before_neq, io_RT_components) Uses RT_control R_lattice pars IO_m RT_lifetimes real_time IO_int Arguments Type Intent Optional Attributes Name integer, intent(in) :: ID character(len=*), intent(in) :: what logical, intent(in) :: loading_carr_before_neq integer, intent(out) :: io_RT_components","tags":"","url":"proc/io_rt_components_header.html"},{"title":"SERIAL_diagonalization – Yambo","text":"subroutine SERIAL_diagonalization(n, M, E, V_left, V_right) Uses linear_algebra pars timing_m Arguments Type Intent Optional Attributes Name integer :: n complex(kind=SP) :: M (n,n) complex(kind=SP) :: E (n) complex(kind=SP) :: V_left (n,n) complex(kind=SP) :: V_right (n,n)","tags":"","url":"proc/serial_diagonalization.html"},{"title":"ELPH_databases_IO_elemental – Yambo","text":"function ELPH_databases_IO_elemental(what, IDB) Uses ELPH D_lattice YPP_ELPH pars IO_m IO_int Arguments Type Intent Optional Attributes Name character(len=*) :: what integer :: IDB Return Value integer","tags":"","url":"proc/elph_databases_io_elemental.html"},{"title":"fft_check_size – Yambo","text":"subroutine fft_check_size(iGo_max, NG_C, NG_HF, mode) Uses R_lattice stderr pars parser_m FFT_m Arguments Type Intent Optional Attributes Name integer, intent(in) :: iGo_max integer, intent(in) :: NG_C integer, intent(inout) :: NG_HF character(len=2), intent(in) :: mode","tags":"","url":"proc/fft_check_size.html"},{"title":"numrec_ddpoly_sgl – Yambo","text":"subroutine numrec_ddpoly_sgl(c, nc, x, pd, nd) Uses numrec_kinds Arguments Type Intent Optional Attributes Name real(kind=sgl), intent(in) :: c (nc) integer, intent(in) :: nc real(kind=sgl), intent(in) :: x real(kind=sgl), intent(out) :: pd (nd) integer, intent(in) :: nd","tags":"","url":"proc/numrec_ddpoly_sgl.html"},{"title":"numrec_ddpoly_dbl – Yambo","text":"subroutine numrec_ddpoly_dbl(c, nc, x, pd, nd) Uses numrec_kinds Arguments Type Intent Optional Attributes Name real(kind=dbl), intent(in) :: c (nc) integer, intent(in) :: nc real(kind=dbl), intent(in) :: x real(kind=dbl), intent(out) :: pd (nd) integer, intent(in) :: nd","tags":"","url":"proc/numrec_ddpoly_dbl.html"},{"title":"io_BSS_diago – Yambo","text":"function io_BSS_diago(iq, i_BS_mat, ID, X_static, bsE, bsRl, bsRr, BsE_corr, bsL_magn, bsR_magn, bsL_kerr, bsR_kerr, bsR_dich, bsR_pl) Uses stderr pars X_m IO_m descriptors BS_solvers timing_m BS electrons IO_int Arguments Type Intent Optional Attributes Name integer :: iq integer :: i_BS_mat integer :: ID type( X_t ), intent(inout) :: X_static complex(kind=SP), optional :: bsE (:) complex(kind=SP), optional, pointer :: bsRl (:) complex(kind=SP), optional, pointer :: bsRr (:) real(kind=SP), optional, pointer :: BsE_corr (:,:) complex(kind=SP), optional, pointer :: bsL_magn (:,:) complex(kind=SP), optional, pointer :: bsR_magn (:,:) complex(kind=SP), optional, pointer :: bsL_kerr (:) complex(kind=SP), optional, pointer :: bsR_kerr (:) complex(kind=SP), optional, pointer :: bsR_dich (:,:) real(kind=SP), optional, pointer :: bsR_pl (:,:) Return Value integer","tags":"","url":"proc/io_bss_diago.html"},{"title":"SERV1 – Yambo","text":"subroutine SERV1(LABEL, VALUE, FLAG) Arguments Type Intent Optional Attributes Name character(len=*) :: LABEL real :: VALUE character(len=1) :: FLAG Common Blocks ERFIN (subroutine) DERV1 (subroutine) ERMOR (subroutine) ERMSG (subroutine) \">\n           common /M77ERR/ 1994-10-20 SERV1  Krogh  Changes to use M77CON\n1994-04-20 SERV1  CLL Edited to make DP & SP files similar.\n1985-09-20 SERV1  Lawson  Initial code. Type Attributes Name Initial integer :: IDELTA integer :: IALPHA","tags":"","url":"proc/serv1.html"},{"title":"electrons_pdos_factors – Yambo","text":"subroutine electrons_pdos_factors(kpts, bands, PDOS_fac) Uses R_lattice pars IO_m YPPm atom_proj electrons IO_int Arguments Type Intent Optional Attributes Name integer, intent(in) :: kpts (2) integer, intent(in) :: bands (2) real(kind=SP), intent(out) :: PDOS_fac (bands(1):bands(2),kpts(1):kpts(2),n_sp_pol)","tags":"","url":"proc/electrons_pdos_factors.html"},{"title":"XCo_driver – Yambo","text":"subroutine XCo_driver(E, k, Xk, q) Uses R_lattice wave_func pars QP_m IO_m global_XC zeros drivers electrons interfaces IO_int Arguments Type Intent Optional Attributes Name type( levels ) :: E type( bz_samp ) :: k type( bz_samp ) :: Xk type( bz_samp ) :: q","tags":"","url":"proc/xco_driver.html"},{"title":"RT_occupations_update – Yambo","text":"subroutine RT_occupations_update() Uses parallel_m R_lattice RT_occupations parallel_int electrons real_time Arguments None","tags":"","url":"proc/rt_occupations_update.html"},{"title":"SC_add_efield – Yambo","text":"subroutine SC_add_efield(E, k, i_sp_pol, V_bands, Pol) Uses R_lattice pars QP_m SC UNITS fields electrons electric Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: E type( bz_samp ), intent(in) :: k integer, intent(in) :: i_sp_pol complex(kind=SP), intent(in) :: V_bands (SC_bands(1):SC_bands(2),E%nbf(i_sp_pol),QP_nk) complex(kind=SP), intent(out) :: Pol (3)","tags":"","url":"proc/sc_add_efield.html"},{"title":"COLLISIONS_compose_rt – Yambo","text":"subroutine COLLISIONS_compose_rt(dG_in) Uses parallel_m R_lattice pars collision_ext timing_m drivers hamiltonian parallel_int electrons real_time Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: dG_in (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2),PAR_G_k_range(1):PAR_G_k_range(2))","tags":"","url":"proc/collisions_compose_rt.html"},{"title":"DYSON_bracket – Yambo","text":"function DYSON_bracket(x1, f1, x2, f2) Uses pars Arguments Type Intent Optional Attributes Name real(kind=SP) :: x1 real(kind=SP) :: f1 real(kind=SP) :: x2 real(kind=SP) :: f2 Return Value integer","tags":"","url":"proc/dyson_bracket.html"},{"title":"X_OUTPUT_driver – Yambo","text":"subroutine X_OUTPUT_driver(WHAT, keys, solver, IQ, IG, DESC, data, indexes) Uses OUTPUT D_lattice stderr pars X_m parser_m PHOTOLUM descriptors BS_solvers drivers BS electrons interfaces Arguments Type Intent Optional Attributes Name character(len=*) :: WHAT character(len=*), optional :: keys character(len=*), optional :: solver integer, optional :: IQ integer, optional :: IG type( IO_desc ), optional :: DESC real(kind=SP), optional :: data (:) integer, optional :: indexes (:)","tags":"","url":"proc/x_output_driver.html"},{"title":"RT_occupations_and_levels_init – Yambo","text":"subroutine RT_occupations_and_levels_init(bands, E, k, q, k_FG, E_FG) Uses parallel_m R_lattice functions pars RT_occupations parallel_int electrons real_time Arguments Type Intent Optional Attributes Name integer, intent(inout) :: bands (2) type( levels ), intent(inout) :: E type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: q type( bz_fine_grid ), intent(inout) :: k_FG type( E_fine_grid ), intent(inout) :: E_FG","tags":"","url":"proc/rt_occupations_and_levels_init.html"},{"title":"best_cutoff_allocated – Yambo","text":"function best_cutoff_allocated(BS_K_cutoff_inp) Uses BS pars vec_operate Arguments Type Intent Optional Attributes Name real(kind=SP), intent(in) :: BS_K_cutoff_inp Return Value real(kind=SP)","tags":"","url":"proc/best_cutoff_allocated.html"},{"title":"K_restart – Yambo","text":"subroutine K_restart(iq, X, ID_head, ID, ID_compr, l_partial_kernel_loaded) Uses stderr pars com X_m IO_m BS_solvers UNITS drivers BS LIVE_t IO_int Arguments Type Intent Optional Attributes Name integer, intent(in) :: iq type( X_t ), intent(inout) :: X integer, intent(out) :: ID_head integer, intent(out) :: ID integer, intent(out) :: ID_compr logical, intent(out) :: l_partial_kernel_loaded","tags":"","url":"proc/k_restart.html"},{"title":"FREQUENCIES_damping – Yambo","text":"function FREQUENCIES_damping(W, E) Uses pars frequency Arguments Type Intent Optional Attributes Name type( w_samp ) :: W real(kind=SP) :: E Return Value real(kind=SP)","tags":"","url":"proc/frequencies_damping.html"},{"title":"BESJ1 – Yambo","text":"function BESJ1(X) BEGIN PROLOGUE  BESJ1 PURPOSE  Compute the Bessel function of the first kind of order one. LIBRARY   SLATEC (FNLIB) CATEGORY  C10A1 TYPE      SINGLE PRECISION (BESJ1-S, DBESJ1-D) KEYWORDS  BESSEL FUNCTION, FIRST KIND, FNLIB, ORDER ONE,\n             SPECIAL FUNCTIONS AUTHOR  Fullerton, W., (LANL) DESCRIPTION BESJ1(X) calculates the Bessel function of the first kind of\n order one for real argument X. Series for BJ1        on the interval  0.          to  1.60000D+01\n                                        with weighted error   4.48E-17\n                                         log weighted error  16.35\n                               significant figures required  15.77\n                                    decimal places required  16.89 Series for BM1        on the interval  0.          to  6.25000D-02\n                                        with weighted error   5.61E-17\n                                         log weighted error  16.25\n                               significant figures required  14.97\n                                    decimal places required  16.91 Series for BTH1       on the interval  0.          to  6.25000D-02\n                                        with weighted error   4.10E-17\n                                         log weighted error  16.39\n                               significant figures required  15.96\n                                    decimal places required  17.08 REFERENCES  (NONE) ROUTINES CALLED  CSEVL, INITS, R1MACH, XERMSG REVISION HISTORY  (YYMMDD)\n   780601  DATE WRITTEN\n   890210  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   900326  Removed duplicate information from DESCRIPTION section.\n           (WRB) END PROLOGUE  BESJ1\n**FIRST EXECUTABLE STATEMENT  BESJ1 Arguments Type Intent Optional Attributes Name real :: X Return Value real","tags":"","url":"proc/besj1.html"},{"title":"X_pre_setup – Yambo","text":"subroutine X_pre_setup(Xen, Xk, X) Uses parallel_m R_lattice gpu_m stderr pars X_m QP_m parser_m drivers TDDFT electrons interfaces Arguments Type Intent Optional Attributes Name type( levels ) :: Xen type( bz_samp ) :: Xk type( X_t ) :: X","tags":"","url":"proc/x_pre_setup.html"},{"title":"QP_apply_the_ACTION – Yambo","text":"subroutine QP_apply_the_ACTION(i_ACTION, bands, E, k) Uses QP_CTL_m pars electrons R_lattice Arguments Type Intent Optional Attributes Name integer :: i_ACTION integer :: bands (2) type( levels ) :: E type( bz_samp ) :: k","tags":"","url":"proc/qp_apply_the_action.html"},{"title":"DIPOLE_g_space – Yambo","text":"subroutine DIPOLE_g_space(Xen, Xk, Dip) Uses parallel_m R_lattice DIPOLES com X_m ALLOC interfaces pseudo stderr IO_int gpu_m wave_func D_lattice pars devxlib IO_m timing_m drivers LIVE_t electrons Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: Xen type( bz_samp ), intent(in) :: Xk type( DIPOLE_t ), intent(inout) :: Dip","tags":"","url":"proc/dipole_g_space.html"},{"title":"RT_G_two_times_driver – Yambo","text":"subroutine RT_G_two_times_driver(en, kpt, qpt) Uses R_lattice electrons Arguments Type Intent Optional Attributes Name type( levels ) :: en type( bz_samp ) :: kpt type( bz_samp ) :: qpt","tags":"","url":"proc/rt_g_two_times_driver.html"},{"title":"QP_mpa – Yambo","text":"subroutine QP_mpa(X, Xk, E, k, q, qp, Xw, GW_iter) Uses parallel_m R_lattice com parser_m QP_m X_m parallel_int ALLOC interfaces stderr functions IO_int matrix gpu_m collision_el wave_func mpa_m D_lattice pars frequency devxlib IO_m UNITS timing_m drivers LIVE_t electrons Arguments Type Intent Optional Attributes Name type( X_t ) :: X type( bz_samp ) :: Xk type( levels ) :: E type( bz_samp ) :: k type( bz_samp ) :: q type( QP_t ) :: qp type( w_samp ) :: Xw integer :: GW_iter","tags":"","url":"proc/qp_mpa.html"},{"title":"io_ELPH – Yambo","text":"function io_ELPH(ID, what) Uses R_lattice ELPH stderr D_lattice pars IO_m timing_m ALLOC IO_int Arguments Type Intent Optional Attributes Name integer :: ID character(len=*) :: what Return Value integer","tags":"","url":"proc/io_elph.html"},{"title":"gauss_leg_grid – Yambo","text":"subroutine gauss_leg_grid(x1, x2, x, w, n) Uses pars Arguments Type Intent Optional Attributes Name real(kind=SP) :: x1 real(kind=SP) :: x2 real(kind=SP) :: x (n) real(kind=SP) :: w (n) integer :: n","tags":"","url":"proc/gauss_leg_grid.html"},{"title":"SET_job_strings_and_dirs – Yambo","text":"subroutine SET_job_strings_and_dirs(JS) Uses pars com stderr Arguments Type Intent Optional Attributes Name character(len=*) :: JS","tags":"","url":"proc/set_job_strings_and_dirs.html"},{"title":"INIT_ypp – Yambo","text":"subroutine INIT_ypp(E, instr, FINALIZE) Uses parallel_m stderr pars com parser_m it_tools LIVE_t it_m UNITS YPPm IO_m drivers parallel_int electrons IO_int Arguments Type Intent Optional Attributes Name type( levels ) :: E character(len=*) :: instr logical :: FINALIZE","tags":"","url":"proc/init_ypp.html"},{"title":"RT_start_and_restart – Yambo","text":"subroutine RT_start_and_restart(E, k, q) Uses parallel_m R_lattice com descriptors RT_lifetimes parallel_int real_time H_interfaces IO_int wave_func pars QP_CTL_m hamiltonian fields RT_control RT_output_m IO_m UNITS drivers electrons xc_functionals Arguments Type Intent Optional Attributes Name type( levels ) :: E type( bz_samp ) :: k type( bz_samp ) :: q","tags":"","url":"proc/rt_start_and_restart.html"},{"title":"MEM_manager_messages – Yambo","text":"subroutine MEM_manager_messages(what, adding, MEM_now_Kb, where) Uses pars y_memory com Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: what logical, intent(in) :: adding integer, intent(in) :: MEM_now_Kb integer, intent(in) :: where","tags":"","url":"proc/mem_manager_messages.html"},{"title":"XCo_report – Yambo","text":"subroutine XCo_report(qp, E, k) Uses R_lattice stderr pars com QP_m UNITS drivers parallel_int electrons xc_functionals Arguments Type Intent Optional Attributes Name type( QP_t ) :: qp type( levels ) :: E type( bz_samp ) :: k","tags":"","url":"proc/xco_report.html"},{"title":"XERCNT – Yambo","text":"subroutine XERCNT(LIBRAR, SUBROU, MESSG, NERR, LEVEL, KONTRL) BEGIN PROLOGUE  XERCNT SUBSIDIARY PURPOSE  Allow user control over handling of errors. LIBRARY   SLATEC (XERROR) CATEGORY  R3C TYPE      ALL (XERCNT-A) KEYWORDS  ERROR, XERROR AUTHOR  Jones, R. E., (SNLA)\n**DESCRIPTION Abstract Allows user control over handling of individual errors . Just after each message is recorded , but before it is processed any further ( i . e ., before it is printed or a decision to abort is made ), a call is made to XERCNT . If the user has provided his own version of XERCNT , he can then override the value of KONTROL used in processing this message by redefining its value . KONTRL may be set to any value from - 2 to 2 . The meanings for KONTRL are the same as in XSETF , except that the value of KONTRL changes only for this message . If KONTRL is set to a value outside the range from - 2 to 2 , it will be moved back into that range . Description of Parameters -- Input -- LIBRAR - the library that the routine is in . SUBROU - the subroutine that XERMSG is being called from MESSG - the first 20 characters of the error message . NERR - same as in the call to XERMSG . LEVEL - same as in the call to XERMSG . KONTRL - the current value of the control flag as set by a call to XSETF . -- Output -- KONTRL - the new value of KONTRL . If KONTRL is not defined , it will remain at its original value . This changed value of control affects only the current occurrence of the current message . REFERENCES  R. E. Jones and D. K. Kahaner, XERROR, the SLATEC\n                 Error-handling Package, SAND82-0800, Sandia\n                 Laboratories, 1982. ROUTINES CALLED  (NONE) REVISION HISTORY  (YYMMDD)\n   790801  DATE WRITTEN\n   861211  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900206  Routine changed from user-callable to subsidiary.  (WRB)\n   900510  Changed calling sequence to include LIBRARY and SUBROUTINE\n           names, changed routine name from XERCTL to XERCNT.  (RWC)\n   920501  Reformatted the REFERENCES section.  (WRB) END PROLOGUE  XERCNT Arguments Type Intent Optional Attributes Name character(len=*) :: LIBRAR **FIRST EXECUTABLE STATEMENT  XERCNT character(len=*) :: SUBROU **FIRST EXECUTABLE STATEMENT  XERCNT character(len=*) :: MESSG **FIRST EXECUTABLE STATEMENT  XERCNT integer :: NERR integer :: LEVEL integer :: KONTRL","tags":"","url":"proc/xercnt.html"},{"title":"RT_free – Yambo","text":"subroutine RT_free() Uses R_lattice RT_occupations RT_lifetimes hamiltonian ALLOC xc_functionals real_time Arguments None","tags":"","url":"proc/rt_free.html"},{"title":"PARALLEL_assign_chains_and_COMMs – Yambo","text":"subroutine PARALLEL_assign_chains_and_COMMs(n_elements, COMM_index_1, COMM_index_2, COMM_index_3, COMM_index_4, COMM_index_5, COMM_A2A_1, COMM_A2A_2, COMM_A2A_3, COMM_A2A_4, COMM_index_global_2) Uses parallel_m Arguments Type Intent Optional Attributes Name integer :: n_elements type( yMPI_comm ) :: COMM_index_1 type( yMPI_comm ), optional :: COMM_index_2 type( yMPI_comm ), optional :: COMM_index_3 type( yMPI_comm ), optional :: COMM_index_4 type( yMPI_comm ), optional :: COMM_index_5 type( yMPI_comm ), optional :: COMM_A2A_1 type( yMPI_comm ), optional :: COMM_A2A_2 type( yMPI_comm ), optional :: COMM_A2A_3 type( yMPI_comm ), optional :: COMM_A2A_4 type( yMPI_comm ), optional :: COMM_index_global_2","tags":"","url":"proc/parallel_assign_chains_and_comms.html"},{"title":"ZWOFZ – Yambo","text":"subroutine ZWOFZ(Z, W, FLAG) 2002-11-06 ZWOFZ Krogh Corrected comments.\n1996-03-30 ZWOFZ Krogh Added external stmt., removed INT in type st.\n1992-10-13 ZWOFZ WVS Improve efficiency and avoid underflow.\n1992-03-13 ZWOFZ FTK Removed implicit statements.\n1991-08-23 ZWOFZ WV Snyder Initial adaptation to Math77 Arguments Type Intent Optional Attributes Name double precision :: Z (2) double precision :: W (2) integer :: FLAG","tags":"","url":"proc/zwofz.html"},{"title":"PARALLEL_live_message – Yambo","text":"subroutine PARALLEL_live_message(WHAT, ENVIRONMENT, LOADED, TOTAL, LOADED_r, TOTAL_r, NC) Uses parallel_m pars LIVE_t stderr Arguments Type Intent Optional Attributes Name character(len=*) :: WHAT character(len=*), optional :: ENVIRONMENT integer, optional :: LOADED integer, optional :: TOTAL real(kind=SP), optional :: LOADED_r real(kind=SP), optional :: TOTAL_r integer, optional :: NC","tags":"","url":"proc/parallel_live_message.html"},{"title":"D9B1MP – Yambo","text":"subroutine D9B1MP(X, AMPL, THETA) BEGIN PROLOGUE  D9B1MP SUBSIDIARY PURPOSE  Evaluate the modulus and phase for the J1 and Y1 Bessel\n            functions. LIBRARY   SLATEC (FNLIB) CATEGORY  C10A1 TYPE      DOUBLE PRECISION (D9B1MP-D) KEYWORDS  BESSEL FUNCTION, FNLIB, MODULUS, PHASE, SPECIAL FUNCTIONS AUTHOR  Fullerton, W., (LANL)\n**DESCRIPTION Evaluate the modulus and phase for the Bessel J1 and Y1 functions. Series for BM1        on the interval  1.56250E-02 to  6.25000E-02\n                                        with weighted error   4.91E-32\n                                         log weighted error  31.31\n                               significant figures required  30.04\n                                    decimal places required  32.09 Series for BT12       on the interval  1.56250E-02 to  6.25000E-02\n                                        with weighted error   3.33E-32\n                                         log weighted error  31.48\n                               significant figures required  31.05\n                                    decimal places required  32.27 Series for BM12       on the interval  0.          to  1.56250E-02\n                                        with weighted error   5.01E-32\n                                         log weighted error  31.30\n                               significant figures required  29.99\n                                    decimal places required  32.10 Series for BTH1       on the interval  0.          to  1.56250E-02\n                                        with weighted error   2.82E-32\n                                         log weighted error  31.55\n                               significant figures required  31.12\n                                    decimal places required  32.37 SEE ALSO  DBESJ1, DBESY1 REFERENCES  (NONE) ROUTINES CALLED  D1MACH, DCSEVL, INITDS, XERMSG REVISION HISTORY  (YYMMDD)\n   770701  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   900720  Routine changed from user-callable to subsidiary.  (WRB)\n   920618  Removed space from variable name and code restructured to\n           use IF-THEN-ELSE.  (RWC, WRB) END PROLOGUE  D9B1MP FIRST EXECUTABLE STATEMENT  D9B1MP Arguments Type Intent Optional Attributes Name double precision :: X double precision :: AMPL double precision :: THETA","tags":"","url":"proc/d9b1mp.html"},{"title":"electrons_WFs_proj_interpolate – Yambo","text":"subroutine electrons_WFs_proj_interpolate(Xen, SEED_k, OUT_k, BANDS_range, proj_fac, ID_proj) Uses R_lattice wave_func interpolate pars IO_m SC hamiltonian electrons wrapper Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: Xen type( bz_samp ), intent(in) :: SEED_k type( bz_samp ), intent(inout) :: OUT_k integer, intent(in) :: BANDS_range (2) real(kind=SP) :: proj_fac (BANDS_range(1):BANDS_range(2),SEED_k%nibz,2) integer, intent(out) :: ID_proj","tags":"","url":"proc/electrons_wfs_proj_interpolate.html"},{"title":"PARALLEL_lin_system – Yambo","text":"subroutine PARALLEL_lin_system(A, B, n, nrhs) Uses linear_algebra matrix timing_m SLK_m Arguments Type Intent Optional Attributes Name type( PAR_matrix ) :: A type( PAR_matrix ) :: B integer :: n integer :: nrhs","tags":"","url":"proc/parallel_lin_system.html"},{"title":"K_multiply_by_V_transpose_slepc – Yambo","text":"subroutine K_multiply_by_V_tra