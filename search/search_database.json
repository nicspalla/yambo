integer","tags":"","url":"proc/io_db1.html"},{"title":"RT_ELPH_initialize – Yambo","text":"subroutine RT_ELPH_initialize(E, k, q) Uses R_lattice ELPH parser_m drivers electrons real_time Arguments Type Intent Optional Attributes Name type( levels ) :: E type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: q","tags":"","url":"proc/rt_elph_initialize.html"},{"title":"SLK_ORTHO_init – Yambo","text":"subroutine SLK_ORTHO_init(ORTHO, POOL, n_CPU_in) Uses SLK_m Arguments Type Intent Optional Attributes Name type( ORTHO_group ), intent(inout) :: ORTHO type( POOL_group ), intent(inout) :: POOL integer, intent(in) :: n_CPU_in","tags":"","url":"proc/slk_ortho_init.html"},{"title":"PP_uspp_init – Yambo","text":"subroutine PP_uspp_init() Uses R_lattice pseudo D_lattice qe_pseudo_m pars gvect IO_m timing_m vec_operate drivers IO_int Arguments None","tags":"","url":"proc/pp_uspp_init.html"},{"title":"LINEAR_ALGEBRA_driver – Yambo","text":"subroutine LINEAR_ALGEBRA_driver(idriver, lib_in, M, M_slk, M_bse, B, B_slk, C, C_slk, V_left, V_right, E_real, E_cmpl, SVD_digits, det) Uses parallel_m matrix gpu_m devxlib linear_algebra pars timing_m BS interfaces wrapper Arguments Type Intent Optional Attributes Name integer :: idriver integer, optional :: lib_in complex(kind=SP), optional :: M (:,:) type( PAR_matrix ), optional :: M_slk type( BS_block ), optional :: M_bse (:) complex(kind=SP), optional :: B (:,:) type( PAR_matrix ), optional :: B_slk complex(kind=SP), optional :: C (:,:) type( PAR_matrix ), optional :: C_slk complex(kind=SP), optional :: V_left (:,:) complex(kind=SP), optional :: V_right (:,:) real(kind=SP), optional :: E_real (:) complex(kind=SP), optional :: E_cmpl (:) integer, optional :: SVD_digits complex(kind=SP), optional :: det","tags":"","url":"proc/linear_algebra_driver.html"},{"title":"EPS_via_perturbative_inversion – Yambo","text":"function EPS_via_perturbative_inversion(n, m, n_loop, D, C, f, Lo) Uses wrapper_omp pars BS_solvers Arguments Type Intent Optional Attributes Name integer, intent(in) :: n integer, intent(in) :: m integer, intent(in) :: n_loop complex(kind=SP), intent(in) :: D (n) complex(kind=SP), intent(in) :: C complex(kind=SP), intent(out) :: f complex(kind=SP), intent(in) :: Lo (n,m) Return Value integer","tags":"","url":"proc/eps_via_perturbative_inversion.html"},{"title":"SET_defaults – Yambo","text":"subroutine SET_defaults(INSTR, IND, OD, COM_DIR) Uses parallel_m R_lattice com X_m QP_m descriptors BS_solvers openmp pseudo stderr functions y_memory zeros LOGO debug C_driver gpu_m wave_func D_lattice pars QP_CTL_m global_XC ACFDT FFT_m IO_m PHOTOLUM UNITS timing_m TDDFT BS LIVE_t electrons xc_functionals Arguments Type Intent Optional Attributes Name character(len=*) :: INSTR character(len=*) :: IND character(len=*) :: OD character(len=*) :: COM_DIR","tags":"","url":"proc/set_defaults.html"},{"title":"ERFIN – Yambo","text":"subroutine ERFIN() Arguments None Common Blocks SERV1 (subroutine) DERV1 (subroutine) ERMOR (subroutine) ERMSG (subroutine) \">\n           common /M77ERR/ Type Attributes Name Initial integer :: IDELTA integer :: IALPHA","tags":"","url":"proc/erfin.html"},{"title":"k_grids – Yambo","text":"subroutine k_grids(en, k, Xk, q) Uses R_lattice YPP_interfaces stderr D_lattice pars com parser_m vec_operate YPPm zeros LIVE_t electrons Arguments Type Intent Optional Attributes Name type( levels ) :: en type( bz_samp ) :: k type( bz_samp ) :: Xk type( bz_samp ) :: q","tags":"","url":"proc/k_grids.html"},{"title":"io_header – Yambo","text":"function io_header(ID, QPTS, R_LATT, WF, IMPOSE_SN, TEMP, KPTS, D_LATT, XC_KIND, CUTOFF, GAUGE, IMPOSE_GAUGE, ACCEPT_SPIN, PARALLEL_STRUCTURE, FRAG, IMPOSE, NOWARN_SER) Uses parallel_m R_lattice wave_func stderr D_lattice pars X_m IO_m UNITS vec_operate zeros drivers global_XC electrons C_driver IO_int Arguments Type Intent Optional Attributes Name integer :: ID logical, optional :: QPTS logical, optional :: R_LATT logical, optional :: WF logical, optional :: IMPOSE_SN logical, optional :: TEMP logical, optional :: KPTS logical, optional :: D_LATT character(len=*), optional :: XC_KIND logical, optional :: CUTOFF logical, optional :: GAUGE logical, optional :: IMPOSE_GAUGE logical, optional :: ACCEPT_SPIN character(len=*), optional :: PARALLEL_STRUCTURE logical, optional :: FRAG logical, optional :: IMPOSE logical, optional :: NOWARN_SER Return Value integer","tags":"","url":"proc/io_header.html"},{"title":"io_RT_components_Reference – Yambo","text":"subroutine io_RT_components_Reference(ID) Uses R_lattice pars IO_m RT_lifetimes drivers real_time IO_int Arguments Type Intent Optional Attributes Name integer, intent(in) :: ID","tags":"","url":"proc/io_rt_components_reference.html"},{"title":"OBS_rotate – Yambo","text":"subroutine OBS_rotate(R, O, N, direction) Uses pars wrapper Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: R (N,N) complex(kind=SP), intent(inout) :: O (N,N) integer, intent(in) :: N integer, intent(in) :: direction","tags":"","url":"proc/obs_rotate.html"},{"title":"spline_fit – Yambo","text":"subroutine spline_fit(Ni, No, Xi, Yi, Xo, Yo) Uses pars Arguments Type Intent Optional Attributes Name integer, intent(in) :: Ni integer, intent(in) :: No real(kind=SP), intent(in) :: Xi (Ni) real(kind=SP), intent(in) :: Yi (Ni) real(kind=SP), intent(out) :: Xo (No) real(kind=SP), intent(out) :: Yo (No)","tags":"","url":"proc/spline_fit.html"},{"title":"RT_EXP_step_accurate – Yambo","text":"subroutine RT_EXP_step_accurate(dG_old, dG_inp, dG_out, ik, deltaT) Uses wrapper_omp pars real_time Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: dG_old (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) complex(kind=SP), intent(in) :: dG_inp (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) complex(kind=SP), intent(out) :: dG_out (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) integer, intent(in) :: ik real(kind=SP), intent(in) :: deltaT","tags":"","url":"proc/rt_exp_step_accurate.html"},{"title":"electrons_position – Yambo","text":"subroutine electrons_position(nkpt_pos, nband_pos, power, what, format) Uses wave_func D_lattice stderr pars com LIVE_t YPPm FFT_m electrons interfaces wrapper Arguments Type Intent Optional Attributes Name integer :: nkpt_pos (2) integer :: nband_pos (2) real(kind=SP) :: power character(len=11) :: what character(len=2) :: format","tags":"","url":"proc/electrons_position.html"},{"title":"DBSI0E – Yambo","text":"function DBSI0E(X) BEGIN PROLOGUE  DBSI0E PURPOSE  Compute the exponentially scaled modified (hyperbolic)\n            Bessel function of the first kind of order zero. LIBRARY   SLATEC (FNLIB) CATEGORY  C10B1 TYPE      DOUBLE PRECISION (BESI0E-S, DBSI0E-D) KEYWORDS  EXPONENTIALLY SCALED, FIRST KIND, FNLIB,\n             HYPERBOLIC BESSEL FUNCTION, MODIFIED BESSEL FUNCTION,\n             ORDER ZERO, SPECIAL FUNCTIONS AUTHOR  Fullerton, W., (LANL) DESCRIPTION DBSI0E(X) calculates the double precision exponentially scaled\n modified (hyperbolic) Bessel function of the first kind of order\n zero for double precision argument X.  The result is the Bessel\n function I0(X) multiplied by EXP(-ABS(X)). Series for BI0        on the interval  0.          to  9.00000E+00\n                                        with weighted error   9.51E-34\n                                         log weighted error  33.02\n                               significant figures required  33.31\n                                    decimal places required  33.65 Series for AI0        on the interval  1.25000E-01 to  3.33333E-01\n                                        with weighted error   2.74E-32\n                                         log weighted error  31.56\n                               significant figures required  30.15\n                                    decimal places required  32.39 Series for AI02       on the interval  0.          to  1.25000E-01\n                                        with weighted error   1.97E-32\n                                         log weighted error  31.71\n                               significant figures required  30.15\n                                    decimal places required  32.63 REFERENCES  (NONE) ROUTINES CALLED  D1MACH, DCSEVL, INITDS REVISION HISTORY  (YYMMDD)\n   770701  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB) END PROLOGUE  DBSI0E\n**FIRST EXECUTABLE STATEMENT  DBSI0E Arguments Type Intent Optional Attributes Name double precision :: X Return Value doubleprecision","tags":"","url":"proc/dbsi0e.html"},{"title":"PVALUE – Yambo","text":"subroutine PVALUE(L, NDER, X, YFIT, YP, A) BEGIN PROLOGUE  PVALUE PURPOSE  Use the coefficients generated by POLFIT to evaluate the\n            polynomial fit of degree L, along with the first NDER of\n            its derivatives, at a specified point. LIBRARY   SLATEC CATEGORY  K6 TYPE      SINGLE PRECISION (PVALUE-S, DP1VLU-D) KEYWORDS  CURVE FITTING, LEAST SQUARES, POLYNOMIAL APPROXIMATION AUTHOR  Shampine, L. F., (SNLA)\n           Davenport, S. M., (SNLA) DESCRIPTION Written by L . F . Shampine and S . M . Davenport . Abstract The subroutine PVALUE uses the coefficients generated by POLFIT to evaluate the polynomial fit of degree L , along with the first NDER of its derivatives , at a specified point . Computationally stable recurrence relations are used to perform this task . The parameters for PVALUE are Input -- L - the degree of polynomial to be evaluated . L may be any non - negative integer which is less than or equal to NDEG , the highest degree polynomial provided by POLFIT . NDER - the number of derivatives to be evaluated . NDER may be 0 or any positive value . If NDER is less than 0 , it will be treated as 0 . X - the argument at which the polynomial and its derivatives are to be evaluated . A - work and output array containing values from last call to POLFIT . Output -- YFIT - value of the fitting polynomial of degree L at X YP - array containing the first through NDER derivatives of the polynomial of degree L . YP must be dimensioned at least NDER in the calling program . REFERENCES  L. F. Shampine, S. M. Davenport and R. E. Huddleston,\n                 Curve fitting by polynomials in one variable, Report\n                 SLA-74-0270, Sandia Laboratories, June 1974. ROUTINES CALLED  XERMSG REVISION HISTORY  (YYMMDD)\n   740601  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   900510  Convert XERRWV calls to XERMSG calls.  (RWC)\n   920501  Reformatted the REFERENCES section.  (WRB) END PROLOGUE  PVALUE Arguments Type Intent Optional Attributes Name integer :: L integer :: NDER real :: X real :: YFIT real :: YP real :: A","tags":"","url":"proc/pvalue.html"},{"title":"check_for_a_redundant_IO – Yambo","text":"subroutine check_for_a_redundant_IO(path_, cpu_seen_by_me, cpu_seen_by_any) Arguments Type Intent Optional Attributes Name real :: path_ real :: cpu_seen_by_me real :: cpu_seen_by_any","tags":"","url":"proc/check_for_a_redundant_io.html"},{"title":"init_us_0 – Yambo","text":"subroutine init_us_0() Uses io_global constants kinds ions_base uspp_param mp gvect atom cell_base mp_bands us Arguments None","tags":"","url":"proc/init_us_0.html"},{"title":"k_map_fine_to_coarse_reduce – Yambo","text":"function k_map_fine_to_coarse_reduce(FineGd_k) Uses R_lattice pars zeros vec_operate LIVE_t Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(inout) :: FineGd_k Return Value logical","tags":"","url":"proc/k_map_fine_to_coarse_reduce.html"},{"title":"K_stored_in_a_big_matrix – Yambo","text":"subroutine K_stored_in_a_big_matrix(i_BS_mat, iq, what) Uses pars BS_solvers timing_m BS parallel_int Arguments Type Intent Optional Attributes Name integer, intent(in) :: i_BS_mat integer, intent(in) :: iq character(len=*), intent(in) :: what","tags":"","url":"proc/k_stored_in_a_big_matrix.html"},{"title":"DQK61 – Yambo","text":"subroutine DQK61(F, A, B, RESULT, ABSERR, RESABS, RESASC) BEGIN PROLOGUE  DQK61 PURPOSE  To compute I = Integral of F over (A,B) with error\n                           estimate\n                       J = Integral of ABS(F) over (A,B) LIBRARY   SLATEC (QUADPACK) CATEGORY  H2A1A2 TYPE      DOUBLE PRECISION (QK61-S, DQK61-D) KEYWORDS  61-POINT GAUSS-KRONROD RULES, QUADPACK, QUADRATURE AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Integration rule Standard fortran subroutine Double precision version PARAMETERS ON ENTRY F - Double precision Function subprogram defining the integrand function F ( X ) . The actual name for F needs to be declared E X T E R N A L in the calling program . A - Double precision Lower limit of integration B - Double precision Upper limit of integration ON RETURN RESULT - Double precision Approximation to the integral I RESULT is computed by applying the 61 - point Kronrod rule ( RESK ) obtained by optimal addition of abscissae to the 30 - point Gauss rule ( RESG ) . ABSERR - Double precision Estimate of the modulus of the absolute error , which should equal or exceed ABS ( I - RESULT ) RESABS - Double precision Approximation to the integral J RESASC - Double precision Approximation to the integral of ABS ( F - I / ( B - A )) REFERENCES  (NONE) ROUTINES CALLED  D1MACH REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB) END PROLOGUE  DQK61 **FIRST EXECUTABLE STATEMENT  DQK61 Arguments Type Intent Optional Attributes Name real :: F double precision :: A double precision :: B double precision :: RESULT double precision :: ABSERR double precision :: RESABS double precision :: RESASC","tags":"","url":"proc/dqk61.html"},{"title":"MEM_manager_init – Yambo","text":"subroutine MEM_manager_init(what, adding, Sz, i_SHELF, i_COMPONENT, i_SAVE, SHELF, TRUNK, just_started) Uses pars com y_memory drivers C_driver Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: what logical, intent(in) :: adding integer(kind=IPL), intent(in) :: Sz integer, intent(out) :: i_SHELF integer, intent(out) :: i_COMPONENT integer, intent(out) :: i_SAVE character(len=schlen), intent(out) :: SHELF character(len=schlen), intent(out) :: TRUNK logical, intent(out) :: just_started","tags":"","url":"proc/mem_manager_init.html"},{"title":"Pseudo_KB_FFT – Yambo","text":"subroutine Pseudo_KB_FFT(kbv, kbv_real_space, kpt, pp_range, npp, i_atom, is, ia, ik) Uses wave_func D_lattice pars drivers FFT_m electrons Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: kbv (wf_ncx,n_spinor,4,npp) complex(kind=SP), intent(out) :: kbv_real_space (fft_size,n_spinor,pp_range(1):pp_range(2)) real(kind=SP), intent(in) :: kpt (3) integer, intent(in) :: pp_range (2) integer, intent(in) :: npp integer, intent(in) :: i_atom integer, intent(in) :: is integer, intent(in) :: ia integer, intent(in) :: ik","tags":"","url":"proc/pseudo_kb_fft.html"},{"title":"fix_WFs_and_E – Yambo","text":"subroutine fix_WFs_and_E(E, k, k_save, kpoints_map, old_nsym, S_contains_TR) Uses R_lattice wave_func D_lattice YPP_symm pars com IO_m LIVE_t electrons interfaces IO_int Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: E type( bz_samp ), intent(inout) :: k type( bz_samp ), intent(in) :: k_save integer, intent(in) :: kpoints_map (2,k%nibz) integer, intent(in) :: old_nsym integer(kind=LP), intent(in) :: S_contains_TR (old_nsym)","tags":"","url":"proc/fix_wfs_and_e.html"},{"title":"map_energies – Yambo","text":"subroutine map_energies(E, E_new, k, kpoints_map) Uses R_lattice electrons Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: E type( levels ), intent(out) :: E_new type( bz_samp ), intent(in) :: k integer, intent(in) :: kpoints_map (2,k%nibz)","tags":"","url":"proc/map_energies.html"},{"title":"V_qp_basis_to_H – Yambo","text":"subroutine V_qp_basis_to_H(ik, i_sp_pol, V, H) Uses parallel_m matrix_operate pars QP_m timing_m hamiltonian electrons Arguments Type Intent Optional Attributes Name integer :: ik integer :: i_sp_pol complex(kind=SP), intent(in) :: V (QP_n_states) complex(kind=SP), intent(out) :: H (H_ref_bands(1):H_ref_bands(2),H_ref_bands(1):H_ref_bands(2))","tags":"","url":"proc/v_qp_basis_to_h.html"},{"title":"X_GreenF_analytical – Yambo","text":"subroutine X_GreenF_analytical(iq, transitions, Xw, Xen, Xk, GreenF, ordering, space, no_occupations, X_terminator) Uses parallel_m R_lattice pars X_m frequency BS_solvers UNITS electrons Arguments Type Intent Optional Attributes Name integer :: iq integer :: transitions (4) type( w_samp ) :: Xw type( levels ) :: Xen type( bz_samp ) :: Xk complex(kind=SP) :: GreenF (Xw%n_freqs) character(len=*) :: ordering character(len=*) :: space logical :: no_occupations logical :: X_terminator","tags":"","url":"proc/x_greenf_analytical.html"},{"title":"NL_driver – Yambo","text":"subroutine NL_driver(E, X, Xw, k, q, Dip) Uses parallel_m R_lattice nl_optics com DIPOLES X_m QP_m vec_operate parallel_int ALLOC real_time interfaces electric wave_func pars collision_ext frequency QP_CTL_m hamiltonian fields IO_m drivers LIVE_t electrons Arguments Type Intent Optional Attributes Name type( levels ) :: E type( X_t ) :: X (2) type( w_samp ) :: Xw (2) type( bz_samp ) :: k type( bz_samp ) :: q type( DIPOLE_t ) :: Dip","tags":"","url":"proc/nl_driver.html"},{"title":"cutoff_driver – Yambo","text":"subroutine cutoff_driver(q) Uses R_lattice stderr pars com parser_m IO_m timing_m vec_operate drivers IO_int Arguments Type Intent Optional Attributes Name type( bz_samp ) :: q","tags":"","url":"proc/cutoff_driver.html"},{"title":"INIT_QP_ctl_switch – Yambo","text":"subroutine INIT_QP_ctl_switch(what) Uses electrons Arguments Type Intent Optional Attributes Name character(len=1) :: what","tags":"","url":"proc/init_qp_ctl_switch.html"},{"title":"QAGE – Yambo","text":"subroutine QAGE(F, A, B, EPSABS, EPSREL, KEY, LIMIT, RESULT, ABSERR, NEVAL, IER, ALIST, BLIST, RLIST, ELIST, IORD, LAST) BEGIN PROLOGUE  QAGE PURPOSE  The routine calculates an approximation result to a given\n            definite integral   I = Integral of F over (A,B),\n            hopefully satisfying following claim for accuracy\n            ABS(I-RESLT).LE.MAX(EPSABS,EPSREL ABS(I)). LIBRARY   SLATEC (QUADPACK) CATEGORY  H2A1A1 TYPE      SINGLE PRECISION (QAGE-S, DQAGE-D) KEYWORDS  AUTOMATIC INTEGRATOR, GAUSS-KRONROD RULES,\n             GENERAL-PURPOSE, GLOBALLY ADAPTIVE, INTEGRAND EXAMINATOR,\n             QUADPACK, QUADRATURE AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven *DESCRIPTION Computation of a definite integral Standard fortran subroutine Real version PARAMETERS ON ENTRY F - Real Function subprogram defining the integrand function F ( X ). The actual name for F needs to be declared E X T E R N A L in the driver program . A - Real Lower limit of integration B - Real Upper limit of integration EPSABS - Real Absolute accuracy requested EPSREL - Real Relative accuracy requested If EPSABS . LE .0 and EPSREL . LT . MAX ( 50 * REL . MACH . ACC ., 0.5 D - 28 ), the routine will end with IER = 6 . KEY - Integer Key for choice of local integration rule A Gauss - Kronrod pair is used with 7 - 15 points if KEY . LT .2 , 10 - 21 points if KEY = 2 , 15 - 31 points if KEY = 3 , 20 - 41 points if KEY = 4 , 25 - 51 points if KEY = 5 , 30 - 61 points if KEY . GT .5 . LIMIT - Integer Gives an upper bound on the number of subintervals in the partition of ( A , B ), LIMIT . GE .1 . ON RETURN RESULT - Real Approximation to the integral ABSERR - Real Estimate of the modulus of the absolute error , which should equal or exceed ABS ( I - RESULT ) NEVAL - Integer Number of integrand evaluations IER - Integer IER = 0 Normal and reliable termination of the routine . It is assumed that the requested accuracy has been achieved . IER . GT .0 Abnormal termination of the routine The estimates for result and error are less reliable . It is assumed that the requested accuracy has not been achieved . ERROR MESSAGES IER = 1 Maximum number of subdivisions allowed has been achieved . One can allow more subdivisions by increasing the value of LIMIT . However , if this yields no improvement it is rather advised to analyze the integrand in order to determine the integration difficulties . If the position of a local difficulty can be determined ( e . g . SINGULARITY , DISCONTINUITY within the interval ) one will probably gain from splitting up the interval at this point and calling the integrator on the subranges . If possible , an appropriate special - purpose integrator should be used which is designed for handling the type of difficulty involved . = 2 The occurrence of roundoff error is detected , which prevents the requested tolerance from being achieved . = 3 Extremely bad integrand behaviour occurs at some points of the integration interval . = 6 The input is invalid , because ( EPSABS . LE .0 and EPSREL . LT . MAX ( 50 * REL . MACH . ACC ., 0.5 D - 28 ), RESULT , ABSERR , NEVAL , LAST , RLIST ( 1 ) , ELIST ( 1 ) and IORD ( 1 ) are set to zero . ALIST ( 1 ) and BLIST ( 1 ) are set to A and B respectively . ALIST - Real Vector of dimension at least LIMIT , the first LAST elements of which are the left end points of the subintervals in the partition of the given integration range ( A , B ) BLIST - Real Vector of dimension at least LIMIT , the first LAST elements of which are the right end points of the subintervals in the partition of the given integration range ( A , B ) RLIST - Real Vector of dimension at least LIMIT , the first LAST elements of which are the integral approximations on the subintervals ELIST - Real Vector of dimension at least LIMIT , the first LAST elements of which are the moduli of the absolute error estimates on the subintervals IORD - Integer Vector of dimension at least LIMIT , the first K elements of which are pointers to the error estimates over the subintervals , such that ELIST ( IORD ( 1 )), ... , ELIST ( IORD ( K )) form a decreasing sequence , with K = LAST if LAST . LE .( LIMIT / 2 + 2 ), and K = LIMIT + 1 - LAST otherwise LAST - Integer Number of subintervals actually produced in the subdivision process REFERENCES  (NONE) ROUTINES CALLED  QK15, QK21, QK31, QK41, QK51, QK61, QPSRT, R1MACH REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890831  Modified array declarations.  (WRB)\n   890831  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB) END PROLOGUE  QAGE **FIRST EXECUTABLE STATEMENT  QAGE Arguments Type Intent Optional Attributes Name real :: F real :: A real :: B real :: EPSABS real :: EPSREL integer :: KEY integer :: LIMIT real :: RESULT real :: ABSERR integer :: NEVAL integer :: IER real, dimension(*) :: ALIST real, dimension(*) :: BLIST real, dimension(*) :: RLIST real, dimension(*) :: ELIST integer, dimension(*) :: IORD integer :: LAST","tags":"","url":"proc/qage.html"},{"title":"XCo_local – Yambo","text":"subroutine XCo_local(E, Xk) Uses parallel_m R_lattice parallel_int wave_func pseudo wrapper_omp pars QP_m global_XC timing_m FFT_m electrons xc_functionals Arguments Type Intent Optional Attributes Name type( levels ) :: E type( bz_samp ) :: Xk","tags":"","url":"proc/xco_local.html"},{"title":"p2y_pseudo – Yambo","text":"subroutine p2y_pseudo(k) Uses R_lattice pw_struct_module wave_func D_lattice pseudo pw_wfc_module pars pw_atoms_module read_pseudo_mod pw_basis_module IO_m IO_int Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: k","tags":"","url":"proc/p2y_pseudo.html"},{"title":"fill_struct – Yambo","text":"subroutine fill_struct(struct) Uses R_lattice pw_struct_module D_lattice Arguments Type Intent Optional Attributes Name type( pw_struct ), intent(out) :: struct","tags":"","url":"proc/fill_struct.html"},{"title":"fill_atoms – Yambo","text":"subroutine fill_atoms(atoms, struct) Uses pw_struct_module D_lattice pw_data pw_atoms_module pw_pseudo_module Arguments Type Intent Optional Attributes Name type( pw_atoms ) :: atoms type( pw_struct ), intent(in) :: struct","tags":"","url":"proc/fill_atoms.html"},{"title":"fill_a_pseudo – Yambo","text":"subroutine fill_a_pseudo(psfile, pseudo) Uses pars pw_pseudo_read_m pw_pseudo_module pw_data Arguments Type Intent Optional Attributes Name character(len=256), intent(in) :: psfile type( pw_pseudo ), intent(inout) :: pseudo","tags":"","url":"proc/fill_a_pseudo.html"},{"title":"fill_basis – Yambo","text":"subroutine fill_basis(basis, struct, ik, ngmax) Uses pw_basis_module pw_data pw_struct_module wave_func Arguments Type Intent Optional Attributes Name type( pw_basis ) :: basis type( pw_struct ), target :: struct integer, intent(in) :: ik integer, intent(in) :: ngmax","tags":"","url":"proc/fill_basis.html"},{"title":"fill_basis_rho – Yambo","text":"subroutine fill_basis_rho(basis, struct, ngmax) Uses pw_basis_module pw_data pw_struct_module Arguments Type Intent Optional Attributes Name type( pw_basis ) :: basis type( pw_struct ), target :: struct integer, intent(in) :: ngmax","tags":"","url":"proc/fill_basis_rho.html"},{"title":"QP_load_SC_xc – Yambo","text":"subroutine QP_load_SC_xc() Uses R_lattice linear_algebra QP_m IO_m SC hamiltonian electrons interfaces Arguments None","tags":"","url":"proc/qp_load_sc_xc.html"},{"title":"NL_Integrator – Yambo","text":"subroutine NL_Integrator(E, k, q, X, Integrator, i_time, V_bands) Uses parallel_m R_lattice pars nl_optics X_m QP_m parallel_int electrons real_time Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: E type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: q type( X_t ), intent(in) :: X integer, intent(in) :: Integrator integer, intent(in) :: i_time complex(kind=SP), intent(inout) :: V_bands (NL_bands(2),maxval(E%nbf),QP_nk,n_sp_pol)","tags":"","url":"proc/nl_integrator.html"},{"title":"XGETUA – Yambo","text":"subroutine XGETUA(IUNITA, N) BEGIN PROLOGUE  XGETUA PURPOSE  Return unit number(s) to which error messages are being\n            sent. LIBRARY   SLATEC (XERROR) CATEGORY  R3C TYPE      ALL (XGETUA-A) KEYWORDS  ERROR, XERROR AUTHOR  Jones, R. E., (SNLA) DESCRIPTION Abstract XGETUA may be called to determine the unit number or numbers to which error messages are being sent . These unit numbers may have been set by a call to XSETUN , or a call to XSETUA , or may be a default value . Description of Parameters -- Output -- IUNIT - an array of one to five unit numbers , depending on the value of N . A value of zero refers to the default unit , as defined by the I1MACH machine constant routine . Only IUNIT ( 1 ), ... , IUNIT ( N ) are defined by XGETUA . The values of IUNIT ( N + 1 ), ... , IUNIT ( 5 ) are not defined ( for N . LT . 5 ) or altered in any way by XGETUA . N - the number of units to which copies of the error messages are being sent . N will be in the range from 1 to 5. REFERENCES  R. E. Jones and D. K. Kahaner, XERROR, the SLATEC\n                 Error-handling Package, SAND82-0800, Sandia\n                 Laboratories, 1982. ROUTINES CALLED  J4SAVE REVISION HISTORY  (YYMMDD)\n   790801  DATE WRITTEN\n   861211  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   920501  Reformatted the REFERENCES section.  (WRB) END PROLOGUE  XGETUA\n**FIRST EXECUTABLE STATEMENT  XGETUA Arguments Type Intent Optional Attributes Name integer :: IUNITA integer :: N","tags":"","url":"proc/xgetua.html"},{"title":"WF_shift_kpoint – Yambo","text":"subroutine WF_shift_kpoint(b_to_shift, nb_to_shift, ikbz, wf_shift, Xk, WF_k_in, WF_k_out) Uses R_lattice gpu_m devxlib wave_func pars electrons Arguments Type Intent Optional Attributes Name integer, intent(in) :: b_to_shift (2) integer, intent(in) :: nb_to_shift integer, intent(in) :: ikbz integer, intent(in) :: wf_shift (3) type( bz_samp ), intent(in) :: Xk complex(kind=SP), intent(in) :: WF_k_in (wf_ng_1st_BZ,n_spinor,nb_to_shift) complex(kind=SP), intent(out) :: WF_k_out (wf_ng_overlaps,n_spinor,nb_to_shift)","tags":"","url":"proc/wf_shift_kpoint.html"},{"title":"SC_driver – Yambo","text":"subroutine SC_driver(X, Xw, Xk, E, k, q, Dip) Uses parallel_m R_lattice com DIPOLES X_m QP_m vec_operate parallel_int ALLOC interfaces stderr SC H_interfaces IO_int electric wave_func linear_algebra pars collision_ext frequency hamiltonian FFT_m IO_m UNITS drivers LIVE_t electrons xc_functionals Arguments Type Intent Optional Attributes Name type( X_t ) :: X (2) type( w_samp ) :: Xw (2) type( bz_samp ) :: Xk type( levels ) :: E type( bz_samp ) :: k type( bz_samp ) :: q type( DIPOLE_t ) :: Dip","tags":"","url":"proc/sc_driver.html"},{"title":"TDDFT_ALDA_eh_space_G_collisions_L – Yambo","text":"subroutine TDDFT_ALDA_eh_space_G_collisions_L(iq, Xk, i_T_grp, NG, l_bs_tddft_wf_in_loop, tddft_wf, mode) Uses R_lattice wave_func pars openmp timing_m TDDFT BS FFT_m electrons interfaces Arguments Type Intent Optional Attributes Name integer, intent(in) :: iq type( bz_samp ), intent(in) :: Xk integer, intent(in) :: i_T_grp integer, intent(in) :: NG (2) logical, intent(in) :: l_bs_tddft_wf_in_loop type( tddft_wf_t ), intent(inout), target :: tddft_wf character(len=1), intent(in) :: mode","tags":"","url":"proc/tddft_alda_eh_space_g_collisions_l.html"},{"title":"perform_fft_3d – Yambo","text":"subroutine perform_fft_3d(qs, rhotw, O_x) Uses BS pars R_lattice FFT_m Arguments Type Intent Optional Attributes Name integer, intent(in) :: qs (3) complex(kind=DP), intent(in) :: rhotw (fft_size) complex(kind=SP), intent(out) :: O_x (BS_n_g_fxc)","tags":"","url":"proc/perform_fft_3d.html"},{"title":"QPartilize – Yambo","text":"subroutine QPartilize(N, G, W, E, Z, dG_step) Uses pars Arguments Type Intent Optional Attributes Name integer, intent(in) :: N complex(kind=SP), intent(in) :: G (N) real(kind=SP), intent(in) :: W (N) complex(kind=SP), intent(out) :: E complex(kind=SP), intent(out) :: Z real(kind=SP), intent(inout) :: dG_step","tags":"","url":"proc/qpartilize.html"},{"title":"OUTPUT_driver – Yambo","text":"subroutine OUTPUT_driver(file, action, TITLES, I_VALUES, R_VALUES, ORDER, UNIT, KIND) Uses OUTPUT pars com stderr Arguments Type Intent Optional Attributes Name character(len=*) :: file character(len=*), optional :: action character(len=*), optional :: TITLES (:) integer, optional :: I_VALUES (:) real(kind=SP), optional :: R_VALUES (:) character(len=*), optional :: ORDER (:) character(len=*), optional :: UNIT character(len=*), optional :: KIND","tags":"","url":"proc/output_driver.html"},{"title":"setqf – Yambo","text":"subroutine setqf(qfcoef, rho, r, nqf, ltot, mesh) Uses pars Arguments Type Intent Optional Attributes Name real(kind=SP) :: qfcoef (nqf) real(kind=SP) :: rho (mesh) real(kind=SP) :: r (mesh) integer :: nqf integer :: ltot integer :: mesh","tags":"","url":"proc/setqf.html"},{"title":"RT_apply_Texp – Yambo","text":"subroutine RT_apply_Texp(H1, Gret, H2, deltaT, eta, n_order) Uses wrapper_omp pars real_time Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: H1 (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) complex(kind=SP), intent(inout) :: Gret (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) complex(kind=SP), intent(in) :: H2 (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) real(kind=SP), intent(in) :: deltaT real(kind=SP), intent(in) :: eta integer, intent(in) :: n_order","tags":"","url":"proc/rt_apply_texp.html"},{"title":"excitons_driver – Yambo","text":"subroutine excitons_driver(k, Xk, en, Xen, q) Uses R_lattice YPP_interfaces stderr pars BS_solvers YPPm electrons Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k type( bz_samp ) :: Xk type( levels ) :: en type( levels ) :: Xen type( bz_samp ) :: q","tags":"","url":"proc/excitons_driver.html"},{"title":"BESJ0 – Yambo","text":"function BESJ0(X) BEGIN PROLOGUE  BESJ0 PURPOSE  Compute the Bessel function of the first kind of order\n            zero. LIBRARY   SLATEC (FNLIB) CATEGORY  C10A1 TYPE      SINGLE PRECISION (BESJ0-S, DBESJ0-D) KEYWORDS  BESSEL FUNCTION, FIRST KIND, FNLIB, ORDER ZERO,\n             SPECIAL FUNCTIONS AUTHOR  Fullerton, W., (LANL) DESCRIPTION BESJ0(X) calculates the Bessel function of the first kind of\n order zero for real argument X. Series for BJ0        on the interval  0.          to  1.60000D+01\n                                        with weighted error   7.47E-18\n                                         log weighted error  17.13\n                               significant figures required  16.98\n                                    decimal places required  17.68 Series for BM0        on the interval  0.          to  6.25000D-02\n                                        with weighted error   4.98E-17\n                                         log weighted error  16.30\n                               significant figures required  14.97\n                                    decimal places required  16.96 Series for BTH0       on the interval  0.          to  6.25000D-02\n                                        with weighted error   3.67E-17\n                                         log weighted error  16.44\n                               significant figures required  15.53\n                                    decimal places required  17.13 REFERENCES  (NONE) ROUTINES CALLED  CSEVL, INITS, R1MACH, XERMSG REVISION HISTORY  (YYMMDD)\n   770401  DATE WRITTEN\n   890210  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   900326  Removed duplicate information from DESCRIPTION section.\n           (WRB) END PROLOGUE  BESJ0\n**FIRST EXECUTABLE STATEMENT  BESJ0 Arguments Type Intent Optional Attributes Name real :: X Return Value real","tags":"","url":"proc/besj0.html"},{"title":"QP_expand – Yambo","text":"subroutine QP_expand(k, qp, qp_expanded) Uses R_lattice pars QP_m descriptors electrons Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k type( QP_t ) :: qp type( QP_t ) :: qp_expanded","tags":"","url":"proc/qp_expand.html"},{"title":"RT_G_lesser_init – Yambo","text":"subroutine RT_G_lesser_init() Uses parallel_m R_lattice pars RT_occupations real_time Arguments None","tags":"","url":"proc/rt_g_lesser_init.html"},{"title":"Dipole_kb_Ylm – Yambo","text":"subroutine Dipole_kb_Ylm(Ylm, dYlm, Ygrad, lang, k) Uses pars Arguments Type Intent Optional Attributes Name complex(kind=SP) :: Ylm (lang,2*(lang-1)+1) complex(kind=SP) :: dYlm (2,lang,2*(lang-1)+1) real(kind=SP) :: Ygrad (2,3) integer :: lang real(kind=SP) :: k (3)","tags":"","url":"proc/dipole_kb_ylm.html"},{"title":"RT_databases_IO – Yambo","text":"subroutine RT_databases_IO(E, DO_IT) Uses RT_control parallel_m fields IO_m timing_m parallel_int electrons real_time IO_int Arguments Type Intent Optional Attributes Name type( levels ) :: E logical :: DO_IT","tags":"","url":"proc/rt_databases_io.html"},{"title":"Build_overlaps_det_NEQ – Yambo","text":"subroutine Build_overlaps_det_NEQ(en, Xk, i_sp, ikbz, V_bands, Sm1_plus, Sm1_minus, S_det) Uses R_lattice pars DIPOLES QP_m electric vec_operate hamiltonian electrons wrapper Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: en type( bz_samp ), intent(in) :: Xk integer, intent(in) :: i_sp integer, intent(in) :: ikbz complex(kind=SP), intent(in) :: V_bands (H_ref_bands(2),en%nbf(i_sp),QP_nk) complex(kind=SP), intent(out) :: Sm1_plus (en%nbf(i_sp),en%nbf(i_sp),6) complex(kind=SP), intent(out) :: Sm1_minus (en%nbf(i_sp),en%nbf(i_sp),6) complex(kind=SP), intent(out) :: S_det (6)","tags":"","url":"proc/build_overlaps_det_neq.html"},{"title":"RT_apply_RWA – Yambo","text":"subroutine RT_apply_RWA(ik, E, k, dT, dTp, dG_out, dG_in) Uses pars electrons R_lattice real_time Arguments Type Intent Optional Attributes Name integer, intent(in) :: ik type( levels ), intent(in) :: E type( bz_samp ), intent(in) :: k real(kind=SP), intent(in) :: dT real(kind=SP), intent(in) :: dTp complex(kind=SP), intent(inout) :: dG_out (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) complex(kind=SP), intent(in) :: dG_in (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2))","tags":"","url":"proc/rt_apply_rwa.html"},{"title":"io_RT_components_TIME_points – Yambo","text":"subroutine io_RT_components_TIME_points(ID, VAR_SZ, load_RESTART_info, UNLIMITED_time, TYP) Uses RT_control RT_output_m pars netcdf IO_m UNITS drivers real_time IO_int Arguments Type Intent Optional Attributes Name integer, intent(in) :: ID integer, intent(in) :: VAR_SZ logical, intent(in) :: load_RESTART_info logical, intent(in) :: UNLIMITED_time type( RT_IO_t ), intent(inout) :: TYP","tags":"","url":"proc/io_rt_components_time_points.html"},{"title":"K_inversion_restart – Yambo","text":"subroutine K_inversion_restart(iq, W) Uses parallel_m pars com X_m frequency IO_m PHOTOLUM BS_solvers BS IO_int Arguments Type Intent Optional Attributes Name integer, intent(inout) :: iq type( w_samp ), intent(inout) :: W","tags":"","url":"proc/k_inversion_restart.html"},{"title":"io_SC_components – Yambo","text":"function io_SC_components(what, E_sc, ID) Uses R_lattice stderr pars IO_m SC timing_m drivers hamiltonian FFT_m electrons IO_int Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: what type( levels ) :: E_sc integer, intent(in) :: ID Return Value integer","tags":"","url":"proc/io_sc_components.html"},{"title":"K_exchange_collisions – Yambo","text":"subroutine K_exchange_collisions(iq, Xk, i_T_grp, NG, l_bs_exch_wf_in_loop) Uses R_lattice collision_el wave_func devxlib D_lattice stderr pars timing_m BS openmp electrons interfaces Arguments Type Intent Optional Attributes Name integer, intent(in) :: iq type( bz_samp ), intent(in) :: Xk integer, intent(in) :: i_T_grp integer, intent(in) :: NG (2) logical, intent(in) :: l_bs_exch_wf_in_loop","tags":"","url":"proc/k_exchange_collisions.html"},{"title":"REPORT_Energies – Yambo","text":"subroutine REPORT_Energies(E, k, Xk, n_bands_, k_range, what, l_kpoints, l_what) Uses R_lattice wave_func stderr pars com UNITS vec_operate electrons Arguments Type Intent Optional Attributes Name real(kind=SP), intent(in) :: E (n_bands_,k%nibz,n_sp_pol) type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: Xk integer, intent(in) :: n_bands_ integer, intent(in) :: k_range (2) character(len=*), intent(in) :: what logical, intent(in) :: l_kpoints logical, intent(in) :: l_what","tags":"","url":"proc/report_energies.html"},{"title":"X_GreenF_remap – Yambo","text":"subroutine X_GreenF_remap(bands, E, W) Uses pars frequency UNITS LIVE_t electrons Arguments Type Intent Optional Attributes Name integer :: bands (2) type( levels ) :: E type( w_samp ) :: W","tags":"","url":"proc/x_greenf_remap.html"},{"title":"PARALLEL_Haydock_VEC_COMMs – Yambo","text":"subroutine PARALLEL_Haydock_VEC_COMMs(what) Uses parallel_m BS Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: what","tags":"","url":"proc/parallel_haydock_vec_comms.html"},{"title":"INIT_read_command_line – Yambo","text":"subroutine INIT_read_command_line(rstr, init_) Uses stderr pars X_m QP_m it_tools BS_solvers y_memory it_m drivers BS LIVE_t Arguments Type Intent Optional Attributes Name character(len=*) :: rstr integer :: init_","tags":"","url":"proc/init_read_command_line.html"},{"title":"p2y_db1 – Yambo","text":"subroutine p2y_db1(en, k) Uses R_lattice wave_func com mod_com2y electrons xc_functionals P2Ym Arguments Type Intent Optional Attributes Name type( levels ), intent(out) :: en type( bz_samp ), intent(out) :: k","tags":"","url":"proc/p2y_db1.html"},{"title":"QP_fit_energies – Yambo","text":"subroutine QP_fit_energies(i_ACTION, bands, en, qp) Uses pars QP_m QP_CTL_m POL_FIT_m electrons Arguments Type Intent Optional Attributes Name integer :: i_ACTION integer :: bands (2) type( levels ) :: en type( QP_t ) :: qp","tags":"","url":"proc/qp_fit_energies.html"},{"title":"symmetries_driver – Yambo","text":"subroutine symmetries_driver(E, Xk) Uses R_lattice wave_func D_lattice stderr pars com parser_m IO_m FFT_m electrons xc_functionals interfaces IO_int Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: E type( bz_samp ), intent(inout) :: Xk","tags":"","url":"proc/symmetries_driver.html"},{"title":"Ionic_polarization – Yambo","text":"subroutine Ionic_polarization(I_Berry_RED, en) Uses R_lattice D_lattice pars vec_operate electrons Arguments Type Intent Optional Attributes Name real(kind=SP), intent(out) :: I_Berry_RED (3) type( levels ), intent(in) :: en","tags":"","url":"proc/ionic_polarization.html"},{"title":"io_KB_pwscf – Yambo","text":"function io_KB_pwscf(ID) Uses R_lattice pseudo D_lattice stderr pars IO_m timing_m IO_int Arguments Type Intent Optional Attributes Name integer, intent(in) :: ID Return Value integer","tags":"","url":"proc/io_kb_pwscf.html"},{"title":"DP1VLU – Yambo","text":"subroutine DP1VLU(L, NDER, X, YFIT, YP, A) BEGIN PROLOGUE  DP1VLU PURPOSE  Use the coefficients generated by DPOLFT to evaluate the\n            polynomial fit of degree L, along with the first NDER of\n            its derivatives, at a specified point. LIBRARY   SLATEC CATEGORY  K6 TYPE      DOUBLE PRECISION (PVALUE-S, DP1VLU-D) KEYWORDS  CURVE FITTING, LEAST SQUARES, POLYNOMIAL APPROXIMATION AUTHOR  Shampine, L. F., (SNLA)\n           Davenport, S. M., (SNLA) DESCRIPTION Abstract The subroutine DP1VLU uses the coefficients generated by DPOLFT to evaluate the polynomial fit of degree L , along with the first NDER of its derivatives , at a specified point . Computationally stable recurrence relations are used to perform this task . The parameters for DP1VLU are Input -- ALL TYPE REAL variables are DOUBLE PRECISION L - the degree of polynomial to be evaluated . L may be any non - negative integer which is less than or equal to NDEG , the highest degree polynomial provided by DPOLFT . NDER - the number of derivatives to be evaluated . NDER may be 0 or any positive value . If NDER is less than 0 , it will be treated as 0. X - the argument at which the polynomial and its derivatives are to be evaluated . A - work and output array containing values from last call to DPOLFT . Output -- ALL TYPE REAL variables are DOUBLE PRECISION YFIT - value of the fitting polynomial of degree L at X YP - array containing the first through NDER derivatives of the polynomial of degree L . YP must be dimensioned at least NDER in the calling program . REFERENCES  L. F. Shampine, S. M. Davenport and R. E. Huddleston,\n                 Curve fitting by polynomials in one variable, Report\n                 SLA-74-0270, Sandia Laboratories, June 1974. ROUTINES CALLED  XERMSG REVISION HISTORY  (YYMMDD)\n   740601  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890911  Removed unnecessary intrinsics.  (WRB)\n   891006  Cosmetic changes to prologue.  (WRB)\n   891006  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   900510  Convert XERRWV calls to XERMSG calls.  (RWC)\n   920501  Reformatted the REFERENCES section.  (WRB) END PROLOGUE  DP1VLU Arguments Type Intent Optional Attributes Name integer :: L integer :: NDER double precision :: X double precision :: YFIT double precision :: YP (*) double precision :: A (*)","tags":"","url":"proc/dp1vlu.html"},{"title":"FDUMP – Yambo","text":"subroutine FDUMP() BEGIN PROLOGUE  FDUMP PURPOSE  Symbolic dump (should be locally written). LIBRARY   SLATEC (XERROR) CATEGORY  R3 TYPE      ALL (FDUMP-A) KEYWORDS  ERROR, XERMSG AUTHOR  Jones, R. E., (SNLA) DESCRIPTION ***Note*** Machine Dependent Routine\n    FDUMP is intended to be replaced by a locally written\n    version which produces a symbolic dump.  Failing this,\n    it should be replaced by a version which prints the\n    subprogram nesting list.  Note that this dump must be\n    printed on each of up to five files, as indicated by the\n    XGETUA routine.  See XSETUA and XGETUA for details.\n\n Written by Ron Jones, with SLATEC Common Math Library Subcommittee REFERENCES  (NONE) ROUTINES CALLED  (NONE) REVISION HISTORY  (YYMMDD)\n   790801  DATE WRITTEN\n   861211  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB) END PROLOGUE  FDUMP\n**FIRST EXECUTABLE STATEMENT  FDUMP Arguments None","tags":"","url":"proc/fdump.html"},{"title":"RT_Glesser_evolve – Yambo","text":"subroutine RT_Glesser_evolve(En, kpt, dG_old, dG_in, dG_out, dT, dTp) Uses parallel_m R_lattice pars electrons real_time Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: En type( bz_samp ), intent(in) :: kpt complex(kind=SP), intent(in) :: dG_old (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2),PAR_G_k_range(1):PAR_G_k_range(2)) complex(kind=SP), intent(in) :: dG_in (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2),PAR_G_k_range(1):PAR_G_k_range(2)) complex(kind=SP), intent(out) :: dG_out (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2),PAR_G_k_range(1):PAR_G_k_range(2)) real(kind=SP), intent(in) :: dT real(kind=SP), intent(in) :: dTp","tags":"","url":"proc/rt_glesser_evolve.html"},{"title":"col_driver – Yambo","text":"subroutine col_driver(bare_NG, q) Uses R_lattice wave_func stderr D_lattice pars com parser_m frequency IO_m vec_operate drivers IO_int Arguments Type Intent Optional Attributes Name integer :: bare_NG type( bz_samp ) :: q","tags":"","url":"proc/col_driver.html"},{"title":"PL_via_perturbative_inversion – Yambo","text":"function PL_via_perturbative_inversion(n, Lo_dim, n_loop, D, C, f, Lo) Uses wrapper_omp pars BS_solvers Arguments Type Intent Optional Attributes Name integer, intent(in) :: n integer, intent(in) :: Lo_dim integer, intent(in) :: n_loop complex(kind=SP), intent(in) :: D (n,3) real(kind=SP), intent(in) :: C real(kind=SP), intent(out) :: f complex(kind=SP), intent(in) :: Lo (n,Lo_dim) Return Value integer","tags":"","url":"proc/pl_via_perturbative_inversion.html"},{"title":"DAVINT – Yambo","text":"subroutine DAVINT(X, Y, N, XLO, XUP, ANS, IERR) BEGIN PROLOGUE  DAVINT PURPOSE  Integrate a function tabulated at arbitrarily spaced\n            abscissas using overlapping parabolas. LIBRARY   SLATEC CATEGORY  H2A1B2 TYPE      DOUBLE PRECISION (AVINT-S, DAVINT-D) KEYWORDS  INTEGRATION, QUADRATURE, TABULATED DATA AUTHOR  Jones, R. E., (SNLA) DESCRIPTION Abstract DAVINT integrates a function tabulated at arbitrarily spaced abscissas . The limits of integration need not coincide with the tabulated abscissas . A method of overlapping parabolas fitted to the data is used provided that there are at least 3 abscissas between the limits of integration . DAVINT also handles two special cases . If the limits of integration are equal , DAVINT returns a result of zero regardless of the number of tabulated values . If there are only two function values , DAVINT uses the trapezoid rule . Description of Parameters The user must dimension all arrays appearing in the call list X ( N ), Y ( N ) Input -- X - DOUBLE PRECISION array of abscissas , which must be in increasing order . Y - DOUBLE PRECISION array of function values . i . e ., Y ( I ) = FUNC ( X ( I )) N - The integer number of function values supplied . N . GE . 2 unless XLO = XUP . XLO - DOUBLE PRECISION lower limit of integration XUP - DOUBLE PRECISION upper limit of integration . Must have XLO . LE . XUP Output -- ANS - Double Precision computed approximate value of integral IERR - A status code -- Normal Code = 1 Means the requested integration was performed . -- Abnormal Codes = 2 Means XUP was less than XLO . = 3 Means the number of X ( I ) between XLO and XUP ( inclusive ) was less than 3 and neither of the two special cases described in the abstract occurred . No integration was performed . = 4 Means the restriction X ( I + 1 ). GT . X ( I ) was violated . = 5 Means the number N of function values was . lt . 2. ANS is set to zero if IERR = 2 , 3 , 4 , or 5. DAVINT is documented completely in SC - M - 69 - 335 Original program from * Numerical Integration * by Davis & Rabinowitz Adaptation and modifications by Rondall E Jones . REFERENCES  R. E. Jones, Approximate integrator of functions\n                 tabulated at arbitrarily spaced abscissas,\n                 Report SC-M-69-335, Sandia Laboratories, 1969. ROUTINES CALLED  XERMSG REVISION HISTORY  (YYMMDD)\n   690901  DATE WRITTEN\n   890831  Modified array declarations.  (WRB)\n   890831  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   920501  Reformatted the REFERENCES section.  (WRB) END PROLOGUE  DAVINT **FIRST EXECUTABLE STATEMENT  DAVINT Arguments Type Intent Optional Attributes Name double precision, dimension(*) :: X double precision, dimension(*) :: Y integer :: N double precision :: XLO double precision :: XUP double precision :: ANS integer :: IERR","tags":"","url":"proc/davint.html"},{"title":"k_map_E_fine – Yambo","text":"subroutine k_map_E_fine(fg, E, k, MAP) Uses pars electrons R_lattice Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(inout) :: fg type( levels ), intent(inout) :: E type( bz_samp ), intent(inout) :: k integer, intent(inout) :: MAP (fg%nibz)","tags":"","url":"proc/k_map_e_fine.html"},{"title":"En_k_plus_q_interpolate – Yambo","text":"subroutine En_k_plus_q_interpolate(k, q, E, iqbz) Uses R_lattice ELPH interpolate pars electrons Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: q type( levels ), intent(in) :: E integer :: iqbz","tags":"","url":"proc/en_k_plus_q_interpolate.html"},{"title":"ELPH_eliashberg_dos – Yambo","text":"subroutine ELPH_eliashberg_dos(k, en, q) Uses parallel_m R_lattice ELPH ALLOC parallel_int YPP_ELPH pars functions com IO_m UNITS YPPm LIVE_t electrons IO_int Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k type( levels ) :: en type( bz_samp ) :: q","tags":"","url":"proc/elph_eliashberg_dos.html"},{"title":"scatter_Bamp – Yambo","text":"subroutine scatter_Bamp(isc) Uses R_lattice collision_el devxlib pseudo D_lattice pars FFT_m electrons interfaces Arguments Type Intent Optional Attributes Name type( elemental_collision ), target :: isc","tags":"","url":"proc/scatter_bamp.html"},{"title":"ver_is_gt_or_eq – Yambo","text":"function ver_is_gt_or_eq(ID, version, revision) Uses IO_m C_driver Arguments Type Intent Optional Attributes Name integer, intent(in) :: ID integer, intent(in), optional :: version (3) integer, intent(in), optional :: revision Return Value logical","tags":"","url":"proc/ver_is_gt_or_eq.html"},{"title":"NL_start_and_restart – Yambo","text":"subroutine NL_start_and_restart(E, k, Dip) Uses parallel_m R_lattice nl_optics com DIPOLES X_m QP_m parallel_int real_time stderr IO_int pars collision_ext global_XC hamiltonian fields IO_m electrons xc_functionals Arguments Type Intent Optional Attributes Name type( levels ) :: E type( bz_samp ) :: k type( DIPOLE_t ) :: Dip","tags":"","url":"proc/nl_start_and_restart.html"},{"title":"QP_DB_message – Yambo","text":"subroutine QP_DB_message(i_ACTION, qp) Uses stderr pars com QP_m QP_CTL_m Arguments Type Intent Optional Attributes Name integer :: i_ACTION type( QP_t ) :: qp","tags":"","url":"proc/qp_db_message.html"},{"title":"k_expand – Yambo","text":"subroutine k_expand(k) Uses R_lattice D_lattice pars zeros vec_operate |        | X1   |   X2   |\n        |        | |        | X3   |   ko   |\n        |        | In this case we have 8 symmetries and we obtain\nfrom the IRREDUCIBLE ko other 3 REDUCIBLE k-points i\n(X1, X2, X3) rang(ko) = 2  (I plus inversion that sends X2 < - > X3)\nk%nstar(ko) = Num. of symm / rank(ko) = 8/2 = 4 (points in the star) N.B\n rang(ik) = # of symmetries | R_is ik = ik Arguments Type Intent Optional Attributes Name type( bz_samp ) :: k","tags":"","url":"proc/k_expand.html"},{"title":"J4SAVE – Yambo","text":"function J4SAVE(IWHICH, IVALUE, ISET) BEGIN PROLOGUE  J4SAVE SUBSIDIARY PURPOSE  Save or recall global variables needed by error\n            handling routines. LIBRARY   SLATEC (XERROR) TYPE      INTEGER (J4SAVE-I) KEYWORDS  ERROR MESSAGES, ERROR NUMBER, RECALL, SAVE, XERROR AUTHOR  Jones, R. E., (SNLA) DESCRIPTION Abstract J4SAVE saves and recalls several global variables needed by the library error handling routines . Description of Parameters -- Input -- IWHICH - Index of item desired . = 1 Refers to current error number . = 2 Refers to current error control flag . = 3 Refers to current unit number to which error messages are to be sent . ( 0 means use standard . ) = 4 Refers to the maximum number of times any message is to be printed ( as set by XERMAX ) . = 5 Refers to the total number of units to which each error message is to be written . = 6 Refers to the 2 nd unit for error messages = 7 Refers to the 3 rd unit for error messages = 8 Refers to the 4 th unit for error messages = 9 Refers to the 5 th unit for error messages IVALUE - The value to be set for the IWHICH - th parameter , if ISET is . TRUE . . ISET - If ISET =. TRUE . , the IWHICH - th parameter will BE given the value , IVALUE . If ISET =. FALSE . , the IWHICH - th parameter will be unchanged , and IVALUE is a dummy parameter . -- Output -- The ( old ) value of the IWHICH - th parameter will be returned in the function value , J4SAVE . SEE ALSO  XERMSG REFERENCES  R. E. Jones and D. K. Kahaner, XERROR, the SLATEC\n                 Error-handling Package, SAND82-0800, Sandia\n                 Laboratories, 1982. ROUTINES CALLED  (NONE) REVISION HISTORY  (YYMMDD)\n   790801  DATE WRITTEN\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900205  Minor modifications to prologue.  (WRB)\n   900402  Added TYPE section.  (WRB)\n   910411  Added KEYWORDS section.  (WRB)\n   920501  Reformatted the REFERENCES section.  (WRB) END PROLOGUE  J4SAVE FIRST EXECUTABLE STATEMENT  J4SAVE Arguments Type Intent Optional Attributes Name integer :: IWHICH integer :: IVALUE logical :: ISET Return Value integer","tags":"","url":"proc/j4save.html"},{"title":"io_RT_components – Yambo","text":"function io_RT_components(what, ID) Uses RT_control R_lattice stderr pars IO_m timing_m drivers real_time IO_int Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: what integer, optional :: ID Return Value integer","tags":"","url":"proc/io_rt_components.html"},{"title":"Build_Overlaps_Det_EQ – Yambo","text":"subroutine Build_Overlaps_Det_EQ(Xen, i_sp_pol, ikbz, Sm1_plus, Sm1_minus, S_det) Uses R_lattice matrix_operate pars DIPOLES vec_operate electrons Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: Xen integer, intent(in) :: i_sp_pol integer, intent(in) :: ikbz complex(kind=SP), intent(out) :: Sm1_plus (Xen%nbf(i_sp_pol),Xen%nbm(i_sp_pol),6) complex(kind=SP), intent(out) :: Sm1_minus (Xen%nbf(i_sp_pol),Xen%nbm(i_sp_pol),6) complex(kind=SP), intent(out) :: S_det (6)","tags":"","url":"proc/build_overlaps_det_eq.html"},{"title":"AVINT – Yambo","text":"subroutine AVINT(X, Y, N, XLO, XUP, ANS, IERR) BEGIN PROLOGUE  AVINT PURPOSE  Integrate a function tabulated at arbitrarily spaced\n            abscissas using overlapping parabolas. LIBRARY   SLATEC CATEGORY  H2A1B2 TYPE      SINGLE PRECISION (AVINT-S, DAVINT-D) KEYWORDS  INTEGRATION, QUADRATURE, TABULATED DATA AUTHOR  Jones, R. E., (SNLA) DESCRIPTION Abstract AVINT integrates a function tabulated at arbitrarily spaced abscissas . The limits of integration need not coincide with the tabulated abscissas . A method of overlapping parabolas fitted to the data is used provided that there are at least 3 abscissas between the limits of integration . AVINT also handles two special cases . If the limits of integration are equal , AVINT returns a result of zero regardless of the number of tabulated values . If there are only two function values , AVINT uses the trapezoid rule . Description of Parameters The user must dimension all arrays appearing in the call list X ( N ), Y ( N ). Input -- X - real array of abscissas , which must be in increasing order . Y - real array of functional values . i . e ., Y ( I ) = FUNC ( X ( I )). N - the integer number of function values supplied . N . GE . 2 unless XLO = XUP . XLO - real lower limit of integration . XUP - real upper limit of integration . Must have XLO . LE . XUP . Output -- ANS - computed approximate value of integral IERR - a status code -- normal code = 1 means the requested integration was performed . -- abnormal codes = 2 means XUP was less than XLO . = 3 means the number of X ( I ) between XLO and XUP ( inclusive ) was less than 3 and neither of the two special cases described in the Abstract occurred . No integration was performed . = 4 means the restriction X ( I + 1 ) . GT . X ( I ) was violated . = 5 means the number N of function values was . LT . 2. ANS is set to zero if IERR = 2 , 3 , 4 , or 5. AVINT is documented completely in SC - M - 69 - 335 Original program from \"Numerical Integration\" by Davis & Rabinowitz . Adaptation and modifications for Sandia Mathematical Program Library by Rondall E . Jones . REFERENCES  R. E. Jones, Approximate integrator of functions\n                 tabulated at arbitrarily spaced abscissas,\n                 Report SC-M-69-335, Sandia Laboratories, 1969. ROUTINES CALLED  XERMSG REVISION HISTORY  (YYMMDD)\n   690901  DATE WRITTEN\n   890831  Modified array declarations.  (WRB)\n   890831  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ)\n   900326  Removed duplicate information from DESCRIPTION section.\n           (WRB)\n   920501  Reformatted the REFERENCES section.  (WRB) END PROLOGUE  AVINT **FIRST EXECUTABLE STATEMENT  AVINT Arguments Type Intent Optional Attributes Name real :: X real :: Y integer :: N real :: XLO real :: XUP real :: ANS integer :: IERR","tags":"","url":"proc/avint.html"},{"title":"OEP_Weighted_Density – Yambo","text":"subroutine OEP_Weighted_Density(en, Xk, rho) Uses R_lattice wave_func D_lattice pars FFT_m electrons Arguments Type Intent Optional Attributes Name type( levels ) :: en type( bz_samp ) :: Xk real(kind=SP) :: rho (fft_size)","tags":"","url":"proc/oep_weighted_density.html"},{"title":"OF_exists – Yambo","text":"function OF_exists(name) Uses pars com Arguments Type Intent Optional Attributes Name character(len=*) :: name Return Value logical","tags":"","url":"proc/of_exists.html"},{"title":"file_exists – Yambo","text":"function file_exists(name) Arguments Type Intent Optional Attributes Name character(len=*) :: name Return Value logical","tags":"","url":"proc/file_exists.html"},{"title":"composed_fmt – Yambo","text":"function composed_fmt(basic_fmt, n, USE_TABS, INDENT) Uses pars com stderr Arguments Type Intent Optional Attributes Name character(len=*) :: basic_fmt integer :: n logical :: USE_TABS integer :: INDENT Return Value character(len=lchlen)","tags":"","url":"proc/composed_fmt.html"},{"title":"filename – Yambo","text":"function filename(name) Uses pars stderr Arguments Type Intent Optional Attributes Name character(len=*) :: name Return Value character(len=lchlen)","tags":"","url":"proc/filename.html"},{"title":"get_file_index – Yambo","text":"function get_file_index(of_name_complete) Uses pars com Arguments Type Intent Optional Attributes Name character(len=lchlen), intent(in) :: of_name_complete Return Value integer","tags":"","url":"proc/get_file_index.html"},{"title":"el_density_matrix – Yambo","text":"subroutine el_density_matrix(G_lesser, en, Xk, rho, lowest_band) Uses parallel_m R_lattice parallel_int wave_func D_lattice matrix_operate pars timing_m hamiltonian FFT_m electrons real_time interfaces Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: G_lesser (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2),PAR_G_k_range(1):PAR_G_k_range(2),n_sp_pol) type( levels ), intent(in) :: en type( bz_samp ), intent(in) :: Xk real(kind=SP), intent(out) :: rho (fft_size) integer, intent(in) :: lowest_band","tags":"","url":"proc/el_density_matrix.html"},{"title":"DIPOLE_driver – Yambo","text":"subroutine DIPOLE_driver(Xen, Xk, Xq, Dip) Uses parallel_m R_lattice ALLOC stderr pars DIPOLES IO_m timing_m drivers parallel_int electrons IO_int Arguments Type Intent Optional Attributes Name type( levels ), intent(inout) :: Xen type( bz_samp ), intent(inout) :: Xk type( bz_samp ), intent(inout) :: Xq type( DIPOLE_t ), intent(inout) :: Dip","tags":"","url":"proc/dipole_driver.html"},{"title":"SGEMV_omp – Yambo","text":"subroutine SGEMV_omp(TRANS, M, N, ALPHA, A, LDA, X, INCX, BETA, Y, INCY) Arguments Type Intent Optional Attributes Name character(len=1) :: TRANS integer :: M integer :: N real :: ALPHA real :: A (LDA,*) integer :: LDA real :: X (*) integer :: INCX real :: BETA real :: Y (*) integer :: INCY","tags":"","url":"proc/sgemv_omp.html"},{"title":"PARALLEL_assign_LA_COMMs – Yambo","text":"subroutine PARALLEL_assign_LA_COMMs(ENVIRONMENT, idriver, Ncpu_in) Uses parallel_m com stderr Arguments Type Intent Optional Attributes Name character(len=*) :: ENVIRONMENT integer :: idriver integer :: Ncpu_in","tags":"","url":"proc/parallel_assign_la_comms.html"},{"title":"def_variable_elemental – Yambo","text":"subroutine def_variable_elemental(ID, VAR, VAR_SZ, VAR_KIND, MENU, dim_names, par_io_kind) Uses parallel_m stderr pars com netcdf IO_m drivers Arguments Type Intent Optional Attributes Name integer, intent(in) :: ID character(len=*), intent(in) :: VAR integer, intent(in) :: VAR_SZ integer, intent(in) :: VAR_KIND integer, intent(in) :: MENU character(len=schlen), intent(in), optional :: dim_names (:) character(len=*), intent(in), optional :: par_io_kind","tags":"","url":"proc/def_variable_elemental.html"},{"title":"COLLISIONS_basic_operations – Yambo","text":"subroutine COLLISIONS_basic_operations(what, COLL) Uses R_lattice wave_func collision_ext IO_m electrons Arguments Type Intent Optional Attributes Name character(len=*) :: what type( COLLISIONS_group ) :: COLL","tags":"","url":"proc/collisions_basic_operations.html"},{"title":"io_descriptors – Yambo","text":"function io_descriptors(desc, name, ID, QUIET) Uses stderr pars netcdf IO_m descriptors IO_int Arguments Type Intent Optional Attributes Name type( IO_desc ), intent(inout) :: desc character(len=*), intent(in) :: name integer, intent(in) :: ID logical, intent(in) :: QUIET Return Value integer","tags":"","url":"proc/io_descriptors.html"},{"title":"QP_of – Yambo","text":"subroutine QP_of(qp, en, QPdb_read_err, what) Uses OUTPUT stderr pars com QP_m drivers electrons interfaces Arguments Type Intent Optional Attributes Name type( QP_t ) :: qp type( levels ) :: en integer :: QPdb_read_err character(len=*) :: what","tags":"","url":"proc/qp_of.html"},{"title":"INITS – Yambo","text":"function INITS(OS, NOS, ETA) BEGIN PROLOGUE  INITS PURPOSE  Determine the number of terms needed in an orthogonal\n            polynomial series so that it meets a specified accuracy. LIBRARY   SLATEC (FNLIB) CATEGORY  C3A2 TYPE      SINGLE PRECISION (INITS-S, INITDS-D) KEYWORDS  CHEBYSHEV, FNLIB, INITIALIZE, ORTHOGONAL POLYNOMIAL,\n             ORTHOGONAL SERIES, SPECIAL FUNCTIONS AUTHOR  Fullerton, W., (LANL) DESCRIPTION Initialize the orthogonal series, represented by the array OS, so\n  that INITS is the number of terms needed to insure the error is no\n  larger than ETA.  Ordinarily, ETA will be chosen to be one-tenth\n  machine precision. Input Arguments -- OS     single precision array of NOS coefficients in an orthogonal\n          series.\n   NOS    number of coefficients in OS.\n   ETA    single precision scalar containing requested accuracy of\n          series. REFERENCES  (NONE) ROUTINES CALLED  XERMSG REVISION HISTORY  (YYMMDD)\n   770401  DATE WRITTEN\n   890831  Modified array declarations.  (WRB)\n   891115  Modified error message.  (WRB)\n   891115  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ) END PROLOGUE  INITS Arguments Type Intent Optional Attributes Name real :: OS (*) **FIRST EXECUTABLE STATEMENT  INITS integer :: NOS real :: ETA Return Value integer","tags":"","url":"proc/inits.html"},{"title":"FREQUENCIES_mpa_sampling – Yambo","text":"subroutine FREQUENCIES_mpa_sampling(np, w1, w2, d, ps, gs, w) Uses pars Arguments Type Intent Optional Attributes Name integer, intent(in) :: np complex(kind=SP), intent(in) :: w1 complex(kind=SP), intent(in) :: w2 real(kind=SP), intent(in) :: d (2) character(len=2), intent(in) :: ps character(len=2), intent(in) :: gs complex(kind=SP), intent(out) :: w (2*np)","tags":"","url":"proc/frequencies_mpa_sampling.html"},{"title":"QAG – Yambo","text":"subroutine QAG(F, A, B, EPSABS, EPSREL, KEY, RESULT, ABSERR, NEVAL, IER, LIMIT, LENW, LAST, IWORK, WORK) BEGIN PROLOGUE  QAG PURPOSE  The routine calculates an approximation result to a given\n            definite integral I = integral of F over (A,B),\n            hopefully satisfying following claim for accuracy\n            ABS(I-RESULT)LE.MAX(EPSABS,EPSREL ABS(I)). LIBRARY   SLATEC (QUADPACK) CATEGORY  H2A1A1 TYPE      SINGLE PRECISION (QAG-S, DQAG-D) KEYWORDS  AUTOMATIC INTEGRATOR, GAUSS-KRONROD RULES,\n             GENERAL-PURPOSE, GLOBALLY ADAPTIVE, INTEGRAND EXAMINATOR,\n             QUADPACK, QUADRATURE AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven *DESCRIPTION Computation of a definite integral Standard fortran subroutine Real version F - Real Function subprogram defining the integrand Function F ( X ). The actual name for F needs to be Declared E X T E R N A L in the driver program . A - Real Lower limit of integration B - Real Upper limit of integration EPSABS - Real Absolute accuracy requested EPSREL - Real Relative accuracy requested If EPSABS . LE .0 And EPSREL . LT . MAX ( 50 * REL . MACH . ACC ., 0.5 D - 28 ), The routine will end with IER = 6 . KEY - Integer Key for choice of local integration rule A GAUSS - KRONROD PAIR is used with 7 - 15 POINTS If KEY . LT .2 , 10 - 21 POINTS If KEY = 2 , 15 - 31 POINTS If KEY = 3 , 20 - 41 POINTS If KEY = 4 , 25 - 51 POINTS If KEY = 5 , 30 - 61 POINTS If KEY . GT .5 . ON RETURN RESULT - Real Approximation to the integral ABSERR - Real Estimate of the modulus of the absolute error , Which should EQUAL or EXCEED ABS ( I - RESULT ) NEVAL - Integer Number of integrand evaluations IER - Integer IER = 0 Normal and reliable termination of the routine . It is assumed that the requested accuracy has been achieved . IER . GT .0 Abnormal termination of the routine The estimates for RESULT and ERROR are Less reliable . It is assumed that the requested accuracy has not been achieved . ERROR MESSAGES IER = 1 Maximum number of subdivisions allowed has been achieved . One can allow more subdivisions by increasing the value of LIMIT ( and taking the according dimension adjustments into account ). HOWEVER , If this yield no improvement it is advised to analyze the integrand in order to determine the integration difficulties . If the position of a local difficulty can be determined ( I . E . SINGULARITY , DISCONTINUITY WITHIN THE INTERVAL ) One will probably gain from splitting up the interval at this point and calling the INTEGRATOR on the SUBRANGES . If possible , AN APPROPRIATE SPECIAL - PURPOSE INTEGRATOR should be used which is designed for handling the type of difficulty involved . = 2 The occurrence of roundoff error is detected , which prevents the requested tolerance from being achieved . = 3 Extremely bad integrand behaviour occurs at some points of the integration interval . = 6 The input is invalid , because ( EPSABS . LE .0 AND EPSREL . LT . MAX ( 50 * REL . MACH . ACC ., 0.5 D - 28 )) OR LIMIT . LT .1 OR LENW . LT . LIMIT * 4 . RESULT , ABSERR , NEVAL , LAST are set to zero . EXCEPT when LENW is invalid , IWORK ( 1 ), WORK ( LIMIT * 2 + 1 ) and WORK ( LIMIT * 3 + 1 ) are set to zero , WORK ( 1 ) is set to A and WORK ( LIMIT + 1 ) to B . DIMENSIONING PARAMETERS LIMIT - Integer Dimensioning parameter for IWORK Limit determines the maximum number of subintervals in the partition of the given integration interval ( A , B ), LIMIT . GE .1 . If LIMIT . LT .1 , the routine will end with IER = 6 . LENW - Integer Dimensioning parameter for work LENW must be at least LIMIT * 4 . IF LENW . LT . LIMIT * 4 , the routine will end with IER = 6 . LAST - Integer On return , LAST equals the number of subintervals produced in the subdivision process , which determines the number of significant elements actually in the WORK ARRAYS . WORK ARRAYS IWORK - Integer Vector of dimension at least limit , the first K elements of which contain pointers to the error estimates over the subintervals , such that WORK ( LIMIT * 3 + IWORK ( 1 )), ... , WORK ( LIMIT * 3 + IWORK ( K )) form a decreasing sequence with K = LAST If LAST . LE .( LIMIT / 2 + 2 ), and K = LIMIT + 1 - LAST otherwise WORK - Real Vector of dimension at least LENW on return WORK ( 1 ), ... , WORK ( LAST ) contain the left end points of the subintervals in the partition of ( A , B ), WORK ( LIMIT + 1 ), ... , WORK ( LIMIT + LAST ) contain the right end points , WORK ( LIMIT * 2 + 1 ), ... , WORK ( LIMIT * 2 + LAST ) contain the integral approximations over the subintervals , WORK ( LIMIT * 3 + 1 ), ... , WORK ( LIMIT * 3 + LAST ) contain the error estimates . REFERENCES  (NONE) ROUTINES CALLED  QAGE, XERMSG REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890831  Modified array declarations.  (WRB)\n   890831  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ) END PROLOGUE  QAG\n**FIRST EXECUTABLE STATEMENT  QAG Arguments Type Intent Optional Attributes Name real :: F real :: A real :: B real :: EPSABS real :: EPSREL integer :: KEY real :: RESULT real :: ABSERR integer :: NEVAL integer :: IER integer :: LIMIT integer :: LENW integer :: LAST integer, dimension(*) :: IWORK real, dimension(*) :: WORK","tags":"","url":"proc/qag.html"},{"title":"RT_apply – Yambo","text":"subroutine RT_apply(bands, E, K, what, VERBOSE, IO_COM, Time, keep_RT_carriers, TIMES_ONLY, skip_interpolation) Uses RT_control R_lattice stderr pars com parser_m IO_m UNITS global_XC drivers electrons real_time IO_int Arguments Type Intent Optional Attributes Name integer, intent(in) :: bands (2) type( levels ), intent(inout) :: E type( bz_samp ), intent(in) :: K character(len=*), intent(in), optional :: what logical, intent(in), optional :: VERBOSE integer, intent(in), optional :: IO_COM real(kind=SP), intent(in), optional :: Time logical, intent(in), optional :: keep_RT_carriers logical, intent(in), optional :: TIMES_ONLY logical, intent(in), optional :: skip_interpolation","tags":"","url":"proc/rt_apply.html"},{"title":"K_blocks – Yambo","text":"subroutine K_blocks() Uses parallel_m pars com BS parallel_int Arguments None","tags":"","url":"proc/k_blocks.html"},{"title":"K_block_alloc – Yambo","text":"subroutine K_block_alloc(iB, mode) Uses BS pars BS_solvers Arguments Type Intent Optional Attributes Name integer, intent(in) :: iB character(len=*), intent(in) :: mode","tags":"","url":"proc/k_block_alloc.html"},{"title":"K_block_free – Yambo","text":"subroutine K_block_free(iB, mode) Uses BS BS_solvers Arguments Type Intent Optional Attributes Name integer, intent(in) :: iB character(len=*), intent(in) :: mode","tags":"","url":"proc/k_block_free.html"},{"title":"K_block_symmetrize – Yambo","text":"subroutine K_block_symmetrize(i_B) Uses BS Arguments Type Intent Optional Attributes Name integer, intent(in) :: i_B","tags":"","url":"proc/k_block_symmetrize.html"},{"title":"BS_blks_free – Yambo","text":"subroutine BS_blks_free(i_BS_mat) Uses BS Arguments Type Intent Optional Attributes Name integer, intent(in) :: i_BS_mat","tags":"","url":"proc/bs_blks_free.html"},{"title":"BS_blks_symmetrize_K – Yambo","text":"subroutine BS_blks_symmetrize_K() Uses BS Arguments None","tags":"","url":"proc/bs_blks_symmetrize_k.html"},{"title":"PARALLEL_set_the_active_structures – Yambo","text":"subroutine PARALLEL_set_the_active_structures(n_structures) Uses parallel_m Arguments Type Intent Optional Attributes Name integer :: n_structures","tags":"","url":"proc/parallel_set_the_active_structures.html"},{"title":"QP_apply_dump_user_CTLs – Yambo","text":"subroutine QP_apply_dump_user_CTLs(E, object) Uses R_lattice stderr pars parser_m QP_CTL_m electrons Arguments Type Intent Optional Attributes Name type( levels ) :: E character(len=1) :: object","tags":"","url":"proc/qp_apply_dump_user_ctls.html"},{"title":"SET_logicals – Yambo","text":"subroutine SET_logicals() Uses parallel_m stderr pars com IO_m drivers LIVE_t Arguments None","tags":"","url":"proc/set_logicals.html"},{"title":"RT_X_response – Yambo","text":"subroutine RT_X_response(en, k, q) Uses RT_control R_lattice YPP_interfaces stderr pars parser_m YPP_real_time fields electrons Arguments Type Intent Optional Attributes Name type( levels ) :: en type( bz_samp ) :: k type( bz_samp ) :: q","tags":"","url":"proc/rt_x_response.html"},{"title":"SLK_ORTHO_group – Yambo","text":"subroutine SLK_ORTHO_group(ORTHO, POOL, nproc_try_in, comm_all) Uses parallel_m SLK_m Arguments Type Intent Optional Attributes Name type( ORTHO_group ), intent(inout) :: ORTHO type( POOL_group ), intent(inout) :: POOL integer, intent(in) :: nproc_try_in integer, intent(in) :: comm_all","tags":"","url":"proc/slk_ortho_group.html"},{"title":"DBESK1 – Yambo","text":"function DBESK1(X) BEGIN PROLOGUE  DBESK1 PURPOSE  Compute the modified (hyperbolic) Bessel function of the\n            third kind of order one. LIBRARY   SLATEC (FNLIB) CATEGORY  C10B1 TYPE      DOUBLE PRECISION (BESK1-S, DBESK1-D) KEYWORDS  FNLIB, HYPERBOLIC BESSEL FUNCTION,\n             MODIFIED BESSEL FUNCTION, ORDER ONE, SPECIAL FUNCTIONS,\n             THIRD KIND AUTHOR  Fullerton, W., (LANL) DESCRIPTION DBESK1(X) calculates the double precision modified (hyperbolic)\n Bessel function of the third kind of order one for double precision\n argument X.  The argument must be large enough that the result does\n not overflow and small enough that the result does not underflow. Series for BK1        on the interval  0.          to  4.00000E+00\n                                        with weighted error   9.16E-32\n                                         log weighted error  31.04\n                               significant figures required  30.61\n                                    decimal places required  31.64 REFERENCES  (NONE) ROUTINES CALLED  D1MACH, DBESI1, DBSK1E, DCSEVL, INITDS, XERMSG REVISION HISTORY  (YYMMDD)\n   770701  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ) END PROLOGUE  DBESK1\n**FIRST EXECUTABLE STATEMENT  DBESK1 Arguments Type Intent Optional Attributes Name double precision :: X Return Value doubleprecision","tags":"","url":"proc/dbesk1.html"},{"title":"Eliashberg_Dos_Func – Yambo","text":"function Eliashberg_Dos_Func(iq, im, ph_en, ph_broad, PH_E, q) Uses R_lattice ELPH functions pars electrons Arguments Type Intent Optional Attributes Name integer, intent(in) :: iq integer, intent(in) :: im real(kind=SP), intent(in) :: ph_en real(kind=SP), intent(in) :: ph_broad type( levels ), intent(in) :: PH_E type( bz_samp ), intent(in) :: q Return Value real(kind=sp)","tags":"","url":"proc/eliashberg_dos_func.html"},{"title":"K_Transition_check – Yambo","text":"function K_Transition_check(Ken, Dip, iq, ik, ikp, iv, ic, i_sp_c, i_res_ares, E_eh, E_eh_SOC_corr, f_eh, f_eh_RES, f_eh_PL) Uses pars DIPOLES X_m BS electrons Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: Ken type( DIPOLE_t ), intent(in) :: Dip integer, intent(in) :: iq integer, intent(in) :: ik integer, intent(in) :: ikp integer, intent(in) :: iv integer, intent(in) :: ic integer, intent(in) :: i_sp_c integer, intent(in) :: i_res_ares real(kind=SP), intent(out) :: E_eh real(kind=SP), intent(out) :: E_eh_SOC_corr (2/n_sp_pol) real(kind=SP), intent(out) :: f_eh real(kind=SP), intent(out) :: f_eh_RES real(kind=SP), intent(out) :: f_eh_PL Return Value logical","tags":"","url":"proc/k_transition_check.html"},{"title":"RT_propagate_fields – Yambo","text":"subroutine RT_propagate_fields(E, k, A_old, A_new, G_inp, T, T_step) Uses parallel_m R_lattice pars X_m UNITS fields electrons real_time Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: E type( bz_samp ), intent(in) :: k type( gauge_field ), intent(in) :: A_old type( gauge_field ), intent(out) :: A_new complex(kind=SP), intent(in) :: G_inp (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2),PAR_G_k_range(1):PAR_G_k_range(2)) real(kind=SP), intent(in) :: T real(kind=SP), intent(in) :: T_step","tags":"","url":"proc/rt_propagate_fields.html"},{"title":"OUTPUT_unit_conversion – Yambo","text":"subroutine OUTPUT_unit_conversion(Ivar, Rvar, DESC, KIND, PARSER_call) Uses QP_m pars it_m UNITS Arguments Type Intent Optional Attributes Name integer, optional :: Ivar real(kind=SP), optional :: Rvar character(len=*), optional :: DESC character(len=*), optional :: KIND logical, optional :: PARSER_call","tags":"","url":"proc/output_unit_conversion.html"},{"title":"TDDFT_ALDA_eh_space_G_kernel – Yambo","text":"function TDDFT_ALDA_eh_space_G_kernel(BS_n_g_fxc, BS_T_grp_ip, i_Tp, BS_T_grp_ik, i_Tk) result(H_x) Uses wrapper_omp pars BS FFT_m electrons Arguments Type Intent Optional Attributes Name integer, intent(in) :: BS_n_g_fxc type( BS_T_group ), intent(in), target :: BS_T_grp_ip integer, intent(in) :: i_Tp type( BS_T_group ), intent(in), target :: BS_T_grp_ik integer, intent(in) :: i_Tk Return Value complex(kind=SP)","tags":"","url":"proc/tddft_alda_eh_space_g_kernel.html"},{"title":"WF_rotate – Yambo","text":"subroutine WF_rotate(ik, i_sp_pol, WFo, wf_size) Uses gpu_m devxlib wave_func pars hamiltonian electrons Arguments Type Intent Optional Attributes Name integer :: ik integer :: i_sp_pol type( WAVEs ) :: WFo integer :: wf_size","tags":"","url":"proc/wf_rotate.html"},{"title":"msg_manager – Yambo","text":"subroutine msg_manager(how, OUT_msg, REP_msg, LOG_msg, STD_msg, NEW_lines) Uses pars com stderr Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: how logical, intent(out) :: OUT_msg logical, intent(out) :: REP_msg logical, intent(out) :: LOG_msg logical, intent(out) :: STD_msg logical, intent(out) :: NEW_lines (2)","tags":"","url":"proc/msg_manager.html"},{"title":"electrons_current – Yambo","text":"subroutine electrons_current(Xk, Xen) Uses R_lattice stderr pars com UNITS YPPm FFT_m electrons interfaces Arguments Type Intent Optional Attributes Name type( bz_sa