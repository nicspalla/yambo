utes Name type( bz_samp ) :: Xk","tags":"","url":"proc/elph_excitonic_gkkp.html"},{"title":"OSCLL_eval – Yambo","text":"subroutine OSCLL_eval(q, k, en) Uses parallel_m R_lattice parallel_int collision_el wave_func FFT_m stderr pars com collision_ext QP_m IO_m LIVE_t electrons interfaces IO_int Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: q type( bz_samp ), intent(in) :: k type( levels ), intent(in) :: en","tags":"","url":"proc/oscll_eval.html"},{"title":"OSCLL_compose_nl – Yambo","text":"subroutine OSCLL_compose_nl(dG, H_nl_sc, k, q, E, i_k, i_sp_pol) Uses parallel_m R_lattice wrapper_omp pars nl_optics collision_ext QP_m FFT_m electrons Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: dG (NL_bands(1):NL_bands(2),NL_bands(1):NL_bands(2),QP_nk) complex(kind=SP), intent(inout) :: H_nl_sc (NL_bands(1):NL_bands(2),NL_bands(1):NL_bands(2)) type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: q type( levels ), intent(in) :: E integer, intent(in) :: i_k integer, intent(in) :: i_sp_pol","tags":"","url":"proc/oscll_compose_nl.html"},{"title":"K_Haydock_scatter – Yambo","text":"subroutine K_Haydock_scatter(V, fullV, fullV_size, n_ColsFG) Uses parallel_m pars BS_solvers BS parallel_int Arguments Type Intent Optional Attributes Name type( Haydock_vector ), intent(inout) :: V (BS_nT_grps) complex(kind=SP), intent(in) :: fullV (fullV_size) integer, intent(in) :: fullV_size integer :: n_ColsFG (BS_nT_grps)","tags":"","url":"proc/k_haydock_scatter.html"},{"title":"fix_PPs – Yambo","text":"subroutine fix_PPs(E, k, k_save, kpoints_map, old_nsym, old_dl_sop, old_sop_inv, S_contains_TR) Uses R_lattice wave_func pseudo stderr D_lattice YPP_symm pars com DIPOLES IO_m LIVE_t electrons IO_int Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: E type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: k_save integer, intent(in) :: kpoints_map (2,k%nibz) integer, intent(in) :: old_nsym 