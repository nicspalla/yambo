ling integer, intent(inout) :: KIND KIND integer, intent(inout) :: FUNCTIONAL exchange-correlation functional integer, intent(in) :: ORDER 0 = E_xc, 1 = V_xc, 2 = F_xc real(kind=SP), intent(inout), optional :: EXX_FRACTION exchange fraction (optional) real(kind=SP), intent(inout), optional :: EXX_SCREENING screened exchange fraction (optional)","tags":"","url":"proc/xc_potential_driver.html"},{"title":"EPS_2_moke – Yambo","text":"subroutine EPS_2_moke(wv, nw, eps_ii, eps_ij, moke) Uses pars UNITS Arguments Type Intent Optional Attributes Name complex(kind=SP) :: wv (nw) integer :: nw complex(kind=SP) :: eps_ii (nw) complex(kind=SP) :: eps_ij (nw) complex(kind=SP) :: moke (nw)","tags":"","url":"proc/eps_2_moke.html"},{"title":"saxpy_cpu – Yambo","text":"subroutine saxpy_cpu(N, a, x, y) Uses iso_c_binding pars Arguments Type Intent Optional Attributes Name integer :: N real(kind=SP) :: a real(kind=SP) :: x (N) real(kind=SP) :: y (N)","tags":"","url":"proc/saxpy_cpu.html"},{"title":"saxpy_explicit – Yambo","text":"subroutine saxpy_explicit(N, a, x, y) Uses iso_c_binding pars Arguments Type Intent Optional Attributes Name integer :: N real(kind=SP) :: a real(kind=SP) :: x (N) real(kind=SP) :: y (N)","tags":"","url":"proc/saxpy_explicit.html"},{"title":"struc_fact – Yambo","text":"subroutine struc_fact(nat, tau, ntyp, ityp, ngm, g, bg, nr1, nr2, nr3, do_strf, strf, do_eigts, eigts1, eigts2, eigts3) Uses constants kinds Arguments Type Intent Optional Attributes Name integer :: nat real(kind=DP) :: tau (3,nat) integer :: ntyp integer :: ityp (nat) integer :: ngm real(kind=DP) :: g (3,ngm) real(kind=DP) :: bg (3,3) integer :: nr1 integer :: nr2 integer :: nr3 logical :: do_strf complex(kind=DP) :: strf (ngm,ntyp) logical :: do_eigts complex(kind=DP) :: eigts1 (-nr1:nr1,nat) complex(kind=DP) :: eigts2 (-nr2:nr2,nat) complex(kind=DP) :: eigts3 (-nr3:nr3,nat)","tags":"","url":"proc/struc_fact.html"},{"title":"c2y_file_name – Yambo","text":"function c2y_file_name(inf, file_name_) Uses pars Arguments Type Intent Optional Attributes Name character(len=*) :: inf character(len=lchlen) :: file_name_ Return Value integer","tags":"","url":"proc/c2y_file_name.html"},{"title":"PP_compute_becp – Yambo","text":"subroutine PP_compute_becp(becp, npwk, wf_nb, wf_c, wf_b_indx) Uses wave_func pseudo pars timing_m qe_pseudo_m electrons Arguments Type Intent Optional Attributes Name type( bec_type ), intent(inout) :: becp integer, intent(in) :: npwk integer, intent(in) :: wf_nb complex(kind=SP), intent(in) :: wf_c (wf_ncx,n_spinor,wf_nb) integer, intent(in) :: wf_b_indx (wf_nb)","tags":"","url":"proc/pp_compute_becp.html"},{"title":"NL_Berry_current – Yambo","text":"subroutine NL_Berry_current(en, Xk, k_map, V_bands, NL_J) Uses parallel_m R_lattice D_lattice pars nl_optics QP_m vec_operate parallel_int electrons electric @brief Calculate current using the Souza-Iniguez-Vanderbilt formulation @param[in]       V_bands            time-dependent valence bands\n@param[in]       k_map          k-points map in the BZ\n@param[in]       Xk             k-points indexes\n@param[in]       en             energies array @param[out]      NL_J           current vector Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: en type( bz_samp ), intent(in) :: Xk type( bz_map ), intent(in) :: k_map complex(kind=SP), intent(in) :: V_bands (NL_bands(2),maxval(en%nbf),QP_nk,n_sp_pol) complex(kind=SP), intent(out) :: NL_J (3)","tags":"","url":"proc/nl_berry_current.html"},{"title":"DPCOEF – Yambo","text":"subroutine DPCOEF(L, C, TC, A) BEGIN PROLOGUE  DPCOEF PURPOSE  Convert the DPOLFT coefficients to Taylor series form. LIBRARY   SLATEC CATEGORY  K1A1A2 TYPE      DOUBLE PRECISION (PCOEF-S, DPCOEF-D) KEYWORDS  CURVE FITTING, DATA FITTING, LEAST SQUARES, POLYNOMIAL FIT AUTHOR  Shampine, L. F., (SNLA)\n           Davenport, S. M., (SNLA) DESCRIPTION Abstract DPOLFT computes the least squares polynomial fit of degree L as a sum of orthogonal polynomials . DPCOEF changes this fit to its Taylor expansion about any point C , i . e . writes the polynomial as a sum of powers of ( X - C ) . Taking C = 0. gives the polynomial in powers of X , but a suitable non - zero C often leads to polynomials which are better scaled and more accurately evaluated . The parameters for DPCOEF are INPUT -- All TYPE REAL variables are DOUBLE PRECISION L - Indicates the degree of polynomial to be changed to its Taylor expansion . To obtain the Taylor coefficients in reverse order , input L as the negative of the degree desired . The absolute value of L must be less than or equal to NDEG , the highest degree polynomial fitted by DPOLFT . C - The point about which the Taylor expansion is to be made . A - Work and output array containing values from last call to DPOLFT . OUTPUT -- All TYPE REAL variables are DOUBLE PRECISION TC - Vector containing the first LL + 1 Taylor coefficients where LL = ABS ( L ) . If L . GT . 0 , the coefficients are in the usual Taylor series order , i . e . P ( X ) = TC ( 1 ) + TC ( 2 ) * ( X - C ) + ... + TC ( N + 1 ) * ( X - C ) ** N If L . LT . 0 , the coefficients are in reverse order , i . e . P ( X ) = TC ( 1 ) * ( X - C ) ** N + ... + TC ( N ) * ( X - C ) + TC ( N + 1 ) REFERENCES  L. F. Shampine, S. M. Davenport and R. E. Huddleston,\n                 Curve fitting by polynomials in one variable, Report\n                 SLA-74-0270, Sandia Laboratories, June 1974. ROUTINES CALLED  DP1VLU REVISION HISTORY  (YYMMDD)\n   740601  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   891006  Cosmetic changes to prologue.  (WRB)\n   891006  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   920501  Reformatted the REFERENCES section.  (WRB) END PROLOGUE  DPCOEF Arguments Type Intent Optional Attributes Name integer :: L double precision :: C **FIRST EXECUTABLE STATEMENT  DPCOEF double precision :: TC (*) **FIRST EXECUTABLE STATEMENT  DPCOEF double precision :: A (*) **FIRST EXECUTABLE STATEMENT  DPCOEF","tags":"","url":"proc/dpcoef.html"},{"title":"TDDFT_ALDA_eh_space_R_kernel – Yambo","text":"function TDDFT_ALDA_eh_space_R_kernel(is, os, isp, osp, tddft_wf, mode) result(H_x) Uses wrapper_omp pars timing_m TDDFT BS FFT_m electrons xc_functionals interfaces Arguments Type Intent Optional Attributes Name integer, intent(in) :: is (4) integer, intent(in) :: os (4) integer, intent(in) :: isp (4) integer, intent(in) :: osp (4) type( tddft_wf_t ), intent(inout), target :: tddft_wf character(len=3), intent(in) :: mode Return Value complex(kind=SP)","tags":"","url":"proc/tddft_alda_eh_space_r_kernel.html"},{"title":"RT_Polarization – Yambo","text":"subroutine RT_Polarization(en, k, q) Uses RT_control parallel_m R_lattice parallel_int D_lattice stderr pars functions DIPOLES IO_m YPP_real_time UNITS YPPm LIVE_t electrons real_time IO_int Arguments Type Intent Optional Attributes Name type( levels ) :: en type( bz_samp ) :: k type( bz_samp ) :: q","tags":"","url":"proc/rt_polarization.html"},{"title":"DBSI1E – Yambo","text":"function DBSI1E(X) BEGIN PROLOGUE  DBSI1E PURPOSE  Compute the exponentially scaled modified (hyperbolic)\n            Bessel function of the first kind of order one. LIBRARY   SLATEC (FNLIB) CATEGORY  C10B1 TYPE      DOUBLE PRECISION (BESI1E-S, DBSI1E-D) KEYWORDS  EXPONENTIALLY SCALED, FIRST KIND, FNLIB,\n             HYPERBOLIC BESSEL FUNCTION, MODIFIED BESSEL FUNCTION,\n             ORDER ONE, SPECIAL FUNCTIONS AUTHOR  Fullerton, W., (LANL) DESCRIPTION DBSI1E(X) calculates the double precision exponentially scaled\n modified (hyperbolic) Bessel function of the first kind of order\n one for double precision argument X.  The result is I1(X)\n multiplied by EXP(-ABS(X)). Series for BI1        on the interval  0.          to  9.00000E+00\n                                        with weighted error   1.44E-32\n                                         log weighted error  31.84\n                               significant figures required  31.45\n                                    decimal places required  32.46 Series for AI1        on the interval  1.25000E-01 to  3.33333E-01\n                                        with weighted error   2.81E-32\n                                         log weighted error  31.55\n                               significant figures required  29.93\n                                    decimal places required  32.38 Series for AI12       on the interval  0.          to  1.25000E-01\n                                        with weighted error   1.83E-32\n                                         log weighted error  31.74\n                               significant figures required  29.97\n                                    decimal places required  32.66 REFERENCES  (NONE) ROUTINES CALLED  D1MACH, DCSEVL, INITDS, XERMSG REVISION HISTORY  (YYMMDD)\n   770701  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ) END PROLOGUE  DBSI1E\n**FIRST EXECUTABLE STATEMENT  DBSI1E Arguments Type Intent Optional Attributes Name double precision :: X Return Value doubleprecision","tags":"","url":"proc/dbsi1e.html"},{"title":"PARALLEL_distribute_BZk_using_IBZk – Yambo","text":"subroutine PARALLEL_distribute_BZk_using_IBZk(COMM, K, IND_ibz, IBZ_id, IND_out, BZ_id, BZ_index, PAR_n_bz) Uses parallel_m R_lattice Arguments Type Intent Optional Attributes Name type( yMPI_comm ) :: COMM type( bz_samp ) :: K type( PP_indexes ) :: IND_ibz integer :: IBZ_id type( PP_indexes ) :: IND_out integer :: BZ_id integer :: BZ_index (K%nbz) integer :: PAR_n_bz","tags":"","url":"proc/parallel_distribute_bzk_using_ibzk.html"},{"title":"io_ATMPROJ_pwscf – Yambo","text":"function io_ATMPROJ_pwscf(ID) Uses R_lattice stderr pars IO_m timing_m atom_proj electrons IO_int Arguments Type Intent O