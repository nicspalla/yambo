character(len=1) :: TRANS integer :: M integer :: N double precision :: ALPHA double precision :: A (LDA,*) integer :: LDA double precision :: X (*) integer :: INCX double precision :: BETA double precision :: Y (*) integer :: INCY","tags":"","url":"proc/dgemv_omp.html"},{"title":"K_correlation_collisions_std – Yambo","text":"subroutine K_correlation_collisions_std(iq, i_block, qindx_ID_frag, Xk, q) Uses R_lattice collision_el D_lattice pars timing_m BS openmp electrons Arguments Type Intent Optional Attributes Name integer, intent(in) :: iq integer, intent(in) :: i_block integer, intent(in) :: qindx_ID_frag type( bz_samp ), intent(in) :: Xk type( bz_samp ), intent(in) :: q","tags":"","url":"proc/k_correlation_collisions_std.html"},{"title":"TDDFT_ALDA_G_space – Yambo","text":"subroutine TDDFT_ALDA_G_space(E, k) Uses R_lattice wave_func pars com global_XC TDDFT FFT_m electrons xc_functionals interfaces Arguments Type Intent Optional Attributes Name type( levels ) :: E type( bz_samp ) :: k","tags":"","url":"proc/tddft_alda_g_space.html"},{"title":"INVINT_step – Yambo","text":"subroutine INVINT_step(V_out, V_in, H_in, I_in, nbf, dT) Uses pars nl_optics openmp wrapper Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(out) :: V_out (NL_bands(2),nbf) complex(kind=SP), intent(in) :: V_in (NL_bands(2),nbf) complex(kind=SP), intent(in) :: H_in (NL_bands(1):NL_bands(2),NL_bands(1):NL_bands(2)) complex(kind=SP), intent(in) :: I_in (NL_bands(1):NL_bands(2),NL_bands(1):NL_bands(2),nbf) integer, intent(in) :: nbf real(kind=SP), intent(in) :: dT","tags":"","url":"proc/invint_step.html"},{"title":"DQWGTF – Yambo","text":"function DQWGTF(X, OMEGA, P2, P3, P4, INTEGR) BEGIN PROLOGUE  DQWGTF SUBSIDIARY PURPOSE  This function subprogram is used together with the\n            routine DQAWF and defines the WEIGHT function. LIBRARY   SLATEC TYPE      DOUBLE PRECISION (QWGTF-S, DQWGTF-D) KEYWORDS  COS OR SIN IN WEIGHT FUNCTION AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven SEE ALSO  DQK15W ROUTINES CALLED  (NONE) REVISION HISTORY  (YYMMDD)\n   810101  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900328  Added TYPE section.  (WRB)\n**END PROLOGUE  DQWGTF Arguments Type Intent Optional Attributes Name double precision :: X double precision :: OMEGA double precision :: P2 double precision :: P3 double precision :: P4 integer :: INTEGR **FIRST EXECUTABLE STATEMENT  DQWGTF Return Value doubleprecision","tags":"","url":"proc/dqwgtf.html"},{"title":"EXC_macroscopic_JGM – Yambo","text":"subroutine EXC_macroscopic_JGM(en, Pmac, rho, Exc, V_xc) Uses R_lattice wave_func D_lattice pars nl_optics FFT_m electrons Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: en complex(kind=SP), intent(in) :: Pmac (3) real(kind=SP), intent(in) :: rho (fft_size) complex(kind=SP), intent(out) :: Exc (3) real(kind=SP), intent(out) :: V_xc (fft_size,n_spin)","tags":"","url":"proc/exc_macroscopic_jgm.html"},{"title":"INTERPOLATION_BZ_setup – Yambo","text":"subroutine INTERPOLATION_BZ_setup(Xk) Uses R_lattice interpolate D_lattice matrix_operate pars interpolate_tools com vec_operate Arguments Type Intent Optional Attributes Name type( bz_samp ) :: Xk","tags":"","url":"proc/interpolation_bz_setup.html"},{"title":"DQK21 – Yambo","text":"subroutine DQK21(F, A, B, RESULT, ABSERR, RESABS, RESASC) BEGIN PROLOGUE  DQK21 PURPOSE  To compute I = Integral of F over (A,B), with error\n                           estimate\n                       J = Integral of ABS(F) over (A,B) LIBRARY   SLATEC (QUADPACK) CATEGORY  H2A1A2 TYPE      DOUBLE PRECISION (QK21-S, DQK21-D) KEYWORDS  21-POINT GAUSS-KRONROD RULES, QUADPACK, QUADRATURE AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Integration rules Standard fortran subroutine Double precision version PARAMETERS ON ENTRY F - Double precision Function subprogram defining the integrand FUNCTION F ( X ) . The actual name for F needs to be Declared E X T E R N A L in the driver program . A - Double precision Lower limit of integration B - Double precision Upper limit of integration ON RETURN RESULT - Double precision Approximation to the integral I RESULT is computed by applying the 21 - POINT KRONROD RULE ( RESK ) obtained by optimal addition of abscissae to the 10 - POINT GAUSS RULE ( RESG ) . ABSERR - Double precision Estimate of the modulus of the absolute error , which should not exceed ABS ( I - RESULT ) RESABS - Double precision Approximation to the integral J RESASC - Double precision Approximation to the integral of ABS ( F - I / ( B - A )) over ( A , B ) REFERENCES  (NONE) ROUTINES CALLED  D1MACH REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890531  Changed all specific intrinsics to generic.  (WRB)\n   890531  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB) END PROLOGUE  DQK21 **FIRST EXECUTABLE STATEMENT  DQK21 Arguments Type Intent Optional Attributes Name real :: F double precision :: A double precision :: B double precision :: RESULT double precision :: ABSERR double precision :: RESABS double precision :: RESASC","tags":"","url":"proc/dqk21.html"},{"title":"NL_Hamiltonian – Yambo","text":"subroutine NL_Hamiltonian(E, k, q, X, Time, i_time, V_bands) Uses parallel_m R_lattice nl_optics X_m QP_m real_time wrapper_omp H_interfaces wave_func pars collision_ext global_XC hamiltonian fields UNITS drivers FFT_m electrons xc_functionals Arguments Type Intent Optional Attributes Name type( levels ), intent(in) :: E type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: q type( X_t ), intent(in) :: X real(kind=SP), intent(in) :: Time integer, intent(in) :: i_time complex(kind=SP), intent(in) :: V_bands (NL_bands(2),maxval(E%nbf),QP_nk,n_sp_pol)","tags":"","url":"proc/nl_hamiltonian.html"},{"title":"DIPOLE_rotate – Yambo","text":"subroutine DIPOLE_rotate(ic, iv, ik_bz, i_sp_pol, what, kpt, dipole) Uses parallel_m R_lattice D_lattice matrix_operate pars DIPOLES electrons Arguments Type Intent Optional Attributes Name integer, intent(in) :: ic integer, intent(in) :: iv integer, intent(in) :: ik_bz integer, intent(in) :: i_sp_pol character(len=*), intent(in) :: what type( bz_samp ), intent(in) :: kpt complex(kind=SP), intent(out) :: dipole (3)","tags":"","url":"proc/dipole_rotate.html"},{"title":"Dipole_kb_abinit_comp – Yambo","text":"subroutine Dipole_kb_abinit_comp(npp, npp_tab, ia, is, ik, i_sp_pol, Xk, kbv) Uses R_lattice wave_func pseudo D_lattice pars vec_operate electrons Arguments Type Intent Optional Attributes Name integer, intent(out) :: npp integer, intent(inout) :: npp_tab integer, intent(in) :: ia integer, intent(in) :: is integer, intent(in) :: ik integer, intent(in) :: i_sp_pol type( bz_samp ), intent(in) :: Xk complex(kind=SP), intent(out) :: kbv (wf_ncx,n_spinor,4,pp_kbv_dim_atom)","tags":"","url":"proc/dipole_kb_abinit_comp.html"},{"title":"MATRIX_BSE_to_PAR – Yambo","text":"subroutine MATRIX_BSE_to_PAR(M_bse, M_slk) Uses parallel_m matrix pars BS parallel_int SLK_m Arguments Type Intent Optional Attributes Name type( BS_block ) :: M_bse (n_BS_blks) type( PAR_matrix ) :: M_slk","tags":"","url":"proc/matrix_bse_to_par.html"},{"title":"QAWO – Yambo","text":"subroutine QAWO(F, A, B, OMEGA, INTEGR, EPSABS, EPSREL, RESULT, ABSERR, NEVAL, IER, LENIW, MAXP1, LENW, LAST, IWORK, WORK) BEGIN PROLOGUE  QAWO PURPOSE  Calculate an approximation to a given definite integral\n             I = Integral of F(X) W(X) over (A,B), where\n                   W(X) = COS(OMEGA X)\n                or W(X) = SIN(OMEGA X),\n            hopefully satisfying the following claim for accuracy\n                ABS(I-RESULT).LE.MAX(EPSABS,EPSREL ABS(I)). LIBRARY   SLATEC (QUADPACK) CATEGORY  H2A2A1 TYPE      SINGLE PRECISION (QAWO-S, DQAWO-D) KEYWORDS  AUTOMATIC INTEGRATOR, CLENSHAW-CURTIS METHOD,\n             EXTRAPOLATION, GLOBALLY ADAPTIVE,\n             INTEGRAND WITH OSCILLATORY COS OR SIN FACTOR, QUADPACK,\n             QUADRATURE, SPECIAL-PURPOSE AUTHOR  Piessens, Robert\n             Applied Mathematics and Programming Division\n             K. U. Leuven\n           de Doncker, Elise\n             Applied Mathematics and Programming Division\n             K. U. Leuven DESCRIPTION Computation of oscillatory integrals Standard fortran subroutine Real version PARAMETERS ON ENTRY F - Real Function subprogram defining the function F ( X ). The actual name for F needs to be declared E X T E R N A L in the driver program . A - Real Lower limit of integration B - Real Upper limit of integration OMEGA - Real Parameter in the integrand weight function INTEGR - Integer Indicates which of the weight functions is used INTEGR = 1 W ( X ) = COS ( OMEGA * X ) INTEGR = 2 W ( X ) = SIN ( OMEGA * X ) If INTEGR . NE .1 . AND . INTEGR . NE .2 , the routine will end with IER = 6 . EPSABS - Real Absolute accuracy requested EPSREL - Real Relative accuracy requested If EPSABS . LE .0 and EPSREL . LT . MAX ( 50 * REL . MACH . ACC ., 0.5 D - 28 ), the routine will end with IER = 6 . ON RETURN RESULT - Real Approximation to the integral ABSERR - Real Estimate of the modulus of the absolute error , which should equal or exceed ABS ( I - RESULT ) NEVAL - Integer Number of integrand evaluations IER - Integer IER = 0 Normal and reliable termination of the routine . It is assumed that the requested accuracy has been achieved . - IER . GT .0 Abnormal termination of the routine . The estimates for integral and error are less reliable . It is assumed that the requested accuracy has not been achieved . ERROR MESSAGES IER = 1 Maximum number of subdivisions allowed has been achieved (= LENIW / 2 ). One can allow more subdivisions by increasing the value of LENIW ( and taking the according dimension adjustments into account ). However , if this yields no improvement it is advised to analyze the integrand in order to determine the integration difficulties . If the position of a local difficulty can be determined ( e . g . SINGULARITY , DISCONTINUITY within the interval ) one will probably gain from splitting up the interval at this point and calling the integrator on the subranges . If possible , an appropriate special - purpose integrator should be used which is designed for handling the type of difficulty involved . = 2 The occurrence of roundoff error is detected , which prevents the requested tolerance from being achieved . The error may be under - estimated . = 3 Extremely bad integrand behaviour occurs at some interior points of the integration interval . = 4 The algorithm does not converge . Roundoff error is detected in the extrapolation table . It is presumed that the requested tolerance cannot be achieved due to roundoff in the extrapolation table , and that the returned result is the best which can be obtained . = 5 The integral is probably divergent , or slowly convergent . It must be noted that divergence can occur with any other value of IER . = 6 The input is invalid , because ( EPSABS . LE .0 and EPSREL . LT . MAX ( 50 * REL . MACH . ACC ., 0.5 D - 28 )) or ( INTEGR . NE .1 AND INTEGR . NE .2 ), or LENIW . LT .2 OR MAXP1 . LT .1 or LENW . LT . LENIW * 2 + MAXP1 * 25 . RESULT , ABSERR , NEVAL , LAST are set to zero . Except when LENIW , MAXP1 or LENW are invalid , WORK ( LIMIT * 2 + 1 ), WORK ( LIMIT * 3 + 1 ), IWORK ( 1 ), IWORK ( LIMIT + 1 ) are set to zero , WORK ( 1 ) is set to A and WORK ( LIMIT + 1 ) to B . DIMENSIONING PARAMETERS LENIW - Integer Dimensioning parameter for IWORK . LENIW / 2 equals the maximum number of subintervals allowed in the partition of the given integration interval ( A , B ), LENIW . GE .2 . If LENIW . LT .2 , the routine will end with IER = 6 . MAXP1 - Integer Gives an upper bound on the number of Chebyshev moments which can be stored , i . e . for the intervals of lengths ABS ( B - A ) * 2 ** ( - L ), L = 0 , 1 , ... , MAXP1 - 2 , MAXP1 . GE .1 If MAXP1 . LT .1 , the routine will end with IER = 6 . LENW - Integer Dimensioning parameter for WORK LENW must be at least LENIW * 2 + MAXP1 * 25 . If LENW . LT .( LENIW * 2 + MAXP1 * 25 ), the routine will end with IER = 6 . LAST - Integer On return , LAST equals the number of subintervals produced in the subdivision process , which determines the number of significant elements actually in the WORK ARRAYS . WORK ARRAYS IWORK - Integer Vector of dimension at least LENIW on return , the first K elements of which contain pointers to the error estimates over the subintervals , such that WORK ( LIMIT * 3 + IWORK ( 1 )), .. WORK ( LIMIT * 3 + IWORK ( K )) form a decreasing sequence , with LIMIT = LENW / 2 , and K = LAST if LAST . LE .( LIMIT / 2 + 2 ), and K = LIMIT + 1 - LAST otherwise . Furthermore , IWORK ( LIMIT + 1 ), ... , IWORK ( LIMIT + LAST ) indicate the subdivision levels of the subintervals , such that IWORK ( LIMIT + I ) = L means that the subinterval numbered I is of length ABS ( B - A ) * 2 ** ( 1 - L ). WORK - Real Vector of dimension at least LENW On return WORK ( 1 ), ... , WORK ( LAST ) contain the left end points of the subintervals in the partition of ( A , B ), WORK ( LIMIT + 1 ), ... , WORK ( LIMIT + LAST ) contain the right end points , WORK ( LIMIT * 2 + 1 ), ... , WORK ( LIMIT * 2 + LAST ) contain the integral approximations over the subintervals , WORK ( LIMIT * 3 + 1 ), ... , WORK ( LIMIT * 3 + LAST ) contain the error estimates . WORK ( LIMIT * 4 + 1 ), ... , WORK ( LIMIT * 4 + MAXP1 * 25 ) Provide space for storing the Chebyshev moments . Note that LIMIT = LENW / 2 . REFERENCES  (NONE) ROUTINES CALLED  QAWOE, XERMSG REVISION HISTORY  (YYMMDD)\n   800101  DATE WRITTEN\n   890831  Modified array declarations.  (WRB)\n   890831  REVISION DATE from Version 3.2\n   891214  Prologue converted to Version 4.0 format.  (BAB)\n   900315  CALLs to XERROR changed to CALLs to XERMSG.  (THJ) END PROLOGUE  QAWO **FIRST EXECUTABLE STATEMENT  QAWO Arguments Type Intent Optional Attributes Name real :: F real :: A real :: B real :: OMEGA integer :: INTEGR real :: EPSABS real :: EPSREL real :: RESULT real :: ABSERR integer :: NEVAL integer :: IER integer :: LENIW integer :: MAXP1 integer :: LENW integer :: LAST integer :: IWORK real :: WORK","tags":"","url":"proc/qawo.html"},{"title":"K_screened_interaction – Yambo","text":"subroutine K_screened_interaction(X, Xw, q, io_X_err) Uses R_lattice gpu_m collision_el devxlib stderr D_lattice pars com frequency X_m IO_m drivers BS ALLOC IO_int Arguments Type Intent Optional Attributes Name type( X_t ) :: X type( w_samp ) :: Xw type( bz_samp ) :: q integer, intent(out) :: io_X_err","tags":"","url":"proc/k_screened_interaction.html"},{"title":"SLK_matrix_init – Yambo","text":"subroutine SLK_matrix_init(M_slk, N, N_blocks) Uses matrix SLK_m Arguments Type Intent Optional Attributes Name type( PAR_matrix ) :: M_slk integer :: N integer :: N_blocks","tags":"","url":"proc/slk_matrix_init.html"},{"title":"cutoff_ws – Yambo","text":"subroutine cutoff_ws(q) Uses parallel_m R_lattice parallel_int wave_func D_lattice pars openmp LIVE_t cutoff_ws_m Arguments Type Intent Optional Attributes Name type( bz_samp ) :: q","tags":"","url":"proc/cutoff_ws.html"},{"title":"cutoff_cylinder – Yambo","text":"subroutine cutoff_cylinder(q, is_cut) Uses parallel_m R_lattice wave_func D_lattice pars com LIVE_t parallel_int Arguments Type Intent Optional Attributes Name type( bz_samp ) :: q logical :: is_cut (3)","tags":"","url":"proc/cutoff_cylinder.html"},{"title":"K_solvers – Yambo","text":"subroutine K_solvers(iq, Ken, Xk, q, X_static, W_bss) Uses parallel_m R_lattice DICHROISM stderr linear_algebra X_m frequency PHOTOLUM BS_solvers BS electrons MAGNONS IO_int Arguments Type Intent Optional Attributes Name integer :: iq type( levels ) :: Ken type( bz_samp ) :: Xk type( bz_samp ) :: q type( X_t ) :: X_static type( w_samp ) :: W_bss","tags":"","url":"proc/k_solvers.html"},{"title":"PARALLEL_minimal_index_from_overlaping – Yambo","text":"subroutine PARALLEL_minimal_index_from_overlaping(IND_in, IND_out, PAR_COMM) Uses parallel_m parallel_int vec_operate Arguments Type Intent Optional Attributes Name type( PP_indexes ) :: IND_in type( PP_indexes ) :: IND_out type( yMPI_comm ) :: PAR_COMM","tags":"","url":"proc/parallel_minimal_index_from_overlaping.html"},{"title":"io_DIPOLES – Yambo","text":"function io_DIPOLES(Dip, ID) Uses parallel_m R_lattice stderr pars DIPOLES IO_m timing_m electrons IO_int Arguments Type Intent Optional Attributes Name type( DIPOLE_t ) :: Dip integer :: ID Return Value integer","tags":"","url":"proc/io_dipoles.html"},{"title":"RT_INV_step_accurate – Yambo","text":"subroutine RT_INV_step_accurate(dG_old, dG_inp, dG_out, ik, deltaT) Uses wrapper_omp pars real_time iso_c_binding U_k=Ho_plus_Sigma(:,:,ik,1)\ncall SERIAL_HERMITIAN_diagonalization(RT_nbands,U_k,En) Generate the matrix Rotate dG_out in the new basis set Rotate G_com back the old basis set Arguments Type Intent Optional Attributes Name complex(kind=SP), intent(in) :: dG_old (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) complex(kind=SP), intent(in) :: dG_inp (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) complex(kind=SP), intent(out), target :: dG_out (RT_bands(1):RT_bands(2),RT_bands(1):RT_bands(2)) integer, intent(in) :: ik real(kind=SP), intent(in) :: deltaT","tags":"","url":"proc/rt_inv_step_accurate.html"},{"title":"eval_minus_G – Yambo","text":"subroutine eval_minus_G() Uses R_lattice D_lattice Arguments None","tags":"","url":"proc/eval_minus_g.html"},{"title":"exciton_WFs – Yambo","text":"subroutine exciton_WFs(