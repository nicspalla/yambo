:"proc/xc_eval_gga_kernel.html"},{"title":"LEVELS_respect_degenerations – Yambo","text":"subroutine LEVELS_respect_degenerations(E, Dip, X) Uses stderr DIPOLES X_m QP_m parser_m vec_operate BS electrons Arguments Type Intent Optional Attributes Name type( levels ) :: E type( DIPOLE_t ) :: Dip type( X_t ) :: X (5)","tags":"","url":"proc/levels_respect_degenerations.html"},{"title":"MEM_free – Yambo","text":"subroutine MEM_free(what, Sz) Uses y_memory pars UNITS openmp Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: what integer(kind=IPL), intent(in) :: Sz","tags":"","url":"proc/mem_free.html"},{"title":"ELPH_Hamiltonian – Yambo","text":"subroutine ELPH_Hamiltonian(en, k, q) Uses R_lattice ELPH ALLOC D_lattice linear_algebra stderr pars com parser_m QP_m IO_m UNITS LIVE_t electrons interfaces IO_int Arguments Type Intent Optional Attributes Name type( levels ) :: en type( bz_samp ) :: k type( bz_samp ) :: q","tags":"","url":"proc/elph_hamiltonian.html"},{"title":"IO_temporary_jobdir_and_strings – Yambo","text":"subroutine IO_temporary_jobdir_and_strings(what, value) Uses pars com Arguments Type Intent Optional Attributes Name character(len=*) :: what character(len=*) :: value","tags":"","url":"proc/io_temporary_jobdir_and_strings.html"},{"title":"io_DIPOLES – Yambo","text":"function io_DIPOLES(Dip, ID) Uses parallel_m R_lattice stderr pars DIPOLES IO_m timing_m BS electrons IO_int Arguments Type Intent Optional Attributes Name type( DIPOLE_t ) :: Dip integer :: ID Return Value integer","tags":"","url":"proc/io_dipoles~2.html"},{"title":"OSCLL_compose_collision – Yambo","text":"subroutine OSCLL_compose_collision(k, q, i_n, i_m, i_k, COLL) Uses parallel_m R_lattice pars nl_optics collision_ext QP_m wrapper Arguments Type Intent Optional Attributes Name type( bz_samp ), intent(in) :: k type( bz_samp ), intent(in) :: q integer, intent(in) :: i_n integer, intent(in) :: i_m integer, intent(in) :: i_k complex(kind=SP), intent(out) :: COLL (NL_b